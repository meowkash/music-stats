---
import Layout from "../layouts/Layout.astro";
import Dashboard from "../components/Dashboard.astro";
import RecapStory from "../components/RecapStory.astro";

import Leaderboards from "../components/Leaderboards.astro";
import Recents from "../components/Recents.astro";
import Statistics from "../components/Statistics.astro";
import BottomNav from "../components/BottomNav.astro";
import DetailOverlay from "../components/DetailOverlay.astro";
import StatsTopSheet from "../components/StatsTopSheet.astro";
import { TAB_ORDER } from "../utils/tabs";
import { TAB_THEME_COLORS } from "../utils/tabTheme";
---

<Layout title="My Music Stats">
  <div id="app-shell">
    <main class="view-deck">
      <section class="panel-section active" id="view-dashboard">
        <Dashboard />
      </section>

      <section class="panel-section inactive-right" id="view-rankings">
        <Leaderboards />
      </section>

      <section class="panel-section inactive-right" id="view-recents">
        <Recents />
      </section>

      <section class="panel-section inactive-right" id="view-statistics">
        <Statistics />
      </section>
    </main>

    <BottomNav />
  </div>

  {/* Runs before hydration so a restored tab paints in its own colours rather
      than flashing the dashboard's. Mirrors setActiveTab() in utils/tabs.ts. */}
  <script is:inline define:vars={{ tabOrder: TAB_ORDER, themeColors: TAB_THEME_COLORS }}>
    try {
      const lastTab = localStorage.getItem('last-music-stats-tab');
      const targetIndex = lastTab ? tabOrder.indexOf(lastTab) : -1;
      if (targetIndex > 0) {
        document.querySelectorAll('.panel-section').forEach((sec) => {
          const secIndex = tabOrder.indexOf(sec.id.replace('view-', ''));
          sec.classList.remove('active', 'inactive-left', 'inactive-right');
          sec.classList.add(
            secIndex < targetIndex ? 'inactive-left' : secIndex > targetIndex ? 'inactive-right' : 'active',
          );
        });
        document.querySelectorAll('.tab-btn').forEach((btn) => {
          btn.classList.toggle('active', btn.dataset.tab === lastTab);
        });
        document.body.dataset.activeTab = lastTab;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta && themeColors[lastTab]) meta.content = themeColors[lastTab];
      }
    } catch (e) {
      console.warn('Could not restore tab from storage', e);
    }
  </script>

  <StatsTopSheet />
  <DetailOverlay />
  <RecapStory />
</Layout>

<style>
  #app-shell {
    height: 100lvh;
    width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: absolute;
    z-index: 1;
    transition: padding var(--duration-slow) var(--ios-spring);
  }

  @media (min-width: 768px) {
    #app-shell {
      padding-left: calc(220px + env(safe-area-inset-left));
    }
  }

  .view-deck {
    flex: 1;
    overflow: hidden;
    position: relative;
    height: 100%;
    width: 100%;
  }

  /* Off-screen slide for inactive panels (native-style tab transition) */
  .panel-section {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    visibility: hidden;
    pointer-events: none;
    width: 100%;
    transition: transform var(--duration-normal) var(--ios-spring);
    backface-visibility: hidden;
  }

  .view-deck.tab-dragging .panel-section {
    transition: none !important;
    will-change: transform;
  }

  .panel-section > :global(*) {
    flex: 1;
    min-height: 0;
  }

  .panel-section.inactive-left {
    transform: translate3d(-100%, 0, 0);
  }

  .panel-section.inactive-right {
    transform: translate3d(100%, 0, 0);
  }

  /* Panel padding — content scrolls into glass nav zone */
  @media (max-width: 767px) {
    .panel-section {
      padding: calc(16px + env(safe-area-inset-top)) calc(10px + env(safe-area-inset-right))
        var(--nav-zone-height) calc(10px + env(safe-area-inset-left));
      scroll-padding-bottom: var(--nav-zone-height);
    }
  }
  /* Desktop sidebar nav — no bottom nav zone; use full viewport height */
  @media (min-width: 768px) {
    .panel-section.inactive-left {
      transform: translate3d(0, -100%, 0);
    }

    .panel-section.inactive-right {
      transform: translate3d(0, 100%, 0);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .panel-section {
      padding: calc(24px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right))
        calc(24px + env(safe-area-inset-bottom)) 20px;
    }
  }
  @media (min-width: 1024px) {
    .panel-section {
      padding: calc(32px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right))
        calc(32px + env(safe-area-inset-bottom)) 20px;
    }
  }

  .panel-section.active {
    visibility: visible;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }
</style>

<script>
  import { loadColorsCache, preloadAppData } from "../utils/ui";
  import {
    hydrateFromStore,
    ensureInitialGeneration,
    stageUpdate,
    backfillStoredFiles,
    getActiveManifest,
  } from "../utils/dataStore";
  import { prefetchArtwork } from "../utils/artworkPrefetch";
  import { hideSplashScreen } from "../utils/dataRefresh";

  document.addEventListener("DOMContentLoaded", () => {
    hideSplashScreen();

    void (async () => {
      try {
        // Phase 1 — render from whatever is already on disk. No network on
        // this path, so a cold offline launch paints the same as a warm one.
        const hydrated = await hydrateFromStore();
        if (!hydrated) await ensureInitialGeneration();
        await Promise.all([loadColorsCache(), preloadAppData()]);
      } catch (err) {
        console.warn("Data hydration failed:", err);
      }

      // Phase 2 — reconcile with the server, fill in any files the store is
      // missing, then warm artwork. Deliberately not awaited by first paint.
      try {
        await stageUpdate();
        await backfillStoredFiles();
        const manifest = getActiveManifest();
        if (manifest) void prefetchArtwork(manifest);
      } catch (err) {
        console.warn("Background data update failed:", err);
      }
    })();
  });
</script>
