---
import Layout from "../layouts/Layout.astro";
import Dashboard from "../components/Dashboard.astro";
import Leaderboards from "../components/Leaderboards.astro";
import Recents from "../components/Recents.astro";
import Statistics from "../components/Statistics.astro";
import BottomNav from "../components/BottomNav.astro";
import DetailOverlay from "../components/DetailOverlay.astro";
import { TAB_ORDER } from "../utils/tabs";
---

<Layout title="My Music Stats">
  <div id="app-shell">
    <main class="view-deck">
      <section class="panel-section active" id="view-dashboard">
        <Dashboard />
      </section>

      <section class="panel-section inactive-right" id="view-rankings">
        <Leaderboards />
      </section>

      <section class="panel-section inactive-right" id="view-recents">
        <Recents />
      </section>

      <section class="panel-section inactive-right" id="view-statistics">
        <Statistics />
      </section>
    </main>

    <BottomNav />
  </div>

  <script is:inline define:vars={{ tabOrder: TAB_ORDER }}>
    try {
      const lastTab = localStorage.getItem('last-music-stats-tab');
      if (lastTab && lastTab !== 'dashboard') {
        const targetIndex = tabOrder.indexOf(lastTab);
        if (targetIndex !== -1) {
          document.querySelectorAll('.panel-section').forEach(sec => {
            const secId = sec.getAttribute('id').replace('view-', '');
            const secIndex = tabOrder.indexOf(secId);
            sec.classList.remove('active', 'inactive-left', 'inactive-right');
            if (secIndex < targetIndex) {
              sec.classList.add('inactive-left');
            } else if (secIndex > targetIndex) {
              sec.classList.add('inactive-right');
            } else {
              sec.classList.add('active');
            }
          });
          document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('active');
            if (btn.getAttribute('data-tab') === lastTab) {
              btn.classList.add('active');
            }
          });
        }
      }
    } catch (e) {
      console.warn('Could not restore tab from storage', e);
    }
  </script>

  <DetailOverlay />
</Layout>

<style>
  #app-shell {
    height: 100lvh;
    width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: absolute;
    transition: padding 0.5s var(--ios-spring);
  }

  @media (min-width: 768px) {
    #app-shell {
      padding-left: calc(220px + env(safe-area-inset-left));
    }
  }

  .view-deck {
    flex: 1;
    overflow: hidden;
    position: relative;
    height: 100%;
    width: 100%;
  }

  /* Off-screen slide for inactive panels (native-style tab transition) */
  .panel-section {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    visibility: hidden;
    pointer-events: none;
    width: 100%;
    transition:
      padding 0.5s var(--ios-spring),
      transform var(--duration-slow) var(--ios-spring),
      visibility 0s linear var(--duration-slow);
    will-change: transform;
  }

  .panel-section.inactive-left {
    transform: translate3d(-100%, 0, 0);
  }

  .panel-section.inactive-right {
    transform: translate3d(100%, 0, 0);
  }

  /* Panel padding — content scrolls into glass nav zone */
  @media (max-width: 767px) {
    .panel-section {
      padding: calc(16px + env(safe-area-inset-top)) calc(10px + env(safe-area-inset-right))
        var(--nav-zone-height) calc(10px + env(safe-area-inset-left));
      scroll-padding-bottom: var(--nav-zone-height);
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .panel-section {
      padding: calc(24px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right)) calc(env(safe-area-inset-bottom) + 100px) 20px;
    }
  }
  @media (min-width: 1024px) {
    .panel-section {
      padding: calc(32px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right)) calc(env(safe-area-inset-bottom) + 110px) 20px;
    }
  }

  .panel-section.active {
    visibility: visible;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
    transition:
      padding 0.5s var(--ios-spring),
      transform var(--duration-slow) var(--ios-spring),
      visibility 0s linear 0s;
  }
</style>

<script>
  import {
    loadColorsCache,
    preloadAppData,
    startBackgroundArtworkPreload,
  } from "../utils/ui";
  import { setActiveTab } from "../utils/tabs";
  import {
    warmDataCache,
    ensureCacheVersion,
    revalidateCriticalData,
    CRITICAL_DATA_PATHS,
  } from "../utils/dataStore";
  import { hideSplashScreen } from "../utils/dataRefresh";

  document.addEventListener("DOMContentLoaded", () => {
    hideSplashScreen();

    void (async () => {
      try {
        await ensureCacheVersion();
        await warmDataCache([...CRITICAL_DATA_PATHS]);
        void revalidateCriticalData();
        await Promise.all([loadColorsCache(), preloadAppData()]);
        startBackgroundArtworkPreload();
      } catch (err) {
        console.warn("Background data hydration failed:", err);
      }
    })();

    window.addEventListener("tab-change", (e: Event) => {
      const tab = (e as CustomEvent<{ tab: string }>).detail.tab;
      setActiveTab(tab);
    });
  });
</script>
