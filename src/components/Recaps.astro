---
---

<div class="recaps-stories shrink-0" id="recapsCard">
  <div class="recap-rail" id="recapYearRail"></div>
</div>

<style>
  .recaps-stories {
    min-height: 0;
  }

  /* Bleeds into the dashboard's side gutter (Dashboard.astro) so the rail
     scrolls edge to edge; the rail's own padding puts the first ring back in
     line with the cards below. */
  .recaps-stories {
    margin-inline: -10px;
    width: auto;
  }
</style>

<style is:global>
  .recap-rail {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    /* The rail is a scroll container, so it clips at its padding box. This
       padding has to hold the ring halo (3px + its blur), or the glow is cut
       into a rectangle. Kept tight so the rings sit high on the page. */
    padding: 7px 10px 4px;
    scroll-padding-inline: 10px;
  }

  .recap-rail::-webkit-scrollbar {
    display: none;
  }

  .recap-story {
    flex: 0 0 auto;
    width: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    color: inherit;
    scroll-snap-align: start;
    -webkit-tap-highlight-color: transparent;
  }

  .recap-story-ring {
    position: relative;
    /* Contains the halo's negative z-index so it stays behind the avatar
       without dropping under anything outside the ring. */
    isolation: isolate;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    padding: 2px;
    background:
      conic-gradient(
        from 210deg,
        hsl(var(--year-hue) 90% 62%),
        hsl(calc(var(--year-hue) + 40) 92% 58%),
        hsl(var(--year-hue) 80% 48%),
        hsl(var(--year-hue) 90% 62%)
      );
    box-shadow: 0 2px 12px var(--year-glow);
    transition: transform var(--duration-fast) var(--ios-spring);
  }

  /* A slow light orbiting the ring: a soft halo outside it plus a thin glint
     travelling along the ring itself. Both are low-opacity and slow on purpose
     — enough to catch the eye on the home screen, never enough to pull it. */
  .recap-story-ring::before,
  .recap-story-ring::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    animation: recap-ring-orbit 9s linear infinite;
    /* Each ring starts at a different point so the row never pulses in step. */
    animation-delay: calc(var(--ring-index, 0) * -2.3s);
  }

  .recap-story-ring::before {
    inset: -3px;
    z-index: -1;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 200deg,
      hsl(calc(var(--year-hue) + 20) 100% 74% / 0.9) 300deg,
      transparent 360deg
    );
    filter: blur(4px);
    opacity: 0.5;
  }

  .recap-story-ring::after {
    inset: 0;
    z-index: 2;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 280deg,
      rgba(255, 255, 255, 0.7) 335deg,
      transparent 360deg
    );
    /* Only the outer 2px band — the ring — catches the glint. */
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    opacity: 0.55;
  }

  @keyframes recap-ring-orbit {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recap-story-ring::before,
    .recap-story-ring::after {
      animation: none;
    }

    .recap-story-ring::after {
      display: none;
    }
  }

  .recap-story-avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid #07070c;
    overflow: hidden;
    background:
      radial-gradient(circle at 35% 30%, hsl(var(--year-hue) 80% 48% / 0.95), var(--year-deep) 72%);
    color: hsl(var(--year-hue) 90% 88%);
  }

  .recap-story-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(1.14) saturate(1.1) contrast(1.06);
  }

  .recap-story-avatar::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    pointer-events: none;
  }

  .recap-story-avatar svg {
    width: 22px;
    height: 22px;
    opacity: 0.92;
  }

  .recap-story-avatar:has(.recap-story-photo) svg {
    display: none;
  }

  .recap-story-year {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--text-secondary);
  }

  .recap-story:active .recap-story-ring {
    transform: scale(0.94);
  }

  .recap-rail .no-data-message {
    margin: 0;
    flex: 1;
    padding: 12px 8px;
  }
</style>

<script>
  import { onReady } from "../utils/dom";
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import { recapThemeVars } from "../utils/recapTheme";
  import { RECAP_OPEN_EVENT, type RecapIndexEntry } from "../utils/recapStories";
  import { escapeHTML, getArtistArtworkUrl, getArtworkFallbackIcon, loadArtworkCache } from "../utils/ui";
  import { getThumbArtworkSources } from "../utils/artwork";

  onReady(() => {
    const rail = document.getElementById("recapYearRail") as HTMLDivElement;

    function photoHTML(artist: string): string {
      const url = getArtistArtworkUrl(artist);
      if (!url) return "";
      const src = getThumbArtworkSources(url)[0] || url;
      return `<img class="recap-story-photo" src="${escapeHTML(src)}" alt="" decoding="async" draggable="false" referrerpolicy="no-referrer" crossorigin="anonymous">`;
    }

    function cardHTML(entry: RecapIndexEntry, index: number): string {
      return `<button class="recap-story" data-year="${entry.year}" type="button" style="${recapThemeVars(entry.year)};--ring-index:${index}" aria-label="${entry.year} recap">
        <span class="recap-story-ring" aria-hidden="true">
          <span class="recap-story-avatar">${photoHTML(entry.topArtist)}${getArtworkFallbackIcon("artist")}</span>
        </span>
        <span class="recap-story-year">${entry.year}</span>
      </button>`;
    }

    function renderRail(entries: RecapIndexEntry[]) {
      if (!entries.length) {
        rail.innerHTML =
          '<div class="no-data-message">No recaps yet — check back after a few more months of listening.</div>';
        return;
      }
      rail.innerHTML = entries.map((entry, i) => cardHTML(entry, i)).join("");
    }

    rail.addEventListener("click", (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>(".recap-story");
      if (!card?.dataset.year) return;
      window.dispatchEvent(
        new CustomEvent(RECAP_OPEN_EVENT, { detail: { year: Number(card.dataset.year) } }),
      );
    });

    rail.addEventListener(
      "error",
      (event) => {
        const img = event.target;
        if (!(img instanceof HTMLImageElement) || !img.classList.contains("recap-story-photo")) return;
        img.remove();
      },
      true,
    );

    async function load() {
      try {
        await loadArtworkCache();
        const { years } = await fetchAppJson<{ years: RecapIndexEntry[] }>("/data/recaps.json");
        renderRail(years ?? []);
      } catch (err) {
        console.error("Failed to load recaps:", err);
        rail.innerHTML = '<div class="no-data-message">Failed to load recaps</div>';
      }
    }

    load();
    onPathsUpdated(["/data/recaps.json", "/data/artwork.json"], () => load());
  });
</script>
