---
---

<div class="recaps-container glass-card panel-container panel-fill">
  <div class="recap-ambient" id="recapAmbient" aria-hidden="true"></div>

  <div class="recap-inner panel-fill">
    <div class="view-header shrink-0">
      <h2>Recaps</h2>
      <p class="subtitle">Your year in music, story by story</p>
    </div>

    <div class="recap-year-row shrink-0">
      <div id="recapYearHighlight" class="range-highlight sliding-highlight"></div>
      <div class="recap-year-ranges" id="recapYearPicker" data-scroll-x>
        <div class="year-picker-loading">Loading years…</div>
      </div>
    </div>

    <div class="story-progress shrink-0" id="recapProgressBar" aria-hidden="true"></div>

    <div class="recap-stage panel-fill">
      <button class="recap-side-nav recap-side-prev" id="recapSidePrev" type="button" aria-label="Previous story">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <div class="recap-deck-shell">
        <div class="recap-deck-viewport" id="recapDeckViewport">
          <div class="recap-deck-track" id="recapDeckTrack">
            <div class="recap-loading-card">
              <div class="recap-loading-shimmer"></div>
              <p>Building your recap…</p>
            </div>
          </div>
        </div>
      </div>

      <button class="recap-side-nav recap-side-next" id="recapSideNext" type="button" aria-label="Next story">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</div>

<style>
  .recaps-container {
    position: relative;
    overflow: hidden;
    min-height: 0;
    background: rgba(0, 0, 0, 0.2);
    border-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .recap-ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    transition: opacity 0.45s var(--ios-spring);
  }

  .recap-ambient :global(.recap-ambient-art) {
    position: absolute;
    inset: -25%;
    background-size: cover;
    background-position: center;
    filter: blur(56px) saturate(1.6) brightness(0.65);
    transform: scale(1.12);
    opacity: 0.9;
  }

  .recap-ambient :global(.recap-ambient-art-secondary) {
    position: absolute;
    inset: -40%;
    background-size: cover;
    background-position: center;
    filter: blur(90px) saturate(2) brightness(0.4) hue-rotate(15deg);
    transform: scale(1.2) rotate(8deg);
    opacity: 0.55;
    mix-blend-mode: screen;
    animation: recapArtDrift 18s ease-in-out infinite;
  }

  @keyframes recapArtDrift {
    0%, 100% { transform: scale(1.2) rotate(8deg) translate(0, 0); }
    50% { transform: scale(1.28) rotate(12deg) translate(2%, -2%); }
  }

  .recap-ambient :global(.recap-ambient-rays) {
    position: absolute;
    inset: -50%;
    background: conic-gradient(
      from 220deg at 50% 50%,
      transparent 0deg,
      color-mix(in srgb, var(--c1) 12%, transparent) 40deg,
      transparent 80deg,
      color-mix(in srgb, var(--c2) 10%, transparent) 140deg,
      transparent 200deg,
      color-mix(in srgb, var(--c1) 8%, transparent) 280deg,
      transparent 360deg
    );
    animation: recapRaysSpin 40s linear infinite;
    opacity: 0.7;
    pointer-events: none;
  }

  @keyframes recapRaysSpin {
    to { transform: rotate(360deg); }
  }

  .recap-ambient :global(.recap-ambient-orbs) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .recap-ambient :global(.recap-ambient-orb) {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--orb-color) 50%, transparent) 0%, transparent 70%);
    filter: blur(24px);
    animation: recapOrbFloat 14s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes recapOrbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; }
    33% { transform: translate(18px, -12px) scale(1.06); opacity: 0.9; }
    66% { transform: translate(-12px, 8px) scale(0.96); opacity: 0.65; }
  }

  .recap-ambient :global(.recap-ambient-ring) {
    position: absolute;
    width: 320px;
    height: 320px;
    border: 1px solid color-mix(in srgb, var(--shape-color) 25%, transparent);
    border-radius: 50%;
    top: -100px;
    right: -80px;
    animation: recapRingSpin 30s linear infinite;
    pointer-events: none;
  }

  @keyframes recapRingSpin {
    to { transform: rotate(360deg); }
  }

  .recap-ambient :global(.recap-ambient-ring-lg) {
    width: 420px;
    height: 420px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-width: 2px;
    opacity: 0.5;
    animation: recapRingSpinCentered 30s linear infinite;
  }

  @keyframes recapRingSpinCentered {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .recap-ambient :global(.recap-ambient-streak) {
    position: absolute;
    width: 3px;
    height: 160px;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--shape-color) 45%, transparent), transparent);
    bottom: 10%;
    left: 15%;
    transform: rotate(-20deg);
    animation: recapStreakPulse 6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes recapStreakPulse {
    0%, 100% { opacity: 0.4; transform: rotate(-20deg) scaleY(1); }
    50% { opacity: 0.8; transform: rotate(-20deg) scaleY(1.15); }
  }

  .recap-ambient :global(.recap-ambient-noise) {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.03) 2px,
      rgba(255, 255, 255, 0.03) 4px
    );
    pointer-events: none;
  }

  .recap-ambient :global(.recap-ambient-mesh) {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 70% at 10% 90%, color-mix(in srgb, var(--c1) 75%, transparent) 0%, transparent 55%),
      radial-gradient(ellipse 80% 60% at 90% 10%, color-mix(in srgb, var(--c2) 70%, transparent) 0%, transparent 50%),
      radial-gradient(ellipse 100% 80% at 50% 100%, color-mix(in srgb, var(--c3) 55%, transparent) 0%, transparent 65%),
      linear-gradient(165deg, #050508 0%, color-mix(in srgb, var(--c1) 25%, #0a0a12) 100%);
  }

  .recap-ambient :global(.recap-ambient-grain) {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .recap-ambient :global(.recap-ambient-vignette) {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 20%, rgba(0, 0, 0, 0.5) 100%);
    pointer-events: none;
  }

  .recap-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 0;
  }

  /* Year selector — matches Leaderboards range pills */
  .recap-year-row {
    flex-shrink: 0;
    position: relative;
    z-index: 5;
  }

  .recap-year-ranges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .recap-year-ranges::-webkit-scrollbar {
    display: none;
  }

  .recap-year-ranges :global(.range-btn) {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-smooth);
    font-family: var(--font-body);
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .recap-year-ranges :global(.range-btn:hover) {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      border-color: rgba(255, 255, 255, 0.15);
    }
  }

  .recap-year-ranges :global(.range-btn.active) {
    color: #fff;
    border-color: transparent;
    background: transparent;
  }

  .range-highlight {
    border-radius: 20px;
    background: var(--range-color, var(--accent-yellow));
    box-shadow: 0 4px 12px var(--range-glow, var(--accent-yellow-glow));
  }

  .year-picker-loading {
    font-size: 14px;
    color: var(--text-muted);
    position: relative;
    z-index: 2;
  }

  /* Story progress — below year picker */
  .story-progress {
    display: flex;
    gap: 3px;
    height: 3px;
  }

  .story-progress :global(.story-segment) {
    flex: 1;
    height: 100%;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.2);
    overflow: hidden;
  }

  .story-progress :global(.story-segment-fill) {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--story-accent, #fff);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--story-accent-glow, rgba(255, 255, 255, 0.35));
    transition: none;
  }

  .story-progress :global(.story-segment.done .story-segment-fill) {
    width: 100%;
  }

  /* Stage: side nav flanking the story deck on desktop */
  .recap-stage {
    display: flex;
    align-items: stretch;
    gap: 12px;
    min-height: 0;
  }

  .recap-deck-shell {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .recap-deck-viewport {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    position: relative;
    background: transparent;
    touch-action: pan-y pinch-zoom;
  }

  .recap-deck-track {
    display: flex;
    height: 100%;
    backface-visibility: hidden;
  }

  .recap-deck-track.pager-moving {
    will-change: transform;
  }

  /* ── Story cards ─────────────────────────────────────────────── */
  .recap-deck-track :global(.recap-card) {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 16px 28px;
    text-align: center;
    background: transparent;
  }

  .recap-deck-track :global(.recap-card-content) {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 380px;
    width: 100%;
    padding: 20px 24px;
    border-radius: var(--radius-lg);
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
  }

  .recap-deck-track :global(.recap-card.active .recap-card-content) {
    animation: recapContentIn 0.65s var(--ios-spring) both;
  }

  @keyframes recapContentIn {
    from { opacity: 0; transform: translateY(20px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .recap-deck-track :global(.recap-eyebrow) {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .recap-deck-track :global(.recap-title) {
    font-family: var(--font-header);
    font-size: clamp(32px, 8vw, 48px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 4px 32px rgba(0, 0, 0, 0.45);
  }

  .recap-deck-track :global(.recap-title-sm) {
    font-size: clamp(24px, 6vw, 32px);
  }

  .recap-deck-track :global(.recap-stat-value) {
    font-family: var(--font-header);
    font-size: clamp(56px, 16vw, 88px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
    text-shadow: 0 0 48px var(--story-accent-glow, rgba(255, 255, 255, 0.25));
  }

  .recap-deck-track :global(.recap-stat-label) {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
  }

  .recap-deck-track :global(.recap-subtext) {
    font-family: var(--font-body);
    font-size: 15px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }

  .recap-deck-track :global(.recap-artwork) {
    width: min(220px, 58vw);
    height: min(220px, 58vw);
    border-radius: var(--radius-lg);
    object-fit: cover;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.12);
    animation: recapArtworkIn 0.85s var(--ios-spring) 0.1s both;
  }

  @keyframes recapArtworkIn {
    from { opacity: 0; transform: scale(0.88) rotate(-2deg); }
    to { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  /* Lists */
  .recap-deck-track :global(.recap-list) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
  }

  .recap-deck-track :global(.recap-list-item) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: rgba(0, 0, 0, 0.35);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    animation: recapListIn 0.45s var(--ios-spring) both;
  }

  .recap-deck-track :global(.recap-list-item:nth-child(2)) { animation-delay: 0.07s; }
  .recap-deck-track :global(.recap-list-item:nth-child(3)) { animation-delay: 0.14s; }
  .recap-deck-track :global(.recap-list-item:nth-child(4)) { animation-delay: 0.21s; }
  .recap-deck-track :global(.recap-list-item:nth-child(5)) { animation-delay: 0.28s; }

  @keyframes recapListIn {
    from { opacity: 0; transform: translateX(-12px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .recap-deck-track :global(.recap-list-rank) {
    font-family: var(--font-header);
    font-size: 22px;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.45);
    min-width: 26px;
  }

  .recap-deck-track :global(.recap-list-thumb) {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.08);
  }

  .recap-deck-track :global(.recap-list-name) {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .recap-deck-track :global(.recap-list-sub) {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .recap-deck-track :global(.recap-list-count) {
    font-family: var(--font-header);
    font-size: 17px;
    font-weight: 800;
    color: #fff;
    flex-shrink: 0;
  }

  /* Genre bars */
  .recap-deck-track :global(.recap-genre-list) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .recap-deck-track :global(.recap-genre-row) {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 4px 10px;
    align-items: center;
    animation: recapListIn 0.45s var(--ios-spring) both;
  }

  .recap-deck-track :global(.recap-genre-name) {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    text-transform: capitalize;
    text-align: left;
  }

  .recap-deck-track :global(.recap-genre-pct) {
    font-family: var(--font-header);
    font-size: 16px;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.85);
  }

  .recap-deck-track :global(.recap-genre-bar-track) {
    grid-column: 1 / -1;
    height: 6px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
  }

  .recap-deck-track :global(.recap-genre-bar-fill) {
    height: 100%;
    background: linear-gradient(90deg, var(--story-accent, var(--accent-yellow)), color-mix(in srgb, var(--story-accent, var(--accent-pink)) 60%, #fff));
    border-radius: 3px;
    animation: recapBarGrow 0.9s var(--ios-spring) both;
  }

  /* Month chart */
  .recap-deck-track :global(.recap-month-chart) {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;
    width: 100%;
    height: 130px;
  }

  .recap-deck-track :global(.recap-month-bar) {
    flex: 1;
    max-width: 24px;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 4px 4px 0 0;
    min-height: 4px;
    animation: recapBarGrow 0.8s var(--ios-spring) both;
  }

  .recap-deck-track :global(.recap-month-bar.highlight) {
    background: #fff;
    box-shadow: 0 0 14px rgba(255, 255, 255, 0.35);
  }

  @keyframes recapBarGrow {
    from { transform: scaleY(0); transform-origin: bottom; }
    to { transform: scaleY(1); transform-origin: bottom; }
  }

  /* Mini stats grid */
  .recap-deck-track :global(.recap-stat-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
  }

  .recap-deck-track :global(.recap-mini-stat) {
    padding: 18px 10px;
    background: rgba(0, 0, 0, 0.35);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.1);
    animation: recapListIn 0.45s var(--ios-spring) both;
  }

  .recap-deck-track :global(.recap-mini-value) {
    font-family: var(--font-header);
    font-size: 32px;
    font-weight: 800;
    color: #fff;
    display: block;
  }

  .recap-deck-track :global(.recap-mini-label) {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 4px;
    display: block;
  }

  .recap-loading-card {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: var(--text-muted);
    font-size: 15px;
    font-family: var(--font-body);
  }

  .recap-loading-shimmer {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--accent-yellow);
    animation: recapSpin 0.8s linear infinite;
  }

  @keyframes recapSpin {
    to { transform: rotate(360deg); }
  }

  /* Desktop side navigation */
  .recap-side-nav {
    display: none;
    flex-shrink: 0;
    align-self: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
    align-items: center;
    justify-content: center;
  }

  .recap-side-nav svg {
    width: 24px;
    height: 24px;
  }

  .recap-side-nav:disabled {
    opacity: 0.25;
    cursor: default;
  }

  @media (min-width: 768px) {
    .recap-side-nav {
      display: flex;
    }

    .recap-side-nav:not(:disabled):hover {
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
      border-color: rgba(255, 255, 255, 0.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recap-deck-track :global(.recap-card.active .recap-card-content),
    .recap-deck-track :global(.recap-artwork),
    .recap-deck-track :global(.recap-list-item),
    .recap-deck-track :global(.recap-month-bar),
    .recap-deck-track :global(.recap-mini-stat),
    .recap-deck-track :global(.recap-shape),
    .recap-deck-track :global(.recap-genre-bar-fill) {
      animation: none !important;
    }
  }

  @media (max-width: 767px) {
    .recap-deck-track :global(.recap-card) {
      padding: 44px 20px 28px;
    }
  }
</style>

<script>
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import type { YearlyTotals } from "../types/music";
  import { loadYearData } from "../utils/scrobbles";
  import { bindPagerSwipe } from "../utils/pagerSwipe";
  import { computeRecapStats, type RecapMetaData } from "../utils/recapStats";
  import { buildRecapCards, buildStoryProgress, buildAmbientMarkup, buildYearColorMap } from "../utils/recapCards";
  import { createStoryPlayer, type StoryPlayer } from "../utils/storyPlayer";
  import { createSlidingHighlight } from "../utils/slidingHighlight";
  import {
    getArtworkUrl,
    getArtistArtworkUrl,
    getColorForUrl,
    loadArtworkCache,
    loadMetaCache,
  } from "../utils/ui";
  import { easeOutCubic, rafTween } from "../utils/motion";

  let selectedYear = "";
  let pager: ReturnType<typeof bindPagerSwipe> | null = null;
  let storyPlayer: StoryPlayer | null = null;
  let cardCount = 0;
  let counterCancels: Array<() => void> = [];
  let tabActive = false;
  let holding = false;
  let yearHighlightCtrl: ReturnType<typeof createSlidingHighlight> | null = null;
  let yearColorMap: Record<string, string> = {};
  let activeYearColor = "#eab308";

  function hexToRgba(hex: string, alpha: number): string {
    const { r, g, b } = (() => {
      const h = hex.replace("#", "");
      return {
        r: parseInt(h.slice(0, 2), 16),
        g: parseInt(h.slice(2, 4), 16),
        b: parseInt(h.slice(4, 6), 16),
      };
    })();
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  function applyYearAccent(color: string) {
    activeYearColor = color;
    const container = document.querySelector(".recaps-container") as HTMLElement | null;
    container?.style.setProperty("--story-accent", color);
    container?.style.setProperty("--story-accent-glow", hexToRgba(color, 0.45));
  }

  function syncAmbientBg(index: number) {
    const card = document.querySelectorAll(".recap-card")[index] as HTMLElement | undefined;
    const ambient = document.getElementById("recapAmbient");
    if (!card || !ambient) return;

    const palette = {
      c1: card.dataset.c1 || activeYearColor,
      c2: card.dataset.c2 || activeYearColor,
      c3: card.dataset.c3 || activeYearColor,
    };
    const artwork = card.dataset.artwork || null;
    const cardType = card.dataset.card || undefined;
    ambient.innerHTML = buildAmbientMarkup(palette, artwork || null, cardType);
  }

  function animateCounter(el: HTMLElement, target: number, suffix = "") {
    const cancel = rafTween(0, target, 1400, (v) => {
      el.textContent = Math.round(v).toLocaleString() + suffix;
    }, undefined, easeOutCubic);
    counterCancels.push(cancel);
  }

  function cancelCounters() {
    counterCancels.forEach((c) => c());
    counterCancels = [];
  }

  function updateStoryProgress(activeIndex: number, progress = 0) {
    const bar = document.getElementById("recapProgressBar");
    if (!bar) return;

    bar.querySelectorAll(".story-segment").forEach((seg, i) => {
      seg.classList.remove("done");
      const fill = seg.querySelector(".story-segment-fill") as HTMLElement | null;
      if (!fill) return;
      if (i < activeIndex) {
        seg.classList.add("done");
        fill.style.width = "100%";
      } else if (i === activeIndex) {
        fill.style.width = `${Math.round(progress * 100)}%`;
      } else {
        fill.style.width = "0%";
      }
    });

    const prevSide = document.getElementById("recapSidePrev") as HTMLButtonElement | null;
    const nextSide = document.getElementById("recapSideNext") as HTMLButtonElement | null;
    if (prevSide) prevSide.disabled = activeIndex <= 0;
    if (nextSide) nextSide.disabled = activeIndex >= cardCount - 1;
  }

  function activateCard(index: number) {
    const track = document.getElementById("recapDeckTrack");
    if (!track) return;

    cancelCounters();
    track.querySelectorAll(".recap-card").forEach((card, i) => {
      card.classList.toggle("active", i === index);
    });

    const activeCard = track.querySelectorAll(".recap-card")[index];
    activeCard?.querySelectorAll("[data-counter]").forEach((el) => {
      const target = parseInt((el as HTMLElement).dataset.counter || "0", 10);
      animateCounter(el as HTMLElement, target);
    });
  }

  function onStorySettled(index: number) {
    updateStoryProgress(index, 0);
    syncAmbientBg(index);
    activateCard(index);
    storyPlayer?.resetSegment();
    if (tabActive) storyPlayer?.start();
  }

  function resetPagerViewport(): HTMLElement | null {
    const oldViewport = document.getElementById("recapDeckViewport");
    if (!oldViewport) return null;

    const track = document.getElementById("recapDeckTrack");
    const newViewport = document.createElement("div");
    newViewport.id = "recapDeckViewport";
    newViewport.className = oldViewport.className;

    if (track) newViewport.appendChild(track);
    oldViewport.replaceWith(newViewport);
    bindHoldToPause(newViewport);
    return newViewport;
  }

  function goToStory(index: number) {
    if (!pager) return;
    pager.goTo(index);
  }

  function initStoryPlayer() {
    storyPlayer?.destroy();
    storyPlayer = createStoryPlayer({
      getIndex: () => pager?.index() ?? 0,
      getCount: () => cardCount,
      goTo: (index) => goToStory(index),
      onProgress: (index, progress) => updateStoryProgress(index, progress),
      isActive: () => tabActive && !holding,
    });
  }

  function initPager() {
    storyPlayer?.stop();
    const viewport = resetPagerViewport();
    const track = document.getElementById("recapDeckTrack");
    if (!viewport || !track) return;

    pager = bindPagerSwipe({
      gestureEl: viewport,
      trackEl: track,
      viewportEl: viewport,
      pageCount: cardCount,
      onSettled: (index) => onStorySettled(index),
      onProgress: (fraction) => {
        /* Manual swipe overrides timer progress visually during drag. */
        const base = Math.floor(fraction);
        const partial = fraction - base;
        updateStoryProgress(base, partial);
      },
    });

    initStoryPlayer();
    onStorySettled(0);
  }

  function bindHoldToPause(viewport: HTMLElement) {
    viewport.addEventListener("touchstart", () => {
      holding = true;
      storyPlayer?.pause();
    }, { passive: true });
    viewport.addEventListener("touchend", () => {
      holding = false;
      if (tabActive) storyPlayer?.resume();
    }, { passive: true });
    viewport.addEventListener("touchcancel", () => {
      holding = false;
      if (tabActive) storyPlayer?.resume();
    }, { passive: true });
  }

  async function loadRecapMeta(): Promise<RecapMetaData | undefined> {
    try {
      return await fetchAppJson<RecapMetaData>("/data/recap-meta.json");
    } catch {
      return undefined;
    }
  }

  async function renderRecap(year: string) {
    selectedYear = year;
    storyPlayer?.stop();

    const track = document.getElementById("recapDeckTrack");
    const progressBar = document.getElementById("recapProgressBar");
    if (!track || !progressBar) return;

    track.innerHTML = `
      <div class="recap-loading-card">
        <div class="recap-loading-shimmer"></div>
        <p>Building your ${year} recap…</p>
      </div>
    `;
    progressBar.innerHTML = "";

    const [meta, artworkCache, yearData, recapMeta] = await Promise.all([
      loadMetaCache(),
      loadArtworkCache(),
      loadYearData(year),
      loadRecapMeta(),
    ]);

    if (!meta || !yearData) {
      track.innerHTML = `<div class="recap-loading-card"><p>No data for ${year}</p></div>`;
      return;
    }

    const stats = computeRecapStats(year, yearData, meta, recapMeta);
    track.innerHTML = buildRecapCards({
      stats,
      yearColor: yearColorMap[year] || activeYearColor,
      getArtistImg: (name) => getArtistArtworkUrl(name, artworkCache),
      getTrackImg: (name, artist, album) => getArtworkUrl("track", name, artist, album, artworkCache),
      getAlbumImg: (name, artist) => getArtworkUrl("album", name, artist, "", artworkCache),
      getColor: getColorForUrl,
    });

    cardCount = track.querySelectorAll(".recap-card").length;
    progressBar.innerHTML = buildStoryProgress(cardCount);
    initPager();
  }

  function initYearPicker(totals: YearlyTotals) {
    const picker = document.getElementById("recapYearPicker");
    const highlight = document.getElementById("recapYearHighlight") as HTMLElement | null;
    if (!picker || !highlight) return;

    const years = Object.keys(totals)
      .filter((y) => {
        const parsed = parseInt(y, 10);
        return !isNaN(parsed) && parsed >= 2023;
      })
      .sort()
      .reverse();

    if (years.length === 0) {
      picker.innerHTML = `<span class="year-picker-loading">No years available</span>`;
      return;
    }

    yearColorMap = buildYearColorMap(years);

    picker.innerHTML = years
      .map(
        (year, idx) =>
          `<button type="button" class="range-btn${idx === 0 ? " active" : ""}" data-year="${year}">${year}</button>`,
      )
      .join("");

    const buttons = [...picker.querySelectorAll(".range-btn")] as HTMLElement[];
    yearHighlightCtrl = createSlidingHighlight({
      highlightEl: highlight,
      buttons,
      accentFor: (btn) => {
        const year = btn.dataset.year || "";
        const color = yearColorMap[year] || "#eab308";
        return { color, glow: hexToRgba(color, 0.4) };
      },
    });
    yearHighlightCtrl.observe();
    const activeBtn = buttons.find((b) => b.classList.contains("active")) ?? buttons[0];
    if (activeBtn) {
      yearHighlightCtrl.sync(activeBtn, false);
      applyYearAccent(yearColorMap[activeBtn.dataset.year || ""] || "#eab308");
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const year = btn.dataset.year;
        if (!year || year === selectedYear) return;
        buttons.forEach((c) => c.classList.remove("active"));
        btn.classList.add("active");
        yearHighlightCtrl?.sync(btn);
        applyYearAccent(yearColorMap[year] || "#eab308");
        void renderRecap(year);
      });
    });

    void renderRecap(years[0]);
  }

  document.addEventListener("DOMContentLoaded", async () => {
    tabActive = document.getElementById("view-recaps")?.classList.contains("active") ?? false;

    document.getElementById("recapSidePrev")?.addEventListener("click", () => {
      if (pager) goToStory(Math.max(pager.index() - 1, 0));
    });
    document.getElementById("recapSideNext")?.addEventListener("click", () => {
      if (pager) goToStory(Math.min(pager.index() + 1, cardCount - 1));
    });

    document.addEventListener("keydown", (e) => {
      if (!tabActive) return;
      if (e.key === "ArrowLeft") pager && goToStory(Math.max(pager.index() - 1, 0));
      if (e.key === "ArrowRight") pager && goToStory(Math.min(pager.index() + 1, cardCount - 1));
    });

    window.addEventListener("tab-navigated", (e) => {
      const tab = (e as CustomEvent<{ tab: string }>).detail.tab;
      tabActive = tab === "recaps";
      if (tabActive) {
        storyPlayer?.start();
        if (pager) activateCard(pager.index());
      } else {
        storyPlayer?.stop();
      }
    });

    const viewport = document.getElementById("recapDeckViewport");
    if (viewport) bindHoldToPause(viewport);

    try {
      const totals = await fetchAppJson<YearlyTotals>("/data/yearly-totals.json");
      initYearPicker(totals);
    } catch (err) {
      console.warn("Failed to load yearly totals for recaps:", err);
    }
  });

  onPathsUpdated(["/data/yearly-totals.json"], ({ data }) => {
    initYearPicker(data as YearlyTotals);
  });
</script>
