---
import Reports from "./Reports.astro";
import Recaps from "./Recaps.astro";
---

<div class="dashboard-container panel-fill panel-scroll panel-scroll-active">
  <Recaps />

  <!-- Stats strip: one card, four icon-over-number columns -->
  <div class="glass-card stats-strip shrink-0">
    <div class="stat-item">
      <div class="stat-icon-wrapper pink">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
      </div>
      <div class="stat-content">
        <h3 class="stat-value text-pink" id="stat-total-scrobbles">-</h3>
        <span class="stat-label">Plays</span>
      </div>
    </div>

    <div class="stat-item">
      <div class="stat-icon-wrapper cyan">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <div class="stat-content">
        <h3 class="stat-value text-cyan" id="stat-year-scrobbles">-</h3>
        <span class="stat-label">This year</span>
      </div>
    </div>

    <div class="stat-item">
      <div class="stat-icon-wrapper violet">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="stat-content">
        <h3 class="stat-value text-violet" id="stat-active-days">-</h3>
        <span class="stat-label">Active days</span>
      </div>
    </div>

    <div class="stat-item">
      <div class="stat-icon-wrapper green">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
        </svg>
      </div>
      <div class="stat-content">
        <h3 class="stat-value text-green" id="stat-daily-avg">-</h3>
        <span class="stat-label">Per day</span>
      </div>
    </div>
  </div>

  <Reports />
</div>

<style>
  .dashboard-container {
    width: 100%;
    height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    min-height: 0;
  }

  /* A 10px gutter on both sides, given back as padding, so children such as
     the story rail can bleed past the cards without the scroller clipping
     their glow. */
  .dashboard-container.panel-scroll {
    width: calc(100% + 20px);
    margin-inline: -10px;
    padding-inline: 10px;
  }

  /* Recaps stay compact; reports fill the leftover dashboard height. */
  .dashboard-container :global(.reports-card) {
    flex: 1 1 auto;
    min-height: 0;
  }

  .dashboard-container :global(.recaps-stories) {
    flex: 0 0 auto;
  }

  /* Not four equal columns: the total runs to seven characters and the daily
     average to two, so equal widths crowd the left edge and leave the right one
     loose. Weighting the columns by their typical width evens the side gaps. */
  .stats-strip {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.02fr) minmax(0, 0.98fr) minmax(0, 0.8fr);
    padding: 14px 6px 12px;
    background: rgba(255, 255, 255, 0.02);
  }

  .stat-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0 4px;
    text-align: center;
  }

  .stat-item + .stat-item {
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }

  .stat-icon-wrapper {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .stat-icon-wrapper svg {
    width: 18px;
    height: 18px;
  }

  .stat-icon-wrapper.pink {
    background: linear-gradient(135deg, var(--accent-pink), #e01e43);
    box-shadow: 0 4px 12px var(--accent-pink-glow);
  }
  .stat-icon-wrapper.cyan {
    background: linear-gradient(135deg, var(--accent-cyan), #00a3b0);
    box-shadow: 0 4px 12px var(--accent-cyan-glow);
  }
  .stat-icon-wrapper.violet {
    background: linear-gradient(135deg, var(--accent-violet), #7c3aed);
    box-shadow: 0 4px 12px var(--accent-violet-glow);
  }
  .stat-icon-wrapper.green {
    background: linear-gradient(135deg, var(--accent-green), #16a34a);
    box-shadow: 0 4px 12px var(--accent-green-glow);
  }

  .stat-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    max-width: 100%;
    white-space: nowrap;
    line-height: 1.1;
  }

  .stat-label {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* One soft glow rather than two stacked ones: the double halo smeared the
     digits into each other at this size. */
  .stat-value {
    font-family: var(--font-numeric);
    font-size: 26px;
    font-weight: var(--font-numeric-weight);
    color: #fff;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .text-pink {
    color: var(--accent-pink);
    text-shadow: 0 0 18px var(--accent-pink-glow);
  }
  .text-cyan {
    color: var(--accent-cyan);
    text-shadow: 0 0 18px var(--accent-cyan-glow);
  }
  .text-violet {
    color: var(--accent-violet);
    text-shadow: 0 0 18px var(--accent-violet-glow);
  }
  .text-green {
    color: var(--accent-green);
    text-shadow: 0 0 18px var(--accent-green-glow);
  }

  @media (max-width: 767px) {
    .stats-strip {
      padding: 12px 2px 10px;
    }
    .stat-item {
      gap: 5px;
      padding: 0 2px;
    }
    .stat-icon-wrapper {
      width: 28px;
      height: 28px;
    }
    .stat-icon-wrapper svg {
      width: 14px;
      height: 14px;
    }
    .stat-value {
      font-size: 21px;
    }

    .stat-label {
      font-size: 9.5px;
      letter-spacing: 0.06em;
    }
  }
</style>

<script>
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import type { YearlyTotals } from "../types/music";

  // Each column is a quarter of a phone width, so past six digits the full
  // figure no longer fits; compact notation keeps it to ~5 characters.
  const compact = new Intl.NumberFormat(undefined, {
    notation: "compact",
    maximumFractionDigits: 1,
  });
  function formatStat(value: number): string {
    return value >= 1_000_000 ? compact.format(value) : value.toLocaleString();
  }

  document.addEventListener("DOMContentLoaded", () => {
    async function loadDashboardStats() {
      try {
        const totals = await fetchAppJson<YearlyTotals>("/data/yearly-totals.json");

        let totalScrobbles = 0;
        let activeDays = 0;
        let totalPossibleDays = 0;
        let currentYearScrobbles = 0;
        const currentYearStr = String(new Date().getFullYear());

        for (const [yearStr, dayCounts] of Object.entries(totals)) {
          let sum = 0;
          for (const count of dayCounts) {
            sum += count;
            if (count > 0) activeDays++;
          }
          totalScrobbles += sum;
          totalPossibleDays += dayCounts.length;
          if (yearStr === currentYearStr) currentYearScrobbles = sum;
        }

        const dailyAverage =
          totalPossibleDays > 0
            ? Math.round((totalScrobbles / totalPossibleDays) * 10) / 10
            : 0;

        const totalEl = document.getElementById("stat-total-scrobbles");
        const yearEl = document.getElementById("stat-year-scrobbles");
        const activeEl = document.getElementById("stat-active-days");
        const avgEl = document.getElementById("stat-daily-avg");

        if (totalEl) totalEl.textContent = formatStat(totalScrobbles);
        if (yearEl) yearEl.textContent = formatStat(currentYearScrobbles);
        if (activeEl) activeEl.textContent = formatStat(activeDays);
        if (avgEl) avgEl.textContent = dailyAverage.toLocaleString();
      } catch (err) {
        console.error("Failed to compute dashboard stats:", err);
      }
    }

    loadDashboardStats();
    onPathsUpdated(["/data/yearly-totals.json"], () => loadDashboardStats());
  });
</script>
