---
import Reports from "./Reports.astro";
import Recaps from "./Recaps.astro";
---

<div class="dashboard-container panel-fill panel-scroll panel-scroll-active">
  <Recaps />

  <!-- Stats strip: one card, four icon-over-number columns -->
  <div class="glass-card stats-strip shrink-0">
    <div class="stat-item">
      <div class="stat-icon-wrapper pink">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
      </div>
      <div class="stat-content">
        <h3 class="stat-value text-pink" id="stat-total-scrobbles">-</h3>
        <span class="stat-label">Total</span>
      </div>
    </div>

    <div class="stat-item">
      <div class="stat-icon-wrapper cyan">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <div class="stat-content">
        <h3 class="stat-value text-cyan" id="stat-year-scrobbles">-</h3>
        <span class="stat-label">This year</span>
      </div>
    </div>

    <div class="stat-item">
      <div class="stat-icon-wrapper violet">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="stat-content">
        <h3 class="stat-value text-violet" id="stat-active-days">-</h3>
        <span class="stat-label">Days</span>
      </div>
    </div>

    <div class="stat-item">
      <div class="stat-icon-wrapper green">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
        </svg>
      </div>
      <div class="stat-content">
        <h3 class="stat-value text-green" id="stat-daily-avg">-</h3>
        <span class="stat-label">Average</span>
      </div>
    </div>
  </div>

  <Reports />
</div>

<style>
  .dashboard-container {
    width: 100%;
    height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    min-height: 0;
  }

  /* Recaps stay compact; reports fill the leftover dashboard height. */
  .dashboard-container :global(.reports-card) {
    flex: 1 1 auto;
    min-height: 0;
  }

  .dashboard-container :global(.recaps-stories) {
    flex: 0 0 auto;
  }

  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 12px 6px;
    background: rgba(255, 255, 255, 0.02);
  }

  .stat-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0 4px;
    text-align: center;
  }

  .stat-item + .stat-item {
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }

  .stat-icon-wrapper {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .stat-icon-wrapper svg {
    width: 18px;
    height: 18px;
  }

  .stat-icon-wrapper.pink {
    background: linear-gradient(135deg, var(--accent-pink), #e01e43);
    box-shadow: 0 4px 12px var(--accent-pink-glow);
  }
  .stat-icon-wrapper.cyan {
    background: linear-gradient(135deg, var(--accent-cyan), #00a3b0);
    box-shadow: 0 4px 12px var(--accent-cyan-glow);
  }
  .stat-icon-wrapper.violet {
    background: linear-gradient(135deg, var(--accent-violet), #7c3aed);
    box-shadow: 0 4px 12px var(--accent-violet-glow);
  }
  .stat-icon-wrapper.green {
    background: linear-gradient(135deg, var(--accent-green), #16a34a);
    box-shadow: 0 4px 12px var(--accent-green-glow);
  }

  .stat-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    max-width: 100%;
    white-space: nowrap;
    line-height: 1.15;
  }

  .stat-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.01em;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stat-value {
    font-family: var(--font-header);
    font-size: 26px;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .text-pink {
    color: var(--accent-pink);
    text-shadow: 0 0 20px var(--accent-pink-glow), 0 0 40px var(--accent-pink-glow);
  }
  .text-cyan {
    color: var(--accent-cyan);
    text-shadow: 0 0 20px var(--accent-cyan-glow), 0 0 40px var(--accent-cyan-glow);
  }
  .text-violet {
    color: var(--accent-violet);
    text-shadow: 0 0 20px var(--accent-violet-glow), 0 0 40px var(--accent-violet-glow);
  }
  .text-green {
    color: var(--accent-green);
    text-shadow: 0 0 20px var(--accent-green-glow), 0 0 40px var(--accent-green-glow);
  }

  @media (max-width: 767px) {
    .stats-strip {
      padding: 10px 2px;
      border-radius: 16px;
    }
    .stat-item {
      gap: 5px;
      padding: 0 2px;
    }
    .stat-icon-wrapper {
      width: 26px;
      height: 26px;
      border-radius: 7px;
    }
    .stat-icon-wrapper svg {
      width: 14px;
      height: 14px;
    }
    .stat-value {
      font-size: 20px;
    }
  }
</style>

<script>
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import type { YearlyTotals } from "../types/music";

  document.addEventListener("DOMContentLoaded", () => {
    async function loadDashboardStats() {
      try {
        const totals = await fetchAppJson<YearlyTotals>("/data/yearly-totals.json");

        let totalScrobbles = 0;
        let activeDays = 0;
        let totalPossibleDays = 0;
        let currentYearScrobbles = 0;
        const currentYearStr = String(new Date().getFullYear());

        for (const [yearStr, dayCounts] of Object.entries(totals)) {
          let sum = 0;
          for (const count of dayCounts) {
            sum += count;
            if (count > 0) activeDays++;
          }
          totalScrobbles += sum;
          totalPossibleDays += dayCounts.length;
          if (yearStr === currentYearStr) currentYearScrobbles = sum;
        }

        const dailyAverage =
          totalPossibleDays > 0
            ? Math.round((totalScrobbles / totalPossibleDays) * 10) / 10
            : 0;

        const totalEl = document.getElementById("stat-total-scrobbles");
        const yearEl = document.getElementById("stat-year-scrobbles");
        const activeEl = document.getElementById("stat-active-days");
        const avgEl = document.getElementById("stat-daily-avg");

        if (totalEl) totalEl.textContent = totalScrobbles.toLocaleString();
        if (yearEl) yearEl.textContent = currentYearScrobbles.toLocaleString();
        if (activeEl) activeEl.textContent = `${activeDays}`;
        if (avgEl) avgEl.textContent = `${dailyAverage}`;
      } catch (err) {
        console.error("Failed to compute dashboard stats:", err);
      }
    }

    loadDashboardStats();
    onPathsUpdated(["/data/yearly-totals.json"], () => loadDashboardStats());
  });
</script>
