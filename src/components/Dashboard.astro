---
---

<div class="dashboard-container">
  <!-- Stats Grid -->
  <div class="stats-grid">
    <div class="glass-card stat-card hover-scale">
      <div class="stat-icon-wrapper pink">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
      </div>
      <div class="stat-content">
        <span class="stat-label">TOTAL PLAYS</span>
        <h3 class="stat-value text-pink" id="stat-total-scrobbles">-</h3>
      </div>
    </div>

    <div class="glass-card stat-card hover-scale">
      <div class="stat-icon-wrapper cyan">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <div class="stat-content">
        <span class="stat-label">PLAYS THIS YEAR</span>
        <h3 class="stat-value text-cyan" id="stat-year-scrobbles">-</h3>
      </div>
    </div>

    <div class="glass-card stat-card hover-scale">
      <div class="stat-icon-wrapper violet">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="stat-content">
        <span class="stat-label">ACTIVE DAYS</span>
        <h3 class="stat-value text-violet" id="stat-active-days">-</h3>
      </div>
    </div>

    <div class="glass-card stat-card hover-scale">
      <div class="stat-icon-wrapper green">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
        </svg>
      </div>
      <div class="stat-content">
        <span class="stat-label">DAILY AVERAGE</span>
        <h3 class="stat-value text-green" id="stat-daily-avg">-</h3>
      </div>
    </div>
  </div>

  <!-- Main Grid Column (Recent Plays & Top Highlights) -->
  <div class="main-dashboard-columns">
    <!-- stats.fm Style Top Hits Carousels -->
    <div class="glass-card highlights-section">
      <div class="section-header">
        <h4>Over the last month...</h4>
      </div>
      <div class="carousel-section" id="topHitsCarousels">
        <div class="no-data-message">Loading...</div>
      </div>
    </div>

    <!-- Recent Plays Feed Removed (Now in Recents.astro) -->
  </div>
</div>

<style>
  .dashboard-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 24px;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .stat-card {
    display: flex;
    align-items: center;
    padding: 20px;
    gap: 16px;
    background: rgba(255, 255, 255, 0.02);
  }

  .stat-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .stat-icon-wrapper svg {
    width: 24px;
    height: 24px;
  }

  /* Stat wrapper colored gradients */
  .stat-icon-wrapper.pink {
    background: linear-gradient(135deg, var(--accent-pink), #e01e43);
    box-shadow: 0 4px 12px var(--accent-pink-glow);
  }
  .stat-icon-wrapper.cyan {
    background: linear-gradient(135deg, var(--accent-cyan), #00a3b0);
    box-shadow: 0 4px 12px var(--accent-cyan-glow);
  }
  .stat-icon-wrapper.violet {
    background: linear-gradient(135deg, var(--accent-violet), #7c3aed);
    box-shadow: 0 4px 12px var(--accent-violet-glow);
  }
  .stat-icon-wrapper.green {
    background: linear-gradient(135deg, var(--accent-green), #16a34a);
    box-shadow: 0 4px 12px var(--accent-green-glow);
  }

  .stat-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .stat-value {
    font-family: var(--font-header);
    font-size: 26px;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .text-pink {
    color: var(--accent-pink);
    text-shadow:
      0 0 20px var(--accent-pink-glow),
      0 0 40px var(--accent-pink-glow);
  }
  .text-cyan {
    color: var(--accent-cyan);
    text-shadow:
      0 0 20px var(--accent-cyan-glow),
      0 0 40px var(--accent-cyan-glow);
  }
  .text-violet {
    color: var(--accent-violet);
    text-shadow:
      0 0 20px var(--accent-violet-glow),
      0 0 40px var(--accent-violet-glow);
  }
  .text-green {
    color: var(--accent-green);
    text-shadow:
      0 0 20px var(--accent-green-glow),
      0 0 40px var(--accent-green-glow);
  }

  /* Stacked Full-Width Layout */
  .main-dashboard-columns {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-header h4 {
    font-family: var(--font-header);
    font-size: 18px;
    font-weight: 700;
    color: #fff;
  }

  /* Highlights Section */
  .highlights-section {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(255, 255, 255, 0.01);
  }

  /* stats.fm style carousels with global scoping for injected dynamic nodes */
  .highlights-section :global(.carousel-section) {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }

  .highlights-section :global(.carousel-wrapper) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .highlights-section :global(.carousel-title) {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .highlights-section :global(.carousel-scroll) {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding: 28px 24px 16px 24px;
    margin: -28px -24px -12px -24px;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 24px;
    scroll-padding-right: 24px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    width: calc(100% + 48px);
  }

  .highlights-section :global(.carousel-scroll::-webkit-scrollbar) {
    display: none;
  }

  .highlights-section :global(.carousel-item) {
    flex: 0 0 110px;
    width: 110px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    scroll-snap-align: start;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .highlights-section :global(.carousel-item:hover) {
    transform: translateY(-3px);
  }

  .highlights-section :global(.carousel-artwork-wrapper) {
    position: relative;
    width: 110px;
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
    overflow: visible;
  }

  .carousel-item:nth-child(1) .carousel-artwork-wrapper {
    box-shadow: 0 0 15px var(--accent-pink-glow);
    border-color: var(--accent-pink);
  }
  .carousel-item:nth-child(2) .carousel-artwork-wrapper {
    box-shadow: 0 0 15px var(--accent-cyan-glow);
    border-color: var(--accent-cyan);
  }
  .carousel-item:nth-child(3) .carousel-artwork-wrapper {
    box-shadow: 0 0 15px var(--accent-violet-glow);
    border-color: var(--accent-violet);
  }
  .carousel-item:nth-child(4) .carousel-artwork-wrapper {
    box-shadow: 0 0 15px var(--accent-green-glow);
    border-color: var(--accent-green);
  }

  .highlights-section :global(.carousel-artwork-wrapper.circle) {
    border-radius: 50%;
  }

  .highlights-section :global(.carousel-artwork-wrapper.square) {
    border-radius: 10px;
  }

  .highlights-section :global(.carousel-artwork-wrapper img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .highlights-section :global(.carousel-artwork-wrapper.circle img) {
    border-radius: 50%;
  }

  .highlights-section :global(.carousel-artwork-wrapper.square img) {
    border-radius: 10px;
  }

  .highlights-section :global(.carousel-artwork-wrapper svg) {
    width: 32px;
    height: 32px;
    color: var(--text-muted);
  }

  .highlights-section :global(.carousel-rank-badge) {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    color: #000;
    font-size: 12px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    /* Must sit above the artwork img, which is itself positioned with
       z-index: 2 (see .carousel-artwork-wrapper .artwork-img in ui.ts'
       shared thumb styles), otherwise the badge renders underneath it. */
    z-index: 3;
  }

  .highlights-section :global(.carousel-item-info) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .highlights-section :global(.carousel-item-title) {
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .highlights-section :global(.carousel-item-subtitle) {
    font-size: 14px;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .highlights-section :global(.carousel-item-plays) {
    font-size: 14px;
    color: var(--accent-pink);
    font-weight: 700;
  }

  /* Invisible trigger element used for horizontal infinite-scroll loading,
     appended at the end of each carousel's item list. */
  .highlights-section :global(.carousel-scroll-sentinel) {
    flex: 0 0 1px;
    width: 1px;
    height: 1px;
  }

  /* Responsive card padding overrides */
  @media (max-width: 767px) {
    .dashboard-container {
      gap: 16px;
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .stat-card {
      padding: 12px;
      gap: 10px;
      border-radius: 12px;
    }
    .stat-icon-wrapper {
      width: 36px;
      height: 36px;
      border-radius: 8px;
    }
    .stat-icon-wrapper svg {
      width: 18px;
      height: 18px;
    }
    .stat-value {
      font-size: 20px;
    }
    .highlights-section {
      padding: 12px;
      gap: 12px;
      border-radius: 16px;
    }
    .highlights-section :global(.carousel-scroll) {
      padding: 28px 16px 16px 16px;
      margin: -28px -12px -12px -12px;
      width: calc(100% + 24px);
      scroll-padding-left: 16px;
      scroll-padding-right: 16px;
    }
    .main-dashboard-columns {
      gap: 16px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .highlights-section {
      padding: 18px;
      border-radius: 16px;
    }
    .stat-card {
      padding: 16px;
    }
  }
</style>

<script>
  import {
    getArtworkUrl,
    getColorForUrl,
    loadArtworkCache,
    loadMetaCache,
    getArtworkThumbHTML,
    initArtworkImages,
    escapeHTML,
    dataUrl,
  } from "../utils/ui";
  import type { YearlyTotals } from "../types/music";
  import { loadYearsData, aggregateTrackCounts, rollupDashboardCounts } from "../utils/scrobbles";
  import { createInfiniteScroll } from "../utils/infiniteScroll";
  import { getGlowStyle } from "../utils/theme";
  import { bindEntityClicks } from "../utils/events";

  document.addEventListener("DOMContentLoaded", () => {
    async function loadDashboardStats() {
      try {
        const res = await fetch(dataUrl("/data/yearly-totals.json"));
        const totals: YearlyTotals = await res.json();

        let totalScrobbles = 0;
        let activeDays = 0;
        let totalPossibleDays = 0;
        let currentYearScrobbles = 0;

        const currentYearStr = new Date().toISOString().split("-")[0];

        for (const [yearStr, dayCounts] of Object.entries(totals)) {
          const sum = dayCounts.reduce((acc, c) => acc + c, 0);
          totalScrobbles += sum;

          activeDays += dayCounts.filter((count) => count > 0).length;
          totalPossibleDays += dayCounts.length;

          if (yearStr === currentYearStr) {
            currentYearScrobbles = sum;
          }
        }

        const dailyAverage =
          totalPossibleDays > 0
            ? Math.round((totalScrobbles / totalPossibleDays) * 10) / 10
            : 0;

        const totalEl = document.getElementById("stat-total-scrobbles");
        const yearEl = document.getElementById("stat-year-scrobbles");
        const activeEl = document.getElementById("stat-active-days");
        const avgEl = document.getElementById("stat-daily-avg");

        if (totalEl) totalEl.textContent = totalScrobbles.toLocaleString();
        if (yearEl) yearEl.textContent = currentYearScrobbles.toLocaleString();
        if (activeEl) activeEl.textContent = `${activeDays}`;
        if (avgEl) avgEl.textContent = `${dailyAverage}`;
      } catch (err) {
        console.error("Failed to compute dashboard stats:", err);
      }
    }

    async function loadTopHitsCarousels() {
      const container = document.getElementById("topHitsCarousels");
      if (!container) return;

      try {
        const [recentRes, meta] = await Promise.all([
          fetch(dataUrl("/data/recent.json")),
          loadMetaCache(),
        ]);

        const recentList: { uts: number }[] = await recentRes.json();
        const artworkCache = await loadArtworkCache();

        const latestTimestamp =
          recentList[0]?.uts || Math.floor(Date.now() / 1000);
        const startTime = latestTimestamp - 28 * 24 * 60 * 60;

        const startYear = new Date(startTime * 1000).getUTCFullYear();
        const endYear = new Date(latestTimestamp * 1000).getUTCFullYear();
        const yearsToLoad = Array.from(
          new Set([String(startYear), String(endYear)]),
        );

        await loadYearsData(yearsToLoad);

        const startDateStr = new Date(startTime * 1000).toISOString().split("T")[0];
        const endDateStr = new Date(latestTimestamp * 1000).toISOString().split("T")[0];

        const trackCounts = aggregateTrackCounts(yearsToLoad, startDateStr, endDateStr);
        const { artists: topArtists, tracks: topSongs, albums: topAlbums } =
          rollupDashboardCounts(trackCounts, meta);

        function rankStyleFor(idx: number): string {
          if (idx === 0)
            return "background: #000; color: var(--accent-green); text-shadow: 0 0 10px var(--accent-green); box-shadow: 0 0 8px var(--accent-green-glow); border: 1px solid var(--accent-green-glow);";
          if (idx === 1)
            return "background: #000; color: var(--accent-yellow); text-shadow: 0 0 10px var(--accent-yellow); box-shadow: 0 0 8px var(--accent-yellow-glow); border: 1px solid var(--accent-yellow-glow);";
          if (idx === 2)
            return "background: #000; color: var(--accent-red); text-shadow: 0 0 10px var(--accent-red); box-shadow: 0 0 8px var(--accent-red-glow); border: 1px solid var(--accent-red-glow);";
          return "";
        }

        function renderCarouselItem(
          type: "artist" | "track" | "album",
          item: { id: number; name: string; count: number; artistName?: string; albumName?: string },
          idx: number,
        ): string {
          const img =
            type === "artist"
              ? getArtworkUrl("artist", item.name, item.name, "", artworkCache)
              : type === "track"
                ? getArtworkUrl("track", item.name, item.artistName!, item.albumName!, artworkCache)
                : getArtworkUrl("album", item.name, item.artistName!, item.name, artworkCache);

          const thumb = getArtworkThumbHTML(img);
          const colorObj = getColorForUrl(img);
          const playsStyle = colorObj ? getGlowStyle(colorObj, { blur: 8, alpha: 0.4, weight: 800 }) : "";
          const shape = type === "artist" ? "circle" : "square";
          const entityType = type === "track" ? "track" : type;
          const subtitle =
            type === "artist"
              ? ""
              : `<span class="carousel-item-subtitle">${escapeHTML(item.artistName || "")}</span>`;

          return `
            <div class="carousel-item clickable-entity" data-type="${entityType}" data-id="${item.id}">
              <div class="carousel-artwork-wrapper ${shape}">
                <div class="carousel-rank-badge" style="${rankStyleFor(idx)}">${idx + 1}</div>
                ${thumb}
              </div>
              <div class="carousel-item-info">
                <span class="carousel-item-title">${escapeHTML(item.name)}</span>
                ${subtitle}
                <span class="carousel-item-plays" style="${playsStyle}">${item.count}</span>
              </div>
            </div>
          `;
        }

        let skeletonHtml = "";
        if (topSongs.length > 0) {
          skeletonHtml += `
            <div class="carousel-wrapper">
              <span class="carousel-title">Top Tracks</span>
              <div class="carousel-scroll" id="carousel-scroll-tracks"></div>
            </div>
          `;
        }
        if (topAlbums.length > 0) {
          skeletonHtml += `
            <div class="carousel-wrapper">
              <span class="carousel-title">Top Albums</span>
              <div class="carousel-scroll" id="carousel-scroll-albums"></div>
            </div>
          `;
        }
        if (topArtists.length > 0) {
          skeletonHtml += `
            <div class="carousel-wrapper">
              <span class="carousel-title">Top Artists</span>
              <div class="carousel-scroll" id="carousel-scroll-artists"></div>
            </div>
          `;
        }

        container.innerHTML =
          skeletonHtml ||
          '<div class="no-data-message">No data found for last 4 weeks</div>';

        const tracksScroll = document.getElementById("carousel-scroll-tracks");
        if (tracksScroll) {
          createInfiniteScroll({
            container: tracksScroll,
            items: topSongs,
            chunkSize: 10,
            renderItem: (item, idx) => renderCarouselItem("track", item, idx),
            root: tracksScroll,
            rootMargin: "0px 600px 0px 0px",
            sentinelClass: "carousel-scroll-sentinel",
            onChunkRendered: () => initArtworkImages(tracksScroll),
          });
        }
        const albumsScroll = document.getElementById("carousel-scroll-albums");
        if (albumsScroll) {
          createInfiniteScroll({
            container: albumsScroll,
            items: topAlbums,
            chunkSize: 10,
            renderItem: (item, idx) => renderCarouselItem("album", item, idx),
            root: albumsScroll,
            rootMargin: "0px 600px 0px 0px",
            sentinelClass: "carousel-scroll-sentinel",
            onChunkRendered: () => initArtworkImages(albumsScroll),
          });
        }
        const artistsScroll = document.getElementById("carousel-scroll-artists");
        if (artistsScroll) {
          createInfiniteScroll({
            container: artistsScroll,
            items: topArtists,
            chunkSize: 10,
            renderItem: (item, idx) => renderCarouselItem("artist", item, idx),
            root: artistsScroll,
            rootMargin: "0px 600px 0px 0px",
            sentinelClass: "carousel-scroll-sentinel",
            onChunkRendered: () => initArtworkImages(artistsScroll),
          });
        }
      } catch (err) {
        console.error("Failed to load top hits carousels:", err);
        container.innerHTML =
          '<div class="no-data-message">Failed to load carousels</div>';
      }
    }

    const carouselsEl = document.getElementById("topHitsCarousels");
    if (carouselsEl) bindEntityClicks(carouselsEl, { nested: false });

    loadDashboardStats();
    loadTopHitsCarousels();
  });
</script>
