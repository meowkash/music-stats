---
---

<div class="glass-card activity-card" id="activityCard">
  <div class="activity-header">
    <div class="activity-title">
      <h4>Listening path</h4>
      <p class="activity-sub" id="activityRangeLabel">Last month</p>
    </div>
    <div class="activity-range" role="group" aria-label="Range">
      <button class="range-btn" data-days="7" type="button">1w</button>
      <button class="range-btn is-active" data-days="30" type="button">1m</button>
      <button class="range-btn" data-days="90" type="button">3m</button>
    </div>
  </div>

  <div class="activity-plot" id="activityPlot"></div>
</div>

<style>
  .activity-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 18px 14px;
    min-height: 0;
    background: rgba(255, 255, 255, 0.015);
  }

  .activity-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-shrink: 0;
  }

  .activity-title h4 {
    font-family: var(--font-header);
    font-size: 17px;
    font-weight: 700;
    color: #fff;
  }

  .activity-sub {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .activity-range {
    display: flex;
    gap: 4px;
    padding: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.07);
    flex-shrink: 0;
  }

  .range-btn {
    padding: 5px 11px;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .range-btn.is-active {
    background: rgba(255, 45, 85, 0.16);
    color: var(--accent-pink);
    box-shadow: inset 0 0 0 1px rgba(255, 45, 85, 0.3);
  }

  .activity-plot {
    flex: 1;
    min-height: 150px;
    /* Capped so a sparse dashboard can't stretch the series into a wall of
       chart; the card keeps the leftover space instead. */
    max-height: 300px;
    margin: auto 0;
    display: flex;
    width: 100%;
  }

  /* The viewBox is rendered at the measured pixel size of this box, so the
     chart fills it exactly with no letterboxing and no non-uniform scaling. */
  .activity-plot :global(svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .activity-plot :global(.activity-area) {
    fill: url(#activityAreaGradient);
  }

  .activity-plot :global(.activity-line) {
    fill: none;
    stroke: url(#activityLineGradient);
    stroke-width: 2.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 10px rgba(255, 45, 85, 0.35));
  }

  .activity-plot :global(.activity-avg-line) {
    stroke: var(--accent-green);
    stroke-width: 2.75;
    stroke-dasharray: 5 5;
    opacity: 0.5;
  }

  .activity-plot :global(.activity-avg-label) {
    fill: var(--accent-green);
    font-size: 10.5px;
    font-weight: 700;
    opacity: 0.95;
  }

  .activity-plot :global(.activity-tick) {
    fill: rgba(255, 255, 255, 0.35);
    font-size: 10px;
    font-weight: 600;
  }

  .activity-plot :global(.activity-peak-halo) {
    fill: var(--accent-yellow);
    opacity: 0.22;
  }

  .activity-plot :global(.activity-peak) {
    fill: var(--accent-yellow);
    stroke: rgba(0, 0, 0, 0.35);
    stroke-width: 1;
  }

  .activity-plot :global(.activity-peak-label) {
    fill: var(--accent-yellow);
    font-size: 10.5px;
    font-weight: 700;
  }

  /* Draw-on reveal. Length is set per render since the path changes with range. */
  .activity-plot :global(.activity-line.is-animating) {
    animation: activity-draw 1.1s var(--ios-spring) both;
  }

  @keyframes activity-draw {
    from {
      stroke-dashoffset: var(--path-length);
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .activity-plot :global(.is-fading) {
    animation: activity-fade 0.9s var(--ios-spring) both;
  }

  @keyframes activity-fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 767px) {
    .activity-card {
      padding: 14px 14px 12px;
      border-radius: 16px;
    }

    .activity-plot {
      min-height: 130px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .activity-plot :global(.activity-line.is-animating),
    .activity-plot :global(.is-fading) {
      animation: none;
    }
  }
</style>

<script>
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import type { YearlyTotals } from "../types/music";
  import { buildActivitySeries, buildPathGeometry } from "../utils/activityPath";

  const RANGE_LABELS: Record<number, string> = {
    7: "Last week",
    30: "Last 30 days",
    90: "Last 3 months",
  };

  document.addEventListener("DOMContentLoaded", () => {
    const plot = document.getElementById("activityPlot") as HTMLDivElement;
    const rangeLabel = document.getElementById("activityRangeLabel") as HTMLParagraphElement;
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".activity-range .range-btn"),
    );

    let totals: YearlyTotals | null = null;
    let days = 30;

    /**
     * `animate` is off for resize-driven rebuilds — replaying the draw-on every
     * time the panel settles or the window nudges reads as a glitch.
     */
    function render(animate = true) {
      if (!totals) return;
      const reveal = animate ? " is-animating" : "";
      const fade = animate ? " is-fading" : "";

      const series = buildActivitySeries(totals, days);
      const geo = buildPathGeometry(
        series,
        Math.max(plot.clientWidth || 720, 240),
        Math.max(plot.clientHeight || 190, 130),
      );
      const avg = geo.averageLine;

      plot.innerHTML = `
        <svg viewBox="0 0 ${geo.width} ${geo.height}" role="img"
             aria-label="Daily listening over the ${RANGE_LABELS[days].toLowerCase()}, averaging ${avg.value} plays a day">
          <defs>
            <linearGradient id="activityLineGradient" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#00f0ff" />
              <stop offset="50%" stop-color="#a855f7" />
              <stop offset="100%" stop-color="#ff2d55" />
            </linearGradient>
            <linearGradient id="activityAreaGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgba(168, 85, 247, 0.28)" />
              <stop offset="100%" stop-color="rgba(168, 85, 247, 0)" />
            </linearGradient>
          </defs>

          <path class="activity-area${fade}" d="${geo.area}" />
          <path class="activity-line${reveal}" d="${geo.line}" />

          <g class="${fade.trim()}">
            <line class="activity-avg-line" x1="${avg.x1.toFixed(2)}" y1="${avg.y.toFixed(2)}"
                  x2="${avg.x2.toFixed(2)}" y2="${avg.y.toFixed(2)}" />
            <text class="activity-avg-label" x="${avg.labelX.toFixed(2)}" y="${avg.labelY.toFixed(2)}"
                  text-anchor="${avg.anchor}">${avg.value} Daily Plays on Average</text>
          </g>

          ${
            geo.peak
              ? `<g class="${fade.trim()}">
                   <circle class="activity-peak-halo" cx="${geo.peak.x.toFixed(2)}" cy="${geo.peak.y.toFixed(2)}" r="9" />
                   <circle class="activity-peak" cx="${geo.peak.x.toFixed(2)}" cy="${geo.peak.y.toFixed(2)}" r="4" />
                   <text class="activity-peak-label" x="${geo.peak.labelX.toFixed(2)}" y="${geo.peak.labelY.toFixed(2)}"
                         text-anchor="${geo.peak.anchor}">${geo.peak.label}</text>
                 </g>`
              : ""
          }

          <g>${geo.ticks
            .map(
              (tick) =>
                `<text class="activity-tick" x="${tick.x.toFixed(2)}" y="${geo.height - 4}" text-anchor="middle">${tick.label}</text>`,
            )
            .join("")}</g>
        </svg>`;

      // The dash length has to match this particular path, so it's measured
      // after insertion rather than guessed.
      const line = plot.querySelector<SVGPathElement>(".activity-line");
      if (line) {
        const length = line.getTotalLength();
        line.style.setProperty("--path-length", String(length));
        line.style.strokeDasharray = String(length);
      }

      rangeLabel.textContent = RANGE_LABELS[days];
    }

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const next = Number(button.dataset.days);
        if (!next || next === days) return;
        days = next;
        for (const other of buttons) other.classList.toggle("is-active", other === button);
        render();
      });
    }

    async function load() {
      try {
        totals = await fetchAppJson<YearlyTotals>("/data/yearly-totals.json");
        render();
      } catch (err) {
        console.error("Failed to load listening path:", err);
        plot.innerHTML = '<div class="no-data-message">Failed to load activity</div>';
      }
    }

    load();
    onPathsUpdated(["/data/yearly-totals.json"], () => load());

    // Geometry is pixel-based, so it has to be rebuilt when the box changes.
    let resizeFrame = 0;
    let lastWidth = 0;
    let lastHeight = 0;
    new ResizeObserver(() => {
      const width = plot.clientWidth;
      const height = plot.clientHeight;
      // Sub-pixel jitter from the panel transition would otherwise thrash this.
      if (Math.abs(width - lastWidth) < 2 && Math.abs(height - lastHeight) < 2) return;
      lastWidth = width;
      lastHeight = height;
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => render(false));
    }).observe(plot);
  });
</script>
