---
---

<div class="compare-container glass-card panel-container panel-fill">
  <div class="view-header shrink-0">
    <h2>Statistics</h2>
    <div class="view-header-row">
      <p class="subtitle">Welcome to my nerdy side...</p>
      <div class="chart-controls" id="yearsFilter">
        <button class="years-filter-btn" id="yearsFilterBtn" type="button">
          <span id="yearsFilterLabel">Years</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
        <div class="dropdown-popover years-filter-popover" id="yearsFilterPopover"></div>
      </div>
    </div>
  </div>

  <div class="chart-plot">
    <canvas id="yearlyCompareChart"></canvas>
  </div>
  <div class="stats-legend shrink-0" id="statsLegend"></div>
  <div class="year-story-card shrink-0">
    <div class="year-story-viewport" id="yearStoryViewport">
      <div class="year-story-track" id="yearStoryTrack"></div>
    </div>
    <div class="year-story-dots" id="yearStoryDots"></div>
  </div>
</div>

<style>
  .compare-container.panel-fill {
    /* Keep dropdown visible; chart still fills via flex + min-height. */
    overflow: visible;
    display: flex;
    flex-direction: column;
  }

  .compare-container :global(.view-header) {
    overflow: visible;
  }

  .view-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    overflow: visible;
  }

  .view-header-row .subtitle {
    flex: 1 1 auto;
    min-width: 0;
    max-width: calc(100% - 7.5rem);
    margin-top: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chart-controls {
    position: relative;
    flex: 0 0 auto;
    z-index: 4;
    width: max-content;
  }

  .years-filter-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 7px 12px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    font-family: var(--font-header);
    cursor: pointer;
    white-space: nowrap;
  }

  .years-filter-popover {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    max-height: 240px;
    overflow-x: hidden;
    overflow-y: auto;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 14px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
  }

  .chart-controls.open .years-filter-popover {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-popover {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: var(--transition-smooth);
    z-index: var(--z-dropdown);
  }

  .years-filter-popover {
    left: auto;
    right: 0;
  }

  .years-filter-popover :global(.checkbox-label) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    color: var(--year-color);
    opacity: 0.55;
  }

  .years-filter-popover :global(.checkbox-label.checked) {
    opacity: 1;
    background: rgba(255, 255, 255, 0.06);
  }

  .years-filter-popover :global(.checkbox-label input) {
    display: none;
  }

  .years-filter-popover :global(.led-indicator) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
  }

  .years-filter-popover :global(.checkbox-label.checked .led-indicator) {
    background: var(--year-color);
    border-color: #fff;
    box-shadow: 0 0 8px var(--year-led-glow);
  }

  /* Chart fills remaining space inside the Statistics panel — no nested card. */
  .chart-plot {
    position: relative;
    flex: 1 1 auto;
    min-height: 200px;
    width: 100%;
  }

  .chart-plot canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  .stats-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 12px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .stats-legend :global(i) {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 6px;
    vertical-align: -1px;
  }

  .year-story-card {
    min-height: 0;
    flex-shrink: 0;
    padding: 0;
  }

  .year-story-viewport {
    overflow: hidden;
    touch-action: pan-y;
  }

  .year-story-track {
    display: flex;
  }

  .year-story-track :global(.year-story-page) {
    flex: 0 0 100%;
    width: 100%;
    min-height: 0;
  }

  .year-story-track :global(p) {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }

  .year-story-track :global(.year-story-year-inline) {
    font-family: var(--font-header);
    font-size: 1.35em;
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .year-story-track :global(.clickable-entity) {
    cursor: pointer;
    font-weight: 700;
    color: #fff;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .year-story-track :global(.clickable-entity:hover) {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .year-story-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding-top: 8px;
  }

  .year-story-dots :global(button) {
    width: 6px;
    height: 6px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    cursor: pointer;
  }

  .year-story-dots :global(button.is-active) {
    background: var(--accent-green);
    width: 16px;
    border-radius: 99px;
  }

  @media (max-width: 767px) {
    .view-header-row .subtitle {
      max-width: calc(100% - 6.75rem);
    }
  }

  /* Top-lists sheet lives in StatsTopSheet.astro (shared BottomSheet). */
</style>

<script>
  import type { Chart as ChartType } from "chart.js";
  import {
    loadMetaCache,
    loadArtworkCache,
    loadColorsCache,
    getArtworkCacheSync,
    getArtworkUrl,
    getArtistArtworkUrl,
    getColorForUrl,
  } from "../utils/ui";
  import { getGlowStyle } from "../utils/theme";
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import { bindEntityClicks } from "../utils/events";
  import type { YearlyTotals } from "../types/music";
  import { getActiveTab } from "../utils/tabs";
  import { bindPagerSwipe } from "../utils/pagerSwipe";
  import { buildYearStory } from "../utils/yearBlurb";
  import { rawArtistNamesForCanonical } from "../utils/scrobbles";

  document.addEventListener("DOMContentLoaded", () => {
    let rawStats: Record<string, unknown> | null = null;
    let rawTotals: YearlyTotals | null = null;
    let metaDict: any = null;
    const albumToArtist = new Map<number, number>();

    let chart: ChartType | null = null;
    const selectedYears = new Set<string>();
    const yearsFilter = document.getElementById("yearsFilter") as HTMLDivElement;
    const yearsFilterBtn = document.getElementById("yearsFilterBtn") as HTMLButtonElement;
    const yearsFilterLabel = document.getElementById("yearsFilterLabel") as HTMLSpanElement;
    const yearsFilterPopover = document.getElementById("yearsFilterPopover") as HTMLDivElement;
    const statsLegend = document.getElementById("statsLegend") as HTMLDivElement;
    const storyViewport = document.getElementById("yearStoryViewport") as HTMLDivElement;
    const storyTrack = document.getElementById("yearStoryTrack") as HTMLDivElement;
    const storyDots = document.getElementById("yearStoryDots") as HTMLDivElement;

    const colors = ["#ff2d55", "#00f0ff", "#8b5cf6", "#22c55e", "#f97316", "#eab308"];
    let yearColorMap: { [year: string]: string } = {};
    let storyYears: string[] = [];
    let storyIndex = 0;

    const storyPager = bindPagerSwipe({
      gestureEl: storyViewport,
      trackEl: storyTrack,
      viewportEl: storyViewport,
      pageCount: 1,
      onSettled: (index) => {
        storyIndex = index;
        syncStoryDots();
      },
    });

    bindEntityClicks(storyTrack);

    const MONTH_LABELS = [
      "JAN",
      "FEB",
      "MAR",
      "APR",
      "MAY",
      "JUN",
      "JUL",
      "AUG",
      "SEP",
      "OCT",
      "NOV",
      "DEC",
    ];
    // Day-of-year indices (0-based, leap calendar) where each month begins.
    const MONTH_STARTS = [0, 31, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335];

    // Keep a daily label array so datasets stay day-aligned; ticks render months only.
    const xLabels = Array.from({ length: 366 }, (_, i) => String(i));

    async function loadData() {
      try {
        const [totals, stats, meta] = await Promise.all([
          fetchAppJson<YearlyTotals>("/data/yearly-totals.json"),
          fetchAppJson<Record<string, unknown>>("/data/yearly-stats.json"),
          loadMetaCache(),
          loadArtworkCache(),
          loadColorsCache(),
        ]);
        rawTotals = totals;
        rawStats = stats;
        metaDict = meta;
        albumToArtist.clear();
        if (meta?.tracks) {
          for (let i = 0; i < meta.tracks.length; i++) {
            const t = meta.tracks[i];
            if (t && t[2] && !albumToArtist.has(t[2])) {
              albumToArtist.set(t[2], t[1]);
            }
          }
        }

        initializeCheckboxes(rawTotals!);
        updateChart();
        renderYearStories();
      } catch (err) {
        console.error("Failed to load statistics data:", err);
      }
    }

    function hexToRgba(hex: string, alpha: number): string {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function buildDataset(year: string, totals: YearlyTotals): any {
      const ctx = (document.getElementById("yearlyCompareChart") as HTMLCanvasElement)?.getContext("2d");
      if (!ctx) return null;

      const color = yearColorMap[year] || "#888";
      const dailyCounts = totals[year] || [];
      let sum = 0;
      const chartData = dailyCounts.map((count) => {
        sum += count;
        return sum;
      });

      const gradient = ctx.createLinearGradient(0, 0, 0, 320);
      gradient.addColorStop(0, hexToRgba(color, 0.18));
      gradient.addColorStop(0.5, hexToRgba(color, 0.06));
      gradient.addColorStop(1, "rgba(0, 0, 0, 0)");

      return {
        label: year,
        data: chartData,
        borderColor: color,
        borderWidth: 2.5,
        backgroundColor: gradient,
        fill: true,
        tension: 0.35,
        pointRadius: 0,
        pointHoverRadius: 4,
        pointHitRadius: 15,
        pointHoverBackgroundColor: "#fff",
        pointHoverBorderColor: color,
        pointHoverBorderWidth: 2,
      };
    }

    // chart.js/auto registers everything it ships (~211 KB, half the page's JS)
    // on first paint. Register only what a filled line chart needs, on demand.
    let chartLibrary: Promise<typeof ChartType> | null = null;

    function loadChartLibrary(): Promise<typeof ChartType> {
      if (!chartLibrary) {
        chartLibrary = import("chart.js").then((m) => {
          m.Chart.register(
            m.LineController,
            m.LineElement,
            m.PointElement,
            m.LinearScale,
            m.CategoryScale,
            m.Filler,
            m.Tooltip,
          );
          return m.Chart;
        });
      }
      return chartLibrary;
    }

    async function ensureChart() {
      if (chart) return;
      const ChartCtor = await loadChartLibrary();
      if (chart) return;

      const ctx = (document.getElementById("yearlyCompareChart") as HTMLCanvasElement)?.getContext("2d");
      if (!ctx) return;

      chart = new ChartCtor(ctx, {
        type: "line",
        data: { labels: xLabels, datasets: [] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 400, easing: "easeInOutQuart" },
          layout: {
            padding: { top: 8, right: 8, bottom: 0, left: 0 },
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              mode: "nearest",
              intersect: true,
              backgroundColor: "rgba(10, 10, 15, 0.9)",
              titleColor: "#fff",
              bodyColor: "rgba(255,255,255,0.8)",
              borderColor: "rgba(255, 255, 255, 0.1)",
              borderWidth: 1,
              padding: 16,
              cornerRadius: 12,
              usePointStyle: true,
              boxWidth: 8,
              boxHeight: 8,
              boxPadding: 8,
              titleFont: { family: "Outfit", weight: "bold" as const, size: 18 },
              bodyFont: { family: "Inter", size: 15 },
              callbacks: {
                title(items) {
                  const index = items[0]?.dataIndex ?? 0;
                  const d = new Date(Date.UTC(2024, 0, 1 + index));
                  return d.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    timeZone: "UTC",
                  });
                },
                label: (context) => {
                  let label = context.dataset.label || "";
                  if (label) label += ": ";
                  if (context.parsed.y !== null) label += context.parsed.y.toLocaleString() + " plays";
                  return label;
                },
              },
            },
          },
          interaction: { mode: "nearest", intersect: true },
          scales: {
            x: {
              grid: { display: false },
              afterBuildTicks(axis) {
                axis.ticks = MONTH_STARTS.map((dayIndex) => ({
                  value: dayIndex,
                }));
              },
              ticks: {
                color: "rgba(255,255,255,0.38)",
                font: { family: "Inter", size: 10, weight: "600" as const },
                autoSkip: false,
                maxRotation: 0,
                padding: 6,
                callback(tickValue) {
                  const dayIndex = typeof tickValue === "string" ? Number(tickValue) : Number(tickValue);
                  const mi = MONTH_STARTS.indexOf(dayIndex);
                  return mi >= 0 ? MONTH_LABELS[mi] : "";
                },
              },
              border: { display: false },
            },
            y: {
              grid: { color: "rgba(255,255,255,0.03)" },
              ticks: {
                color: "rgba(255,255,255,0.32)",
                font: { family: "Inter", size: 10, weight: "500" as const },
                padding: 6,
                maxTicksLimit: 5,
              },
              border: { display: false },
            },
          },
        },
      });

      // Datasets selected while the library was still loading.
      updateChart();
    }

    function updateYearsLabel() {
      const years = Object.keys(yearColorMap);
      const n = selectedYears.size;
      if (n === 0) yearsFilterLabel.textContent = "Years";
      else if (n === years.length) yearsFilterLabel.textContent = "All years";
      else if (n === 1) yearsFilterLabel.textContent = Array.from(selectedYears)[0];
      else yearsFilterLabel.textContent = `${n} years`;
    }

    function updateStatsLegend() {
      if (!statsLegend) return;
      const years = Array.from(selectedYears).sort().reverse();
      statsLegend.innerHTML = years
        .map((year) => {
          const color = yearColorMap[year] || "#fff";
          return `<span><i style="background:${color}"></i>${year}</span>`;
        })
        .join("");
    }

    function syncStoryDots() {
      storyDots.querySelectorAll("button").forEach((btn, i) => {
        btn.classList.toggle("is-active", i === storyIndex);
      });
    }

    function accentStyle(url: string | null): string | undefined {
      const rgb = getColorForUrl(url);
      return rgb ? getGlowStyle(rgb, { blur: 10, alpha: 0.45 }) : undefined;
    }

    function storyAccents(year: string): { artist?: string; track?: string; album?: string } {
      const stats = rawStats?.[year] as
        | { tracks?: [number, number][]; albums?: [number, number][]; artists?: [number, number][] }
        | undefined;
      if (!stats || !metaDict) return {};
      const cache = getArtworkCacheSync() || {};
      const accents: { artist?: string; track?: string; album?: string } = {};

      const topArtist = stats.artists?.[0];
      if (topArtist) {
        const name = metaDict.canonicalArtists?.[topArtist[0]] || metaDict.artists?.[topArtist[0]];
        if (name) {
          accents.artist = accentStyle(
            getArtistArtworkUrl(name, cache, rawArtistNamesForCanonical(topArtist[0], metaDict)),
          );
        }
      }

      const topTrack = stats.tracks?.[0];
      if (topTrack && metaDict.tracks?.[topTrack[0]]) {
        const [name, artistId, albumId] = metaDict.tracks[topTrack[0]];
        const artistName = metaDict.artists?.[artistId] || "";
        const albumName = metaDict.albums?.[albumId] || "";
        accents.track = accentStyle(getArtworkUrl("track", name, artistName, albumName, cache));
      }

      const topAlbum = stats.albums?.[0];
      if (topAlbum && metaDict.albums?.[topAlbum[0]]) {
        const name = metaDict.albums[topAlbum[0]];
        const artistName = metaDict.artists?.[albumToArtist.get(topAlbum[0]) ?? -1] || "";
        accents.album = accentStyle(getArtworkUrl("album", name, artistName, name, cache));
      }

      return accents;
    }

    function renderYearStories() {
      storyYears = Array.from(selectedYears).sort().reverse();
      if (!rawStats || !metaDict || storyYears.length === 0) {
        storyTrack.innerHTML = "";
        storyDots.innerHTML = "";
        storyPager.setPageCount(1);
        return;
      }

      storyTrack.innerHTML = storyYears
        .map((year) => {
          const story = buildYearStory(
            year,
            rawStats![year] as { tracks?: [number, number][]; albums?: [number, number][]; artists?: [number, number][] },
            metaDict,
            albumToArtist,
            yearColorMap[year],
            storyAccents(year),
          );
          return `<div class="year-story-page">${story.html}</div>`;
        })
        .join("");

      storyDots.innerHTML = storyYears
        .map((_, i) => `<button type="button" data-story="${i}" aria-label="Year ${storyYears[i]}"></button>`)
        .join("");

      storyPager.setPageCount(storyYears.length);
      storyIndex = Math.min(storyIndex, storyYears.length - 1);
      storyPager.goTo(storyIndex, false);
      syncStoryDots();
    }

    function updateChart() {
      updateStatsLegend();
      if (!chart) return;

      for (let i = chart.data.datasets.length - 1; i >= 0; i--) {
        if (!selectedYears.has(chart.data.datasets[i].label as string)) {
          chart.data.datasets.splice(i, 1);
        }
      }

      const currentLabels = new Set(chart.data.datasets.map((d: any) => d.label));
      const sortedYears = Array.from(selectedYears).sort().reverse();

      for (const year of sortedYears) {
        if (!currentLabels.has(year)) {
          const ds = buildDataset(year, rawTotals!);
          if (ds) chart.data.datasets.push(ds);
        }
      }

      chart.update();
    }

    function initializeCheckboxes(totals: YearlyTotals) {
      const years = Object.keys(totals)
        .filter((y) => {
          const parsed = parseInt(y, 10);
          return !isNaN(parsed) && parsed >= 2023;
        })
        .sort()
        .reverse();
      years.forEach((year, idx) => {
        yearColorMap[year] = colors[idx % colors.length];
      });

      yearsFilterPopover.innerHTML = years
        .map((year) => {
          const color = yearColorMap[year];
          const glow = hexToRgba(color, 0.4);
          const ledGlow = hexToRgba(color, 0.85);
          selectedYears.add(year);
          return `
          <label class="checkbox-label checked" 
                 style="--year-color: ${color}; --year-color-glow: ${glow}; --year-led-glow: ${ledGlow};" 
                 data-year="${year}">
            <input type="checkbox" value="${year}" checked />
            <span class="led-indicator"></span>
            <span class="year-text">${year}</span>
          </label>
        `;
        })
        .join("");
      updateYearsLabel();
      updateStatsLegend();
    }

    yearsFilterPopover.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      if (target.tagName !== "INPUT") return;
      const year = target.value;
      if (target.checked) {
        selectedYears.add(year);
      } else if (selectedYears.size <= 1) {
        target.checked = true;
        return;
      } else {
        selectedYears.delete(year);
      }
      target.closest("label")?.classList.toggle("checked", target.checked);
      updateYearsLabel();
      updateChart();
      renderYearStories();
    });

    yearsFilterBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      yearsFilter.classList.toggle("open");
    });

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest("#yearsFilter")) yearsFilter.classList.remove("open");
    });

    storyDots.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("button");
      if (!btn) return;
      const idx = Number(btn.getAttribute("data-story"));
      if (!Number.isNaN(idx)) storyPager.goTo(idx, true);
    });

    window.addEventListener("tab-navigated", (e: Event) => {
      if ((e as CustomEvent<{ tab: string }>).detail.tab === "statistics") {
        setTimeout(() => {
          if (chart) chart.resize();
          storyPager.measure();
          storyPager.goTo(storyIndex, false);
        }, 50);
      }
    });

    // Deferred until the tab is actually shown, so a visitor who never opens
    // Statistics never pays for chart.js at all.
    if (getActiveTab() === "statistics") void ensureChart();
    window.addEventListener("tab-navigated", (e: Event) => {
      if ((e as CustomEvent<{ tab: string }>).detail.tab === "statistics") void ensureChart();
    });

    loadData();
    onPathsUpdated(
      ["/data/yearly-totals.json", "/data/yearly-stats.json", "/data/colors.json", "/data/artwork.json"],
      () => loadData(),
    );
  });
</script>
