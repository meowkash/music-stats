---
---

<div class="compare-container glass-card panel-container panel-fill">
  <div class="view-header shrink-0">
    <h2>Statistics</h2>
    <p class="subtitle">Welcome to my nerdy side...</p>
  </div>

  <!-- Chart Controls -->
  <div class="chart-controls shrink-0">
    <div class="control-group">
      <span class="control-label">Select Years</span>
      <div class="year-checkbox-group" id="yearCheckboxes" data-scroll-x>
        <!-- Injected by client JS -->
      </div>
    </div>
    <button
      class="years-info-btn"
      id="openStatsSheetBtn"
      type="button"
      aria-label="View top lists"
      title="Top lists"
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    </button>
  </div>

  <!-- Chart Display Canvas -->
  <div class="chart-wrapper panel-fill">
    <div class="chart-canvas-container">
      <canvas id="yearlyCompareChart"></canvas>
    </div>
  </div>
</div>

<style>
  .chart-controls {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 16px;
    padding-bottom: 14px;
    border-radius: 6px;
  }

  .years-info-btn {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: var(--transition-smooth);
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .years-info-btn:hover {
      color: var(--text-primary);
      background: rgba(255, 255, 255, 0.06);
    }

    .years-info-btn:active {
      transform: scale(0.94);
    }
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .control-label {
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .year-checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    /* Keep year chips clear of the info button in the corner. */
    padding-right: 36px;
  }

  .year-checkbox-group :global(.checkbox-label) {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition-smooth);
    user-select: none;
    color: var(--year-color);
    opacity: 0.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .year-checkbox-group :global(.checkbox-label:hover) {
      background: rgba(255, 255, 255, 0.04);
      opacity: 0.85;
      border-color: rgba(255, 255, 255, 0.15);
    }
  }

  .year-checkbox-group :global(.checkbox-label.is-pressed) {
    background: rgba(255, 255, 255, 0.04);
    opacity: 0.85;
    border-color: rgba(255, 255, 255, 0.15);
  }

  .year-checkbox-group :global(.checkbox-label input) {
    display: none;
  }

  .year-checkbox-group :global(.led-indicator) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: var(--transition-smooth);
    flex-shrink: 0;
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.6);
  }

  .year-checkbox-group :global(.checkbox-label.checked) {
    opacity: 1;
    border-color: var(--year-color);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 12px var(--year-color-glow), inset 0 0 4px var(--year-color-glow);
  }

  .year-checkbox-group :global(.checkbox-label.checked .led-indicator) {
    background: var(--year-color);
    border-color: #fff;
    box-shadow: 0 0 8px var(--year-led-glow), 0 0 16px var(--year-color-glow), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .chart-wrapper {
    position: relative;
    width: 100%;
    min-height: 0;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 16px;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.02);
  }

  .chart-canvas-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  canvas {
    width: 100% !important;
    height: 100% !important;
  }

  /* Top-lists sheet lives in StatsTopSheet.astro (shared BottomSheet). */
</style>

<script>
  import Chart from "chart.js/auto";
  import {
    generateScrobbleRowHTML,
    applyCountGlows,
    getArtworkUrl,
    getArtistArtworkUrl,
    loadArtworkCache,
    loadMetaCache,
    initArtworkImages,
    getArtworkCacheSync,
  } from "../utils/ui";
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import { bindEntityClicks } from "../utils/events";
  import type { YearlyTotals } from "../types/music";
  import { rawArtistNamesForCanonical } from "../utils/scrobbles";
  import { bindHorizontalSwipe } from "../utils/horizontalSwipe";
  import { createSheet } from "../utils/sheet";

  document.addEventListener("DOMContentLoaded", () => {
    let rawStats: Record<string, unknown> | null = null;
    let activeYear: string | null = null;
    let activeCategory: "tracks" | "albums" | "artists" = "tracks";
    let rawTotals: YearlyTotals | null = null;
    let metaDict: any = null;
    let lastSwipeTarget: "year" | "category" = "year";

    let chart: Chart | null = null;
    const selectedYears = new Set<string>();
    const checkboxGroup = document.getElementById("yearCheckboxes") as HTMLDivElement;

    const sheetPanel = document.getElementById("statsSheetPanel") as HTMLDivElement;
    const statsList = document.getElementById("activeStatsList") as HTMLDivElement;
    const openBtn = document.getElementById("openStatsSheetBtn") as HTMLButtonElement;
    const closeBtn = document.getElementById("statsSheetCloseBtn") as HTMLButtonElement;

    const colors = ["#ff2d55", "#00f0ff", "#8b5cf6", "#22c55e", "#f97316", "#eab308"];
    let yearColorMap: { [year: string]: string } = {};

    const sheet = createSheet({
      id: "statsSheet",
      scrollContainer: statsList,
      bodyClass: "stats-sheet-open",
      onOpen: () => renderYearlyStats(),
    });

    openBtn?.addEventListener("click", () => sheet?.open());
    closeBtn?.addEventListener("click", () => sheet?.close());

    const generateLabels = (): string[] => {
      const labels = [];
      const d = new Date(2024, 0, 1);
      for (let i = 0; i < 366; i++) {
        labels.push(d.toLocaleDateString("en-US", { month: "short", day: "numeric" }));
        d.setDate(d.getDate() + 1);
      }
      return labels;
    };
    const xLabels = generateLabels();

    async function loadData() {
      try {
        const [totals, stats, meta] = await Promise.all([
          fetchAppJson<YearlyTotals>("/data/yearly-totals.json"),
          fetchAppJson<Record<string, unknown>>("/data/yearly-stats.json"),
          loadMetaCache(),
          loadArtworkCache(),
        ]);
        rawTotals = totals;
        rawStats = stats;
        metaDict = meta;

        initializeCheckboxes(rawTotals!);
        updateChart();
        if (sheet?.isOpen()) renderYearlyStats();
      } catch (err) {
        console.error("Failed to load statistics data:", err);
      }
    }

    function hexToRgba(hex: string, alpha: number): string {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function buildDataset(year: string, totals: YearlyTotals): any {
      const ctx = (document.getElementById("yearlyCompareChart") as HTMLCanvasElement)?.getContext("2d");
      if (!ctx) return null;

      const color = yearColorMap[year] || "#888";
      const dailyCounts = totals[year] || [];
      let sum = 0;
      const chartData = dailyCounts.map((count) => {
        sum += count;
        return sum;
      });

      const gradient = ctx.createLinearGradient(0, 0, 0, 320);
      gradient.addColorStop(0, hexToRgba(color, 0.18));
      gradient.addColorStop(0.5, hexToRgba(color, 0.06));
      gradient.addColorStop(1, "rgba(0, 0, 0, 0)");

      return {
        label: year,
        data: chartData,
        borderColor: color,
        borderWidth: 2.5,
        backgroundColor: gradient,
        fill: true,
        tension: 0.35,
        pointRadius: 0,
        pointHoverRadius: 4,
        pointHitRadius: 15,
        pointHoverBackgroundColor: "#fff",
        pointHoverBorderColor: color,
        pointHoverBorderWidth: 2,
      };
    }

    function ensureChart() {
      if (chart) return;
      const ctx = (document.getElementById("yearlyCompareChart") as HTMLCanvasElement)?.getContext("2d");
      if (!ctx) return;

      chart = new Chart(ctx, {
        type: "line",
        data: { labels: xLabels, datasets: [] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 400, easing: "easeInOutQuart" },
          plugins: {
            legend: { display: false },
            tooltip: {
              mode: "nearest",
              intersect: true,
              backgroundColor: "rgba(10, 10, 15, 0.9)",
              titleColor: "#fff",
              bodyColor: "rgba(255,255,255,0.8)",
              borderColor: "rgba(255, 255, 255, 0.1)",
              borderWidth: 1,
              padding: 16,
              cornerRadius: 12,
              usePointStyle: true,
              boxWidth: 8,
              boxHeight: 8,
              boxPadding: 8,
              titleFont: { family: "Outfit", weight: "bold" as const, size: 18 },
              bodyFont: { family: "Inter", size: 15 },
              callbacks: {
                label: (context) => {
                  let label = context.dataset.label || "";
                  if (label) label += ": ";
                  if (context.parsed.y !== null) label += context.parsed.y.toLocaleString() + " plays";
                  return label;
                },
              },
            },
          },
          interaction: { mode: "nearest", intersect: true },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: "rgba(255,255,255,0.3)", font: { family: "Inter", size: 10 }, maxTicksLimit: 12 },
              border: { display: false },
            },
            y: {
              grid: { color: "rgba(255,255,255,0.03)" },
              ticks: { color: "rgba(255,255,255,0.3)", font: { family: "Inter", size: 10 } },
              border: { display: false },
            },
          },
        },
      });
    }

    function updateDropdownsUI() {
      const yearPopover = document.getElementById("yearDropdownPopover");
      if (yearPopover) {
        const sortedSelectedYears = Array.from(selectedYears).sort().reverse();
        yearPopover.innerHTML = sortedSelectedYears
          .map(
            (year) => `
          <div class="dropdown-item ${year === activeYear ? "active" : ""}" data-val="${year}">${year}</div>
        `,
          )
          .join("");
      }

      document.getElementById("yearDropdownText")!.innerText = activeYear || "Select";

      const catText =
        activeCategory === "tracks" ? "Songs" : activeCategory === "albums" ? "Albums" : "Artists";
      document.getElementById("categoryDropdownText")!.innerText = catText;

      document.querySelectorAll("#categoryDropdownPopover .dropdown-item").forEach((item) => {
        item.classList.toggle("active", item.getAttribute("data-val") === activeCategory);
      });

      let catColor = "#ffffff";
      if (activeCategory === "tracks") catColor = "var(--accent-cat-songs)";
      else if (activeCategory === "albums") catColor = "var(--accent-cat-albums)";
      else if (activeCategory === "artists") catColor = "var(--accent-cat-artists)";

      const catBtn = document.getElementById("categoryDropdownBtn");
      if (catBtn) {
        catBtn.style.color = catColor;
        catBtn.style.borderColor = `color-mix(in srgb, ${catColor} 40%, transparent)`;
        catBtn.style.background = `color-mix(in srgb, ${catColor} 10%, transparent)`;
      }

      document.documentElement.style.setProperty(
        "--cat-active-color",
        `color-mix(in srgb, ${catColor} 20%, transparent)`,
      );

      const color = activeYear ? yearColorMap[activeYear] : "#ffffff";
      document.documentElement.style.setProperty("--active-color", color + "40");

      const yearBtn = document.getElementById("yearDropdownBtn");
      if (yearBtn && activeYear) {
        yearBtn.style.color = color;
        yearBtn.style.borderColor = color + "40";
        yearBtn.style.background = color + "10";
      }
    }

    function renderYearlyStats() {
      const container = document.getElementById("activeStatsList");
      if (!container || !rawStats || !metaDict || selectedYears.size === 0) {
        if (container) container.innerHTML = "";
        return;
      }

      const sortedSelectedYears = Array.from(selectedYears).sort().reverse();
      if (!activeYear || !selectedYears.has(activeYear)) {
        activeYear = sortedSelectedYears[0];
      }

      updateDropdownsUI();

      const stats = rawStats[activeYear] as Record<string, [number, number][]> | undefined;
      if (!stats) {
        container.innerHTML = "";
        return;
      }

      const items = stats[activeCategory] || [];
      const cache = getArtworkCacheSync() || {};

      container.innerHTML = items
        .map((item: [number, number], idx: number) => {
          const id = item[0];
          const count = item[1];
          let name = "Unknown";
          let subtitle = "";
          let imgUrl = null;
          let rowType = "artist";
          let rowArtistCatalog: "artists" | "canonicalArtists" | undefined;

          if (activeCategory === "tracks" && metaDict.tracks[id]) {
            name = metaDict.tracks[id][0];
            const artistId = metaDict.tracks[id][1];
            const albumId = metaDict.tracks[id][2];
            const artistName = metaDict.artists[artistId] || "Unknown Artist";
            const albumName = metaDict.albums[albumId] || "Unknown Album";
            subtitle = artistName;
            rowType = "track";
            imgUrl = getArtworkUrl("track", name, artistName, albumName, cache);
          } else if (activeCategory === "albums" && metaDict.albums[id]) {
            name = metaDict.albums[id];
            const trackEntry = metaDict.tracks.find((t: any) => t && t[2] == id);
            if (trackEntry) {
              const artistName = metaDict.artists[trackEntry[1]];
              subtitle = artistName;
              imgUrl = getArtworkUrl("album", name, artistName, name, cache);
            } else {
              subtitle = "Album";
              imgUrl = getArtworkUrl("album", name, "", name, cache);
            }
            rowType = "album";
          } else if (activeCategory === "artists" && metaDict.canonicalArtists?.[id]) {
            name = metaDict.canonicalArtists[id];
            subtitle = "Artist";
            rowType = "artist";
            rowArtistCatalog = "canonicalArtists";
            imgUrl = getArtistArtworkUrl(name, cache, rawArtistNamesForCanonical(id, metaDict));
          }

          return generateScrobbleRowHTML(
            {
              type: rowType,
              id: id.toString(),
              rank: idx + 1,
              name,
              subtitle,
              imgUrl: imgUrl || null,
              count,
              artistCatalog: rowArtistCatalog,
            },
            true,
          );
        })
        .join("");

      initArtworkImages(container);
      applyCountGlows(container);
    }

    function updateChart() {
      if (!chart) return;

      for (let i = chart.data.datasets.length - 1; i >= 0; i--) {
        if (!selectedYears.has(chart.data.datasets[i].label as string)) {
          chart.data.datasets.splice(i, 1);
        }
      }

      const currentLabels = new Set(chart.data.datasets.map((d: any) => d.label));
      const sortedYears = Array.from(selectedYears).sort().reverse();

      for (const year of sortedYears) {
        if (!currentLabels.has(year)) {
          const ds = buildDataset(year, rawTotals!);
          if (ds) chart.data.datasets.push(ds);
        }
      }

      chart.update();
    }

    function initializeCheckboxes(totals: YearlyTotals) {
      const years = Object.keys(totals)
        .filter((y) => {
          const parsed = parseInt(y, 10);
          return !isNaN(parsed) && parsed >= 2023;
        })
        .sort()
        .reverse();
      years.forEach((year, idx) => {
        yearColorMap[year] = colors[idx % colors.length];
      });

      checkboxGroup.innerHTML = years
        .map((year) => {
          const color = yearColorMap[year];
          const glow = hexToRgba(color, 0.4);
          const ledGlow = hexToRgba(color, 0.85);
          selectedYears.add(year);
          return `
          <label class="checkbox-label checked" 
                 style="--year-color: ${color}; --year-color-glow: ${glow}; --year-led-glow: ${ledGlow};" 
                 data-year="${year}">
            <input type="checkbox" value="${year}" checked />
            <span class="led-indicator"></span>
            <span class="year-text">${year}</span>
          </label>
        `;
        })
        .join("");
    }

    document.getElementById("yearCheckboxes")?.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      if (target.tagName !== "INPUT") return;
      const year = target.value;
      if (target.checked) selectedYears.add(year);
      else selectedYears.delete(year);
      target.closest("label")?.classList.toggle("checked", target.checked);
      updateChart();
      renderYearlyStats();
    });

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      if (!target.closest(".custom-dropdown")) {
        document.querySelectorAll(".custom-dropdown").forEach((el) => el.classList.remove("open"));
      }

      const trigger = target.closest(".dropdown-trigger");
      if (trigger) {
        const container = trigger.closest(".custom-dropdown");
        const wasOpen = container?.classList.contains("open");
        document.querySelectorAll(".custom-dropdown").forEach((el) => el.classList.remove("open"));
        if (!wasOpen) container?.classList.add("open");
        return;
      }

      const dropItem = target.closest(".dropdown-item");
      if (dropItem) {
        const val = dropItem.getAttribute("data-val");
        const container = dropItem.closest("#yearDropdownContainer");
        if (container && val) activeYear = val;
        else if (val) activeCategory = val as typeof activeCategory;
        document.querySelectorAll(".custom-dropdown").forEach((el) => el.classList.remove("open"));
        renderYearlyStats();
      }
    });

    bindHorizontalSwipe({
      element: sheetPanel,
      onSwipeLeft: () => {
        const sortedSelectedYears = Array.from(selectedYears).sort().reverse();
        if (lastSwipeTarget === "category") {
          const cats = ["tracks", "albums", "artists"] as const;
          let idx = cats.indexOf(activeCategory);
          idx = Math.min(idx + 1, 2);
          activeCategory = cats[idx];
        } else if (activeYear) {
          let idx = sortedSelectedYears.indexOf(activeYear);
          idx = Math.min(idx + 1, sortedSelectedYears.length - 1);
          if (activeYear !== sortedSelectedYears[idx]) activeYear = sortedSelectedYears[idx];
        }
        renderYearlyStats();
      },
      onSwipeRight: () => {
        const sortedSelectedYears = Array.from(selectedYears).sort().reverse();
        if (lastSwipeTarget === "category") {
          const cats = ["tracks", "albums", "artists"] as const;
          let idx = cats.indexOf(activeCategory);
          idx = Math.max(idx - 1, 0);
          activeCategory = cats[idx];
        } else if (activeYear) {
          let idx = sortedSelectedYears.indexOf(activeYear);
          idx = Math.max(idx - 1, 0);
          if (activeYear !== sortedSelectedYears[idx]) activeYear = sortedSelectedYears[idx];
        }
        renderYearlyStats();
      },
    });

    // Whichever control the gesture starts over is the one it pages — tracked
    // for touch and for trackpad pans alike.
    const trackSwipeTarget = (e: Event) => {
      const target = e.target as HTMLElement;
      lastSwipeTarget = target.closest("#categoryDropdownContainer") ? "category" : "year";
    };
    sheetPanel.addEventListener("touchstart", trackSwipeTarget, { passive: true });
    // Capture so the target is recorded before the pan handler reads it.
    sheetPanel.addEventListener("wheel", trackSwipeTarget, { passive: true, capture: true });

    if (statsList) bindEntityClicks(statsList);

    window.addEventListener("tab-navigated", (e: Event) => {
      if ((e as CustomEvent<{ tab: string }>).detail.tab === "statistics") {
        setTimeout(() => {
          if (chart) chart.resize();
        }, 50);
      }
    });

    ensureChart();
    loadData();
    onPathsUpdated(["/data/yearly-totals.json", "/data/yearly-stats.json"], () => loadData());
  });
</script>
