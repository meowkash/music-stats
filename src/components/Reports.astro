---
---

<div class="glass-card reports-card" id="reportsCard">
  <!-- Chart + summary only; trends tiles were dropped so this fits phones. -->
  <div class="reports-header">
    <h4>Reports</h4>
    <div class="reports-range" role="group" aria-label="Range">
      <div id="reportsRangeHighlight" class="sliding-highlight reports-range-highlight"></div>
      <button class="range-btn is-active" data-range="week" type="button">Last week</button>
      <button class="range-btn" data-range="month" type="button">Last month</button>
      <button class="range-btn" data-range="year" type="button">Last year</button>
    </div>
  </div>

  <div class="reports-period">
    <button class="reports-arrow" id="reportsPrev" type="button" aria-label="Previous period">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <p class="reports-period-label" id="reportsPeriodLabel">—</p>
    <button class="reports-arrow" id="reportsNext" type="button" aria-label="Next period">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>

  <div class="reports-hero">
    <h2 class="reports-total"><span id="reportsTotal">—</span> Scrobbles</h2>
    <p class="reports-vs" id="reportsVs"></p>
  </div>

  <div class="reports-plot">
    <div class="reports-y" id="reportsYAxis"></div>
    <canvas id="reportsChart" aria-hidden="true"></canvas>
  </div>
  <div class="reports-x" id="reportsXAxis"></div>

  <div class="reports-legend" id="reportsLegend"></div>
  <p class="reports-rank" id="reportsRank"></p>
</div>

<style>
  .reports-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px 12px;
    min-height: 0;
    background: rgba(255, 255, 255, 0.015);
  }

  .reports-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-shrink: 0;
  }

  .reports-header h4 {
    font-family: var(--font-header);
    font-size: 17px;
    font-weight: 700;
    color: #fff;
  }

  .reports-range {
    position: relative;
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.07);
    flex-shrink: 0;
  }

  .reports-range-highlight {
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .reports-range .range-btn {
    position: relative;
    z-index: 1;
    padding: 6px 12px;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-body);
    cursor: pointer;
    white-space: nowrap;
  }

  .reports-range .range-btn.is-active {
    color: #fff;
  }

  .reports-period {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .reports-period-label {
    min-width: 11em;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .reports-arrow {
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
  }

  .reports-arrow:disabled {
    opacity: 0.28;
    pointer-events: none;
  }

  .reports-arrow svg {
    width: 16px;
    height: 16px;
  }

  .reports-hero {
    flex-shrink: 0;
  }

  .reports-total {
    font-family: var(--font-header);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .reports-vs {
    margin-top: 6px;
    font-size: 17px;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  .reports-vs :global(.delta-up) {
    color: var(--accent-green);
    font-weight: 700;
  }

  .reports-vs :global(.delta-down) {
    color: #ff4d62;
    font-weight: 700;
  }

  .reports-plot {
    position: relative;
    flex: 1 1 auto;
    min-height: 220px;
  }

  .reports-plot canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .reports-y {
    position: absolute;
    inset: 0 0 0 0;
    pointer-events: none;
  }

  .reports-y :global(.reports-y-tick) {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.32);
    font-weight: 500;
    width: 40px;
    text-align: right;
    padding-right: 6px;
    box-sizing: border-box;
  }

  .reports-x {
    display: flex;
    padding-left: 44px;
    padding-right: 8px;
    flex-shrink: 0;
  }

  .reports-x :global(span) {
    flex: 1;
    text-align: center;
    font-size: 10px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.38);
    letter-spacing: 0.02em;
  }

  .reports-legend {
    display: flex;
    gap: 14px;
    font-size: 12px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .reports-legend :global(i) {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 6px;
    vertical-align: -1px;
  }

  .reports-rank {
    font-size: 12px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 10px 12px;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .reports-card {
      padding: 12px 12px 10px;
      border-radius: 16px;
    }

    .reports-header {
      flex-direction: column;
      align-items: stretch;
    }

    .reports-range {
      align-self: stretch;
      justify-content: space-between;
    }

    .reports-range .range-btn {
      flex: 1;
    }

    .reports-total {
      font-size: 24px;
    }
  }
</style>

<script>
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import type { YearlyTotals } from "../types/music";
  import { buildReport, rangeNoun, type ReportRange } from "../utils/reports";
  import { createReportsChart } from "../utils/reportsChart";
  import { createSlidingHighlight } from "../utils/slidingHighlight";
  import { bindHorizontalSwipe } from "../utils/horizontalSwipe";

  const CURRENT: [number, number, number, number] = [1, 0.3, 0.38, 1];
  const PREVIOUS: [number, number, number, number] = [0.38, 0.09, 0.14, 1];

  document.addEventListener("DOMContentLoaded", () => {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".reports-range .range-btn"),
    );
    const prevBtn = document.getElementById("reportsPrev") as HTMLButtonElement;
    const nextBtn = document.getElementById("reportsNext") as HTMLButtonElement;
    const canvas = document.getElementById("reportsChart") as HTMLCanvasElement;
    const yAxis = document.getElementById("reportsYAxis") as HTMLElement;
    const xAxis = document.getElementById("reportsXAxis") as HTMLElement;
    const chart = createReportsChart(canvas, yAxis);

    let totals: YearlyTotals | null = null;
    let range: ReportRange = "week";
    let offset = 1;

    const rangeHighlight = createSlidingHighlight({
      highlightEl: document.getElementById("reportsRangeHighlight") as HTMLDivElement,
      buttons,
    });
    const initial = buttons.find((b) => b.classList.contains("is-active"));
    if (initial) rangeHighlight.sync(initial, false);
    rangeHighlight.observe();

    function deltaHTML(current: number, previous: number): string {
      if (previous <= 0 && current <= 0) return "";
      if (previous <= 0) return `<span class="delta-up">↑ new</span>`;
      const pct = Math.round(((current - previous) / previous) * 100);
      if (pct === 0) return `<span>→ 0%</span>`;
      return pct > 0
        ? `<span class="delta-up">↑ ${pct}%</span>`
        : `<span class="delta-down">↓ ${Math.abs(pct)}%</span>`;
    }

    function render(animate = true) {
      if (!totals) return;
      const view = buildReport(totals, [], range, offset);
      const totalEl = document.getElementById("reportsTotal");
      const vsEl = document.getElementById("reportsVs");
      const periodEl = document.getElementById("reportsPeriodLabel");
      const legendEl = document.getElementById("reportsLegend");
      const rankEl = document.getElementById("reportsRank");

      if (totalEl) totalEl.textContent = view.currentTotal.toLocaleString();
      if (periodEl) periodEl.textContent = view.rangeLabel;
      if (vsEl) {
        vsEl.innerHTML = `vs. ${view.previousTotal.toLocaleString()} (${view.compareLabel}) ${deltaHTML(view.currentTotal, view.previousTotal)}`;
      }
      if (legendEl) {
        legendEl.innerHTML = `<span><i style="background:rgb(255,77,97)"></i>${view.thisLabel}</span><span><i style="background:rgb(97,23,36)"></i>${view.lastLabel}</span>`;
      }
      if (rankEl) {
        rankEl.textContent = `This ${range} ranks above ${view.percentile}% of my ${rangeNoun(range)}`;
      }

      prevBtn.disabled = !view.canPrev;
      nextBtn.disabled = !view.canNext;

      const sparse = view.buckets.length > 16;
      xAxis.innerHTML = view.buckets
        .map((b, i) => {
          if (!sparse) return `<span>${b.label}</span>`;
          const show = i === 0 || i === view.buckets.length - 1 || i % Math.ceil(view.buckets.length / 6) === 0;
          return `<span>${show ? b.label : ""}</span>`;
        })
        .join("");

      chart.setData(
        {
          labels: view.buckets.map((b) => b.label),
          current: view.buckets.map((b) => b.current),
          previous: view.buckets.map((b) => b.previous),
          currentColor: CURRENT,
          previousColor: PREVIOUS,
        },
        animate,
      );
    }

    function selectRange(button: HTMLButtonElement, animate = true) {
      const next = button.dataset.range as ReportRange;
      if (!next || next === range) return;
      range = next;
      offset = 1;
      for (const other of buttons) other.classList.toggle("is-active", other === button);
      rangeHighlight.sync(button, animate);
      render();
    }

    for (const button of buttons) {
      button.addEventListener("click", () => selectRange(button));
    }

    prevBtn.addEventListener("click", () => {
      offset += 1;
      render();
    });
    nextBtn.addEventListener("click", () => {
      if (offset <= 0) return;
      offset -= 1;
      render();
    });

    bindHorizontalSwipe({
      element: document.querySelector(".reports-range") as HTMLElement,
      onSwipeLeft: () => {
        const i = buttons.findIndex((b) => b.classList.contains("is-active"));
        if (i >= 0 && i < buttons.length - 1) selectRange(buttons[i + 1]);
      },
      onSwipeRight: () => {
        const i = buttons.findIndex((b) => b.classList.contains("is-active"));
        if (i > 0) selectRange(buttons[i - 1]);
      },
    });

    async function load() {
      try {
        totals = await fetchAppJson<YearlyTotals>("/data/yearly-totals.json");
        render(false);
      } catch (err) {
        console.error("Failed to load reports:", err);
      }
    }

    load();
    onPathsUpdated(["/data/yearly-totals.json"], () => load());

    let resizeFrame = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => chart.resize());
    }).observe(canvas);
  });
</script>
