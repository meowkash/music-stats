---
import { getBootSnapshot } from "../utils/bootSnapshot";
import { reportLegendHTML, reportRankText, reportVsHTML, reportXAxisHTML } from "../utils/reports";
const { report } = getBootSnapshot();
---

<div class="glass-card reports-card" id="reportsCard">
  <!-- Chart + summary only; trends tiles were dropped so this fits phones. -->
  <div class="reports-header">
    <div class="reports-range glass-segmented" role="group" aria-label="Range">
      <div id="reportsRangeHighlight" class="sliding-highlight reports-range-highlight"></div>
      <button class="range-btn is-active" data-range="week" type="button">Last week</button>
      <button class="range-btn" data-range="month" type="button">Last month</button>
      <button class="range-btn" data-range="year" type="button">Last year</button>
    </div>
  </div>

  <div class="reports-period">
    <button class="reports-arrow" id="reportsPrev" type="button" aria-label="Previous period">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <p class="reports-period-label" id="reportsPeriodLabel">{report.rangeLabel}</p>
    <button class="reports-arrow" id="reportsNext" type="button" aria-label="Next period">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>

  <div class="reports-hero">
    <h2 class="reports-total"><span id="reportsTotal">{report.currentTotal.toLocaleString()}</span> Plays</h2>
    <p class="reports-vs" id="reportsVs" set:html={reportVsHTML(report)}></p>
  </div>

  <div class="reports-plot">
    <div class="reports-y" id="reportsYAxis"></div>
    <canvas id="reportsChart" aria-hidden="true"></canvas>
  </div>
  <div class="reports-x" id="reportsXAxis" set:html={reportXAxisHTML(report)}></div>

  <div class="reports-legend" id="reportsLegend" set:html={reportLegendHTML(report)}></div>
  <p class="reports-rank" id="reportsRank">{reportRankText(report)}</p>
</div>

<style>
  .reports-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px 12px;
    min-height: 0;
    background: rgba(255, 255, 255, 0.015);
  }

  .reports-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-shrink: 0;
  }

  /* Track, pill and labels: .glass-segmented in Layout.astro. */
  .reports-range {
    flex-shrink: 0;
  }


  .reports-range .range-btn {
    position: relative;
    z-index: 1;
    padding: 6px 12px;
    border: none;
    border-radius: 999px;
    background: none;
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-body);
    cursor: pointer;
    white-space: nowrap;
  }



  .reports-period {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .reports-period-label {
    min-width: 11em;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .reports-arrow {
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
  }

  .reports-arrow:disabled {
    opacity: 0.28;
    pointer-events: none;
  }

  .reports-arrow svg {
    width: 16px;
    height: 16px;
  }

  .reports-hero {
    flex-shrink: 0;
  }

  .reports-total {
    font-family: var(--font-numeric);
    font-size: 24px;
    font-weight: var(--font-numeric-weight);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .reports-vs {
    margin-top: 6px;
    font-size: 17px;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  .reports-vs :global(.delta-up) {
    color: var(--accent-green);
    font-weight: 700;
  }

  .reports-vs :global(.delta-down) {
    color: #ff4d62;
    font-weight: 700;
  }

  /* Plot absorbs whatever height the card has left; the floor scales with
     the viewport so short phones shrink the chart instead of scrolling. */
  .reports-plot {
    position: relative;
    flex: 1 1 0;
    min-height: clamp(96px, 16dvh, 220px);
  }

  .reports-plot canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .reports-y {
    position: absolute;
    inset: 0 0 0 0;
    pointer-events: none;
  }

  .reports-y :global(.reports-y-tick) {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.32);
    font-weight: 500;
    width: 40px;
    text-align: right;
    padding-right: 6px;
    box-sizing: border-box;
  }

  .reports-x {
    display: flex;
    padding-left: 44px;
    padding-right: 8px;
    flex-shrink: 0;
  }

  .reports-x :global(span) {
    flex: 1;
    text-align: center;
    font-size: 10px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.38);
    letter-spacing: 0.02em;
  }

  .reports-legend {
    display: flex;
    gap: 14px;
    font-size: 12px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .reports-legend :global(i) {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 6px;
    vertical-align: -1px;
  }

  .reports-rank {
    font-size: 12px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .reports-card {
      padding: 12px 12px 10px;
    }

    .reports-header {
      flex-direction: column;
      align-items: stretch;
    }

    .reports-range {
      align-self: stretch;
      justify-content: space-between;
    }

    .reports-range .range-btn {
      flex: 1;
    }

    .reports-total {
      font-size: 20px;
    }
  }
</style>

<script>
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import type { YearlyTotals } from "../types/music";
  import { buildReport, reportLegendHTML, reportRankText, reportVsHTML, reportXAxisHTML, type ReportRange } from "../utils/reports";
  import { createReportsChart } from "../utils/reportsChart";
  import { createSlidingHighlight } from "../utils/slidingHighlight";
  import { displayYearlyTotals } from "../utils/displayYears";

  const CURRENT: [number, number, number, number] = [1, 0.3, 0.38, 1];
  const PREVIOUS: [number, number, number, number] = [0.38, 0.09, 0.14, 1];

  document.addEventListener("DOMContentLoaded", () => {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".reports-range .range-btn"),
    );
    const prevBtn = document.getElementById("reportsPrev") as HTMLButtonElement;
    const nextBtn = document.getElementById("reportsNext") as HTMLButtonElement;
    const canvas = document.getElementById("reportsChart") as HTMLCanvasElement;
    const yAxis = document.getElementById("reportsYAxis") as HTMLElement;
    const xAxis = document.getElementById("reportsXAxis") as HTMLElement;
    const chart = createReportsChart(canvas, yAxis);

    let totals: YearlyTotals | null = null;
    let range: ReportRange = "week";
    let offset = 1;

    const rangeHighlight = createSlidingHighlight({
      highlightEl: document.getElementById("reportsRangeHighlight") as HTMLDivElement,
      buttons,
    });
    const initial = buttons.find((b) => b.classList.contains("is-active"));
    if (initial) rangeHighlight.sync(initial, false);
    rangeHighlight.observe();

    function render(animate = true) {
      if (!totals) return;
      const view = buildReport(totals, [], range, offset);
      const totalEl = document.getElementById("reportsTotal");
      const vsEl = document.getElementById("reportsVs");
      const periodEl = document.getElementById("reportsPeriodLabel");
      const legendEl = document.getElementById("reportsLegend");
      const rankEl = document.getElementById("reportsRank");

      if (totalEl) totalEl.textContent = view.currentTotal.toLocaleString();
      if (periodEl) periodEl.textContent = view.rangeLabel;
      if (vsEl) vsEl.innerHTML = reportVsHTML(view);
      if (legendEl) legendEl.innerHTML = reportLegendHTML(view);
      if (rankEl) rankEl.textContent = reportRankText(view);

      prevBtn.disabled = !view.canPrev;
      nextBtn.disabled = !view.canNext;

      xAxis.innerHTML = reportXAxisHTML(view);

      chart.setData(
        {
          labels: view.buckets.map((b) => b.label),
          current: view.buckets.map((b) => b.current),
          previous: view.buckets.map((b) => b.previous),
          currentColor: CURRENT,
          previousColor: PREVIOUS,
        },
        animate,
      );
    }

    function selectRange(button: HTMLButtonElement, animate = true) {
      const next = button.dataset.range as ReportRange;
      if (!next || next === range) return;
      range = next;
      offset = 1;
      for (const other of buttons) other.classList.toggle("is-active", other === button);
      rangeHighlight.sync(button, animate);
      render();
    }

    for (const button of buttons) {
      button.addEventListener("click", () => selectRange(button));
    }

    prevBtn.addEventListener("click", () => {
      offset += 1;
      render();
    });
    nextBtn.addEventListener("click", () => {
      if (offset <= 0) return;
      offset -= 1;
      render();
    });


    async function load() {
      try {
        totals = displayYearlyTotals(await fetchAppJson<YearlyTotals>("/data/yearly-totals.json"));
        render(false);
      } catch (err) {
        console.error("Failed to load reports:", err);
      }
    }

    load();
    onPathsUpdated(["/data/yearly-totals.json"], () => load());

    let resizeFrame = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => chart.resize());
    }).observe(canvas);
  });
</script>
