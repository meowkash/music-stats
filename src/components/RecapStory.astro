---
---

<div class="story-viewer" id="storyViewer" hidden aria-modal="true" role="dialog" aria-label="Year recap">
  <div class="story-stage" id="storyStage">
    <div class="story-progress" id="storyProgress" aria-hidden="true"></div>

    <header class="story-chrome">
      <span class="story-chrome-year" id="storyChromeYear"></span>
      <button class="nav-circle-btn story-close" id="storyClose" aria-label="Close recap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <div class="story-slides" id="storySlides"></div>
  </div>

  {/* Same job as .status-bar-shield in Layout.astro: an opaque strip pinned to
      the top edge keeps iOS from laying its blurred scroll-edge effect over the
      progress bars in a home-screen app. */}
  <div class="story-statusbar" aria-hidden="true"></div>
</div>

<style is:global>
  /* Global, not scoped: slides are built at runtime via innerHTML and never
     carry the scoping attribute. Every class here is `story-` prefixed. */
  .story-viewer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: calc(-1 * var(--standalone-bottom-offset, 0px));
    z-index: var(--z-story);
    background: #05050a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .story-viewer[hidden] {
    display: none;
  }

  /* Palette fallbacks. The real values are written onto the stage per year by
     applyRecapTheme() — see utils/recapTheme.ts. */
  .story-viewer {
    --year-hue: 45;
    --year-base: hsl(45 88% 52%);
    --year-accent: hsl(77 92% 58%);
    --year-deep: hsl(45 62% 11%);
    --year-glow: hsl(45 90% 52% / 0.45);
  }

  .story-stage {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 520px;
    max-height: 100lvh;
    overflow: hidden;
    background: #08080f;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: opacity var(--duration-fast) linear;
  }

  @media (min-width: 768px) {
    .story-stage {
      max-height: min(100lvh - 48px, 940px);
      border-radius: 22px;
      border: 1px solid var(--panel-border-hover);
      box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6);
    }
  }

  /* Segmented progress, Instagram-style. */
  .story-progress {
    position: absolute;
    top: calc(env(safe-area-inset-top) + 10px);
    left: 12px;
    right: 12px;
    z-index: 3;
    display: flex;
    gap: 4px;
  }

  .story-segment {
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
    overflow: hidden;
  }

  .story-segment-fill {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* Already-watched segments read as full without needing an animation. */
  .story-segment.is-seen .story-segment-fill {
    transform: scaleX(1);
  }

  @keyframes story-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .story-statusbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: env(safe-area-inset-top);
    z-index: 5;
    background-color: #06060b;
  }

  /* Picks up from the status-bar strip and fades into the slide, so the strip
     never reads as a band and the progress bars always sit on dark. */
  .story-stage::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(env(safe-area-inset-top) + 72px);
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      #06060b 0,
      #06060b env(safe-area-inset-top),
      rgba(6, 6, 11, 0.55) calc(env(safe-area-inset-top) + 30px),
      rgba(6, 6, 11, 0) 100%
    );
  }

  .story-chrome {
    position: absolute;
    top: calc(env(safe-area-inset-top) + 22px);
    left: 12px;
    right: 12px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .story-chrome-year {
    font-family: var(--font-header);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.75);
  }

  .story-close {
    pointer-events: auto;
    width: 32px;
    height: 32px;
  }

  .story-close svg {
    width: 16px;
    height: 16px;
  }

  /* Dim the whole stage while held, so pause is legible without a badge. */
  .story-stage.is-paused .story-slide.is-active {
    opacity: 0.72;
  }

  .story-slides {
    position: absolute;
    inset: 0;
  }

  .story-slide {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 1.7vh, 20px);
    padding: calc(env(safe-area-inset-top) + 76px) 24px calc(env(safe-area-inset-bottom) + 44px);
    text-align: center;
    overflow: hidden;
    transition: opacity var(--duration-fast) linear;
  }

  .story-slide.is-active {
    display: flex;
  }

  /* Content sits above the background layer. */
  .story-slide > *:not(.story-bg) {
    position: relative;
    z-index: 1;
  }

  /* Re-asserted after the rule above, which would otherwise take the hint out
     of its pinned position and drop it into the content flow. */
  .story-slide > .story-hint {
    position: absolute;
  }

  /* Every slide paints from three colours. Each tone has its own palette — far
     apart on the wheel so consecutive slides feel distinct — and the ranked
     slides override theirs with colours pulled from the #1's artwork. */
  .story-slide {
    --c1: var(--year-base);
    --c2: var(--year-accent);
    --c3: hsl(calc(var(--year-hue) - 70) 85% 58%);
    --base: color-mix(in srgb, var(--c1) 30%, #08080e);
    background: linear-gradient(180deg, var(--base) 0%, color-mix(in srgb, var(--c3) 24%, #06060a) 100%);
  }

  .story-slide[data-tone='intro'] { --c2: hsl(calc(var(--year-hue) + 70) 90% 62%); }
  .story-slide[data-tone='minutes'] { --c1: #3b82f6; --c2: #22d3ee; --c3: #8b5cf6; }
  .story-slide[data-tone='artist'] { --c1: #f43f5e; --c2: #fb923c; --c3: #a855f7; }
  .story-slide[data-tone='album'] { --c1: #10b981; --c2: #06b6d4; --c3: #84cc16; }
  .story-slide[data-tone='track'] { --c1: #ec4899; --c2: #8b5cf6; --c3: #f59e0b; }
  .story-slide[data-tone='genre'] { --c1: #f97316; --c2: #facc15; --c3: #ef4444; }
  .story-slide[data-tone='stream'] { --c1: #14b8a6; --c2: #6366f1; --c3: #a3e635; }
  .story-slide[data-tone='when'] { --c1: #f59e0b; --c2: #2dd4bf; --c3: #fb7185; }
  .story-slide[data-tone='season'] { --c1: #22c55e; --c2: #0ea5e9; --c3: #eab308; }
  .story-slide[data-tone='milestone'] { --c1: #ef4444; --c2: #f59e0b; --c3: #fb7185; }
  .story-slide[data-tone='style'] { --c1: #a855f7; --c2: #ec4899; --c3: #6366f1; }
  .story-slide[data-tone='finale'] { --c2: #f472b6; --c3: #38bdf8; }

  /* Background stack: blurred artwork (when there is one), then three drifting
     colour pools, then a scrim. The scrim is load-bearing, not decoration: it
     holds text contrast over an arbitrary cover and colour. */
  .story-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .story-bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Scaled up so the blur has pixels to work with at the edges. */
    transform: scale(1.4);
    filter: blur(44px) saturate(170%) brightness(0.75);
    opacity: 0.5;
  }

  /* Radial gradients rather than blurred discs: soft by construction, so the
     drift is a plain transform with no filter to re-rasterise per frame. */
  .story-aura {
    position: absolute;
    inset: 0;
  }

  .story-aura i {
    position: absolute;
    width: 110%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--pool) 78%, transparent) 0%,
      color-mix(in srgb, var(--pool) 34%, transparent) 38%,
      transparent 68%
    );
    animation: story-drift 16s ease-in-out infinite alternate;
  }

  .story-aura i:nth-child(1) { --pool: var(--c1); top: -26%; left: -34%; }
  .story-aura i:nth-child(2) { --pool: var(--c2); top: 22%; right: -46%; animation-duration: 19s; animation-delay: -6s; }
  .story-aura i:nth-child(3) { --pool: var(--c3); bottom: -36%; left: -22%; animation-duration: 22s; animation-delay: -11s; }

  @keyframes story-drift {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(9%, 6%, 0) scale(1.12); }
    100% { transform: translate3d(-7%, 10%, 0) scale(0.94); }
  }

  .story-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 55% at 50% 48%, rgba(5, 5, 10, 0.3) 0%, rgba(5, 5, 10, 0) 100%),
      linear-gradient(180deg, rgba(5, 5, 10, 0) 0%, rgba(5, 5, 10, 0.08) 55%, rgba(5, 5, 10, 0.5) 100%);
  }

  .story-bg:has(img)::after {
    background:
      radial-gradient(ellipse 85% 55% at 50% 45%, rgba(5, 5, 10, 0.34) 0%, rgba(5, 5, 10, 0.06) 100%),
      linear-gradient(180deg, rgba(5, 5, 10, 0.12) 0%, rgba(5, 5, 10, 0.2) 55%, rgba(5, 5, 10, 0.62) 100%);
  }

  .story-slide.is-active .story-bg {
    animation: story-backdrop-in 1.1s var(--ios-spring) both;
  }

  @keyframes story-backdrop-in {
    from { opacity: 0; transform: scale(1.08); }
    to { opacity: 1; transform: scale(1); }
  }

  /* The colour pools now run bright enough to sit behind text, so copy carries
     a soft shadow to keep its edge against them. */
  .story-slide {
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.28);
  }

  /* ── Typography ────────────────────────────────────────────────────── */
  .story-eyebrow {
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .story-year {
    font-family: var(--font-numeric);
    font-size: clamp(84px, 28vw, 150px);
    font-weight: var(--font-numeric-weight);
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #fff;
    text-shadow: 0 0 60px color-mix(in srgb, var(--c1) 60%, transparent);
  }

  /* Every figure in a story uses the dashboard's stat face (Layout.astro),
     including the count-ups that sit inline in body copy. */
  .story-counter,
  .story-finale-summary .is-number {
    font-family: var(--font-numeric);
    font-weight: var(--font-numeric-weight);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }

  .story-stat {
    font-family: var(--font-numeric);
    font-size: clamp(56px, 19vw, 104px);
    font-weight: var(--font-numeric-weight);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
  }

  /* Full minute counts run to seven characters; at the headline size they would
     otherwise wrap mid-number on a phone. */
  .story-stat.is-long {
    font-size: clamp(40px, 13.5vw, 78px);
    letter-spacing: -0.04em;
  }

  .story-title {
    font-family: var(--font-header);
    font-size: clamp(32px, 9vw, 50px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }

  .story-title-sm {
    font-family: var(--font-header);
    font-size: clamp(23px, 6.4vw, 31px);
    font-weight: 700;
    color: #fff;
    text-wrap: balance;
  }

  .story-subtitle {
    font-size: 18px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
  }

  .story-lede {
    font-size: 18px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
    max-width: 26ch;
    text-wrap: balance;
  }

  .story-footnote {
    font-size: 14.5px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.68);
    max-width: 32ch;
  }

  .story-hint {
    position: absolute;
    bottom: calc(var(--standalone-bottom-offset, 0px) + env(safe-area-inset-bottom) + 22px);
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    animation: story-hint-pulse 2.4s ease-in-out infinite;
  }

  @keyframes story-hint-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.8; }
  }

  /* Entry animations, driven off .is-active so replaying a slide re-runs them.
     Everything animates transform/opacity only. */
  .story-slide.is-active > *:not(.story-bg) {
    animation: story-rise 0.62s var(--ios-spring) both;
  }
  /* Starts at 2 because the background layer is always the first child. */
  .story-slide.is-active > *:nth-child(2) { animation-delay: 0.07s; }
  .story-slide.is-active > *:nth-child(3) { animation-delay: 0.14s; }
  .story-slide.is-active > *:nth-child(4) { animation-delay: 0.21s; }
  .story-slide.is-active > *:nth-child(5) { animation-delay: 0.28s; }
  .story-slide.is-active > *:nth-child(6) { animation-delay: 0.35s; }
  .story-slide.is-active > *:nth-child(7) { animation-delay: 0.42s; }
  .story-slide.is-active > *:nth-child(8) { animation-delay: 0.49s; }

  @keyframes story-rise {
    from { opacity: 0; transform: translate3d(0, 22px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  .story-hero-art {
    position: relative;
    flex-shrink: 0;
    /* Grows with the viewport's height as well as its width, so a tall phone
       does not leave a band of empty gradient under the cover. */
    width: min(74vw, 42vh, 340px);
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.5),
      0 0 70px color-mix(in srgb, var(--c1) 45%, transparent);
  }

  .story-slide[data-tone='artist'] .story-hero-art {
    border-radius: 50%;
  }

  .story-hero-art .artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Kept on its own layer on two-phase slides so the FLIP neither promotes it
     on the first frame nor drops and re-rasterises it on the last (both read
     as a twitch at either end of the move). */
  .story-slide[data-steps='2'] .story-hero-art {
    will-change: transform;
    backface-visibility: hidden;
  }

  .story-slide.is-active .story-hero-art {
    animation: story-art-in 0.8s var(--ios-spring) both;
  }

  @keyframes story-art-in {
    from { opacity: 0; transform: scale(0.82) translate3d(0, 18px, 0); }
    to { opacity: 1; transform: scale(1) translate3d(0, 0, 0); }
  }

  /* flex:1 + space-evenly is how every list and chart here claims the leftover
     height rather than huddling in the middle. */
  .story-runners {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 8px;
    width: 100%;
    max-width: 400px;
    max-height: 62vh;
    min-height: 0;
    list-style: none;
    margin: 4px 0;
    padding: 0;
  }

  /* Each row carries a faint bar of its plays against the #1, so the gap
     between ranks reads at a glance without another chart. */
  .story-runners li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px 10px 10px;
    border-radius: 15px;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--c1) 30%, transparent) 0, color-mix(in srgb, var(--c2) 22%, transparent) var(--fill), transparent var(--fill)),
      rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
  }

  .story-slide.is-active .story-runners li {
    animation: story-rise 0.5s var(--ios-spring) both;
    animation-delay: calc(0.16s + var(--row-index) * 0.075s);
  }

  .story-runner-rank {
    width: 18px;
    font-family: var(--font-numeric);
    font-size: 15px;
    font-weight: var(--font-numeric-weight);
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.5);
    flex-shrink: 0;
  }

  .story-runner-art {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    overflow: hidden;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.06);
  }

  .story-runner-art .artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-runner-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .story-runner-text strong {
    font-size: 16.5px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .story-runner-text em {
    font-size: 13.5px;
    font-style: normal;
    color: rgba(255, 255, 255, 0.68);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .story-runner-plays {
    font-family: var(--font-numeric);
    font-size: 15.5px;
    font-weight: var(--font-numeric-weight);
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.85);
    flex-shrink: 0;
  }

  .story-slide[data-tone='artist'] .story-runner-art {
    border-radius: 50%;
  }

  /* ── Ranked slides (two phases) ────────────────────────────────────────
     Phase 0: the #1 alone, large and centred. Phase 1: it collapses into a
     header card and the runners-up rise in beneath. The cover's travel between
     the two is a FLIP run from the script; CSS only describes the end states. */
  .story-lead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 2vh, 20px);
    width: 100%;
    max-width: 400px;
  }

  .story-lead-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .story-lead-meta {
    font-size: 15px;
    font-weight: 600;
    color: color-mix(in srgb, var(--c1) 45%, #fff);
  }

  .story-lead-rank,
  .story-split-foot,
  .story-swap-b {
    display: none;
  }

  .story-slide[data-step='0'] .story-runners {
    display: none;
  }

  .story-slide[data-step='1'] .story-swap-a { display: none; }
  .story-slide[data-step='1'] .story-swap-b,
  .story-slide[data-step='1'] .story-split-foot { display: block; }

  .story-slide[data-step='1'] .story-lead {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    padding: 12px 16px 12px 12px;
    border-radius: 20px;
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--c1) 34%, transparent), color-mix(in srgb, var(--c2) 18%, transparent)),
      rgba(255, 255, 255, 0.06);
    border: 1px solid color-mix(in srgb, var(--c1) 40%, rgba(255, 255, 255, 0.12));
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.3);
  }

  .story-slide[data-step='1'] .story-lead-rank {
    display: block;
    font-family: var(--font-numeric);
    font-size: 22px;
    font-weight: var(--font-numeric-weight);
    color: color-mix(in srgb, var(--c1) 50%, #fff);
    width: 18px;
    flex-shrink: 0;
  }

  .story-slide[data-step='1'] .story-hero-art {
    width: 76px;
    border-radius: 14px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.4);
  }

  .story-slide[data-step='1'][data-tone='artist'] .story-hero-art {
    border-radius: 50%;
  }

  .story-slide[data-step='1'] .story-lead-text {
    align-items: flex-start;
    gap: 2px;
    text-align: left;
    flex: 1;
  }

  .story-slide[data-step='1'] .story-lead-text .story-title {
    font-size: 22px;
    line-height: 1.15;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .story-slide[data-step='1'] .story-lead-text .story-subtitle {
    font-size: 14px;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .story-slide[data-step='1'] .story-lead-meta {
    font-size: 13px;
  }

  .story-slide[data-step='1'] .story-runners {
    flex: 0 1 auto;
    justify-content: flex-start;
    margin-top: 2px;
  }

  /* The phase-1 pieces arrive like a fresh slide does, so going back and
     forward between phases replays them. */
  .story-slide[data-step='1'] .story-swap-b,
  .story-slide[data-step='1'] .story-split-foot,
  .story-slide[data-step='1'] .story-lead-rank {
    animation: story-rise 0.55s var(--ios-spring) both;
    animation-delay: 0.3s;
  }

  .story-slide[data-step='1'] .story-split-foot {
    animation-delay: 0.6s;
  }

  .story-slide[data-step='0'] .story-swap-a {
    animation: story-rise 0.5s var(--ios-spring) both;
  }

  /* ── Illustrations (utils/recapArt.ts) ─────────────────────────────── */
  .story-ill {
    width: min(74vw, 32vh, 290px);
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 10px 30px color-mix(in srgb, var(--c1) 35%, transparent));
  }

  .story-ill-sm {
    width: min(48vw, 20vh, 180px);
  }

  .story-ill-eq {
    width: min(58vw, 230px);
    margin-top: -4px;
    filter: none;
  }

  .story-ill .f1 { fill: var(--c1); }
  .story-ill .f2 { fill: var(--c2); }
  .story-ill .f3 { fill: var(--c3); }
  .story-ill .fw { fill: #fff; }
  .story-ill .s1 { stroke: var(--c1); }
  .story-ill .s2 { stroke: var(--c2); }
  .story-ill .s3 { stroke: var(--c3); }
  .story-ill .sw { stroke: #fff; }

  .story-ill [class*='ia-'] {
    transform-box: fill-box;
    transform-origin: center;
    animation-delay: calc(var(--i, 0) * 0.18s);
  }

  .story-ill .ia-spin { animation: ia-spin var(--d, 8s) linear infinite; }
  .story-ill .ia-bob { animation: ia-bob 2.4s ease-in-out infinite alternate; }
  .story-ill .ia-float { animation: ia-bob 4s ease-in-out infinite alternate; }
  .story-ill .ia-pulse { animation: ia-pulse 2.6s ease-in-out infinite alternate; }
  .story-ill .ia-beat { animation: ia-beat 1.3s ease-out infinite; animation-delay: calc(var(--i, 0) * 0.32s); }
  .story-ill .ia-thump { animation: ia-thump 0.48s ease-in infinite alternate; }
  .story-ill .ia-breathe { animation: ia-breathe 5s ease-in-out infinite alternate; }
  .story-ill .ia-ripple { animation: ia-ripple 2.8s ease-out infinite; animation-delay: calc(var(--i, 0) * 0.93s); }
  .story-ill .ia-ripple-slow { animation: ia-ripple-slow 4.4s ease-out infinite; animation-delay: calc(var(--i, 0) * 1.1s); }
  .story-ill .ia-blink { animation: ia-blink 1.8s ease-in-out infinite alternate; }
  .story-ill .ia-twinkle { animation: ia-twinkle 1.9s ease-in-out infinite alternate; animation-delay: calc(var(--i, 0) * 0.45s); }
  .story-ill .ia-eq { transform-origin: 50% 100%; animation: ia-eq 0.9s ease-in-out infinite alternate; animation-delay: calc(var(--i, 0) * -0.13s); }
  .story-ill .ia-draw { stroke-dashoffset: 1; animation: ia-draw 1.8s var(--ios-spring) forwards; animation-delay: calc(0.3s + var(--i, 0) * 0.3s); }
  .story-ill .ia-draw-loop { stroke-dashoffset: 1; animation: ia-draw-loop 5s ease-in-out infinite; }
  .story-ill .ia-dash { animation: ia-dash 2.2s linear infinite; }
  .story-ill .ia-rise { animation: ia-rise 3.2s ease-out infinite; animation-delay: calc(var(--i, 0) * 1.05s); }
  .story-ill .ia-swing { animation: ia-swing 2.6s ease-in-out infinite alternate; }
  .story-ill .ia-drop { animation: ia-drop 0.7s var(--ios-spring) both; animation-delay: calc(0.5s + var(--i, 0) * 0.4s); }
  .story-ill .ia-pop { animation: ia-pop 0.5s var(--ios-spring) both; animation-delay: calc(0.2s + var(--i, 0) * 0.05s); }
  .story-ill .ia-lift { animation: ia-lift 6s ease-in-out infinite; animation-delay: calc(var(--i, 0) * 1s); }
  .story-ill .ia-arm { transform-box: view-box; transform-origin: 166px 30px; animation: ia-arm 3s ease-in-out infinite alternate; }
  .story-ill .ia-flash { animation: ia-flash 2.8s linear infinite; }
  .story-ill .ia-shock { animation: ia-shock 0.7s ease-in-out infinite alternate; animation-delay: calc(var(--i, 0) * 0.2s); }
  .story-ill .ia-pad { animation: ia-pad 1.6s linear infinite; animation-delay: calc(var(--i, 0) * 0.1s); }
  .story-ill .ia-beam { animation: ia-beam 2.2s ease-in-out infinite alternate; animation-delay: calc(var(--i, 0) * 0.4s); }
  .story-ill .ia-wave { animation: ia-wave var(--d, 3s) linear infinite; }
  .story-ill .ia-key { animation: ia-key 1.4s ease-in-out infinite; animation-delay: calc(var(--i, 0) * 0.14s); }
  .story-ill .ia-slide { animation: ia-slide 4s linear infinite; }
  .story-ill .ia-road { animation: ia-road 0.8s linear infinite; }
  .story-ill .ia-drift { animation: ia-drift 6s ease-in-out infinite alternate; animation-delay: calc(var(--i, 0) * -2.1s); }
  .story-ill .ia-sway { transform-origin: var(--o, 50% 100%); animation: ia-sway 3.2s ease-in-out infinite alternate; }
  .story-ill .ia-string { animation: ia-string 0.09s linear infinite alternate; }

  @keyframes ia-spin { to { transform: rotate(1turn); } }
  @keyframes ia-bob { from { transform: translateY(3px); } to { transform: translateY(-5px); } }
  @keyframes ia-pulse { from { transform: scale(0.93); } to { transform: scale(1.06); } }
  @keyframes ia-beat {
    0%, 100% { transform: scale(1); }
    14% { transform: scale(1.12); }
    28% { transform: scale(0.98); }
    42% { transform: scale(1.07); }
    60% { transform: scale(1); }
  }
  @keyframes ia-thump { from { transform: scale(0.94); } to { transform: scale(1.08); } }
  @keyframes ia-breathe { from { transform: scale(0.84); opacity: 0.55; } to { transform: scale(1.12); opacity: 0.95; } }
  @keyframes ia-ripple { from { transform: scale(0.55); opacity: 0.7; } to { transform: scale(1.5); opacity: 0; } }
  @keyframes ia-ripple-slow {
    0% { transform: scale(0.1); opacity: 0; }
    30% { opacity: 0.9; }
    100% { transform: scale(1.25); opacity: 0; }
  }
  @keyframes ia-blink { from { opacity: 0.2; } to { opacity: 0.85; } }
  @keyframes ia-twinkle { from { transform: scale(0.45); opacity: 0.35; } to { transform: scale(1.1); opacity: 1; } }
  @keyframes ia-eq { from { transform: scaleY(0.28); } to { transform: scaleY(1); } }
  @keyframes ia-draw { to { stroke-dashoffset: 0; } }
  @keyframes ia-draw-loop {
    0% { stroke-dashoffset: 1; }
    55%, 75% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -1; }
  }
  @keyframes ia-dash { to { stroke-dashoffset: -44; } }
  @keyframes ia-rise {
    0% { transform: translateY(8px); opacity: 0; }
    25% { opacity: 1; }
    100% { transform: translateY(-16px); opacity: 0; }
  }
  @keyframes ia-swing { from { transform: rotate(-30deg); } to { transform: rotate(24deg); } }
  @keyframes ia-drop { from { transform: translateY(-22px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  @keyframes ia-pop { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes ia-lift {
    0%, 16%, 100% { transform: translateY(0); }
    8% { transform: translateY(-18px); }
  }
  @keyframes ia-arm { from { transform: rotate(-3deg); } to { transform: rotate(2deg); } }
  @keyframes ia-flash {
    0%, 18%, 100% { opacity: 1; transform: scale(1); }
    3% { opacity: 0.35; transform: scale(0.97); }
    6% { opacity: 1; transform: scale(1.05); }
    10% { opacity: 0.5; }
    13% { opacity: 1; }
  }
  @keyframes ia-shock { from { transform: translateX(-2px); opacity: 0.45; } to { transform: translateX(2px); opacity: 1; } }
  @keyframes ia-pad {
    0%, 30%, 100% { opacity: 0.35; transform: scale(1); }
    6% { opacity: 1; transform: scale(0.88); }
  }
  @keyframes ia-beam { from { opacity: 0.12; } to { opacity: 0.45; } }
  @keyframes ia-wave { to { transform: translateX(var(--p, -60px)); } }
  @keyframes ia-key {
    0%, 30%, 100% { transform: translateY(0); opacity: 1; }
    12% { transform: translateY(2px); opacity: 0.7; }
  }
  @keyframes ia-slide { to { transform: translateX(-50px); } }
  @keyframes ia-road { to { stroke-dashoffset: -24; } }
  @keyframes ia-drift { from { transform: translateX(-10px); } to { transform: translateX(10px); } }
  @keyframes ia-sway { from { transform: rotate(-5deg); } to { transform: rotate(5deg); } }
  @keyframes ia-string { from { transform: translateX(-0.6px); } to { transform: translateX(0.6px); } }

  .story-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* ── Genre bars ────────────────────────────────────────────────────── */
  .story-genre-bars {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 9px;
    width: 100%;
    max-width: 400px;
    max-height: 60vh;
    min-height: 0;
    margin-top: 6px;
  }

  .story-genre-row {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 2fr) auto;
    align-items: center;
    gap: 11px;
  }

  .story-genre-name {
    font-size: 15.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .story-genre-track {
    height: 13px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  /* `--fill` is the share rescaled against the top genre, not against 100% —
     see buildStories(). The printed percentage stays the true share. */
  .story-genre-track i {
    display: block;
    height: 100%;
    width: var(--fill);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--c1), var(--c2));
    box-shadow: 0 0 14px color-mix(in srgb, var(--c1) 45%, transparent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .story-slide.is-active .story-genre-track i {
    animation: story-grow-x 0.7s var(--ios-spring) both;
    animation-delay: calc(0.2s + var(--row-index) * 0.09s);
  }

  @keyframes story-grow-x {
    to { transform: scaleX(1); }
  }

  .story-genre-share {
    font-family: var(--font-numeric);
    font-size: 14.5px;
    font-weight: var(--font-numeric-weight);
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.8);
    min-width: 44px;
    text-align: left;
  }

  /* ── Bar chart (weekday / month) ───────────────────────────────────── */
  .story-bars {
    display: flex;
    flex: 1 1 auto;
    align-items: flex-end;
    justify-content: center;
    gap: 6px;
    width: 100%;
    max-width: 400px;
    min-height: 140px;
    max-height: 52vh;
    margin: 8px 0 2px;
  }

  .story-bar {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
  }

  .story-bar i {
    display: block;
    width: 100%;
    height: var(--bar-height);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.22);
    transform: scaleY(0);
    transform-origin: bottom center;
  }

  .story-bar.is-peak i {
    background: linear-gradient(180deg, #fff 0%, var(--card-color, var(--c1)) 100%);
    box-shadow: 0 0 18px color-mix(in srgb, var(--card-color, var(--c1)) 55%, transparent);
  }

  .story-bar span {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
  }

  .story-bar.is-peak span {
    color: #fff;
  }

  .story-slide.is-active .story-bar i {
    animation: story-grow-y 0.6s var(--ios-spring) both;
    animation-delay: calc(0.18s + var(--bar-index) * 0.035s);
  }

  @keyframes story-grow-y {
    to { transform: scaleY(1); }
  }

  .story-bars.is-mini {
    flex: 0 0 auto;
    height: clamp(44px, 7.5vh, 70px);
    min-height: 0;
    gap: 4px;
    margin: 4px 0 0;
    max-width: none;
  }

  .story-bars.is-mini .story-bar {
    gap: 4px;
  }

  .story-bars.is-mini .story-bar i {
    border-radius: 4px;
    background: color-mix(in srgb, var(--card-color) 30%, rgba(255, 255, 255, 0.12));
  }

  .story-bars.is-mini .story-bar.is-peak i {
    background: linear-gradient(180deg, #fff 0%, var(--card-color) 100%);
  }

  .story-bars.is-mini .story-bar span {
    font-size: 10px;
  }

  /* ── When: hour, weekday and month cards ───────────────────────────── */
  .story-when {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 10px;
    width: 100%;
    max-width: 400px;
    max-height: 66vh;
    min-height: 0;
    margin-top: 4px;
  }

  .story-when-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px;
    border-radius: 18px;
    overflow: hidden;
    text-align: left;
    background: linear-gradient(150deg, color-mix(in srgb, var(--card-color) 24%, transparent) 0%, rgba(255, 255, 255, 0.04) 75%);
    border: 1px solid color-mix(in srgb, var(--card-color) 30%, rgba(255, 255, 255, 0.08));
  }

  .story-slide.is-active .story-when-card {
    animation: story-rise 0.55s var(--ios-spring) both;
    animation-delay: calc(0.16s + var(--row-index) * 0.1s);
  }

  .story-when-card.is-clock {
    flex-direction: row;
    align-items: center;
    gap: 14px;
  }

  .story-when-card.is-clock .story-clock {
    width: clamp(96px, 15vh, 128px);
    flex-shrink: 0;
    margin: 0;
  }

  .story-when-card .story-ray.is-peak {
    stroke: var(--card-color);
    filter: drop-shadow(0 0 6px var(--card-color));
  }

  .story-when-card .story-ray {
    stroke: color-mix(in srgb, var(--card-color) 45%, rgba(255, 255, 255, 0.35));
  }

  .story-when-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .story-when-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .story-when-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--card-color) 55%, #fff);
  }

  .story-when-label .story-icon {
    width: 15px;
    height: 15px;
    color: var(--card-color);
  }

  .story-when-value {
    font-family: var(--font-header);
    font-size: clamp(22px, 6.4vw, 28px);
    font-weight: 700;
    line-height: 1.05;
    color: #fff;
  }

  .story-when-note {
    font-size: 13px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.72);
  }

  /* ── Clock dial ────────────────────────────────────────────────────── */
  .story-clock {
    width: min(74vw, 44vh, 330px);
    height: auto;
    margin: 2px 0;
  }

  .story-clock-core {
    fill: none;
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 1;
  }

  .story-clock-tick {
    font-family: var(--font-numeric);
    font-size: 10px;
    font-weight: 600;
    fill: rgba(255, 255, 255, 0.45);
    text-anchor: middle;
  }

  .story-ray {
    stroke: rgba(255, 255, 255, 0.45);
    stroke-width: 5;
    stroke-linecap: round;
    transform-origin: 100px 100px;
  }

  .story-ray.is-peak {
    stroke: var(--c1);
    filter: drop-shadow(0 0 8px var(--c1));
  }

  .story-slide.is-active .story-ray {
    animation: story-ray-in 0.5s var(--ios-spring) both;
    animation-delay: calc(0.2s + var(--ray-index) * 0.022s);
  }

  @keyframes story-ray-in {
    from { opacity: 0; transform: scale(0.3); }
    to { opacity: 1; transform: scale(1); }
  }

  /* ── Genre stream ──────────────────────────────────────────────────── */
  .story-stream-wrap {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    width: 100%;
    max-width: 400px;
    max-height: 60vh;
    min-height: 0;
    margin-top: 6px;
  }

  .story-stream {
    flex: 1 1 auto;
    width: 100%;
    min-height: 150px;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  /* Categorical, so the five layers must stay distinguishable — but spaced
     around the year's hue rather than fixed colours, to stay in palette. */
  .story-stream-layer {
    --layer-color: var(--year-base);
    fill: var(--layer-color);
    opacity: 0.88;
  }

  .story-stream-layer[style*='--layer-index:0'] { --layer-color: hsl(var(--year-hue) 88% 58%); }
  .story-stream-layer[style*='--layer-index:1'] { --layer-color: hsl(calc(var(--year-hue) + 62) 82% 54%); }
  .story-stream-layer[style*='--layer-index:2'] { --layer-color: hsl(calc(var(--year-hue) + 138) 78% 52%); }
  .story-stream-layer[style*='--layer-index:3'] { --layer-color: hsl(calc(var(--year-hue) + 202) 80% 60%); }
  .story-stream-layer[style*='--layer-index:4'] { --layer-color: hsl(calc(var(--year-hue) + 288) 76% 62%); }

  .story-slide.is-active .story-stream {
    animation: story-wipe 0.9s var(--ios-spring) both;
    animation-delay: 0.16s;
  }

  @keyframes story-wipe {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  .story-stream-axis {
    display: flex;
    justify-content: space-between;
    padding: 7px 2px 0;
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
  }

  .story-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 5px 14px;
    margin-top: 12px;
  }

  .story-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
  }

  .story-legend-item i {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--year-base);
  }

  .story-legend-item[style*='--layer-index:0'] i { background: hsl(var(--year-hue) 88% 58%); }
  .story-legend-item[style*='--layer-index:1'] i { background: hsl(calc(var(--year-hue) + 62) 82% 54%); }
  .story-legend-item[style*='--layer-index:2'] i { background: hsl(calc(var(--year-hue) + 138) 78% 52%); }
  .story-legend-item[style*='--layer-index:3'] i { background: hsl(calc(var(--year-hue) + 202) 80% 60%); }
  .story-legend-item[style*='--layer-index:4'] i { background: hsl(calc(var(--year-hue) + 288) 76% 62%); }

  /* ── Seasons ───────────────────────────────────────────────────────── */
  .story-seasons {
    display: grid;
    flex: 1 1 auto;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 400px;
    max-height: 64vh;
    min-height: 0;
    margin-top: 8px;
  }

  .story-season {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 10px;
    border-radius: 16px;
    overflow: hidden;
    background:
      linear-gradient(155deg, color-mix(in srgb, var(--ring-color) 22%, transparent) 0%, rgba(255, 255, 255, 0.04) 70%);
    border: 1px solid color-mix(in srgb, var(--ring-color) 26%, rgba(255, 255, 255, 0.08));
  }

  /* Each season carries its own mark, sunk into the corner of the card so it
     reads as texture rather than competing with the share dial. */
  .story-season-glyph {
    position: absolute;
    right: -14px;
    bottom: -16px;
    width: 84px;
    height: 84px;
    color: var(--ring-color);
    opacity: 0.28;
    pointer-events: none;
  }

  .story-slide.is-active .story-season-glyph {
    animation: story-glyph-in 0.9s var(--ios-spring) both;
    animation-delay: calc(0.24s + var(--row-index) * 0.08s);
  }

  @keyframes story-glyph-in {
    from { opacity: 0; transform: rotate(-18deg) scale(0.7); }
    to { opacity: 0.28; transform: rotate(0) scale(1); }
  }

  .story-slide.is-active .story-season {
    animation: story-rise 0.55s var(--ios-spring) both;
    animation-delay: calc(0.16s + var(--row-index) * 0.08s);
  }

  .story-season-name {
    position: relative;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Conic ring reads as a share dial without needing an SVG per season. */
  .story-season-ring {
    position: relative;
    width: clamp(62px, 11vh, 82px);
    height: clamp(62px, 11vh, 82px);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: conic-gradient(var(--ring-color) calc(var(--share) * 1%), rgba(255, 255, 255, 0.1) 0);
  }

  .story-season-ring::after {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    /* Tinted rather than flat black so the dial's centre reads as part of the
       season card instead of a hole punched through it. */
    background: color-mix(in srgb, var(--ring-color) 12%, #0b0b13);
  }

  .story-season-ring b {
    position: relative;
    z-index: 1;
    font-family: var(--font-numeric);
    font-size: 17px;
    font-weight: var(--font-numeric-weight);
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .story-season[data-season='winter'] { --ring-color: #00f0ff; }
  .story-season[data-season='spring'] { --ring-color: #22c55e; }
  .story-season[data-season='summer'] { --ring-color: #eab308; }
  .story-season[data-season='autumn'] { --ring-color: #f97316; }

  .story-season-artist {
    position: relative;
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.85);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* ── Milestone facts ───────────────────────────────────────────────── */
  .story-facts {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 10px;
    width: 100%;
    max-width: 380px;
    max-height: 58vh;
    min-height: 0;
    margin-top: 8px;
  }

  .story-fact {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 18px;
    background: linear-gradient(120deg, color-mix(in srgb, var(--fact-color) 22%, transparent) 0%, rgba(255, 255, 255, 0.04) 80%);
    border: 1px solid color-mix(in srgb, var(--fact-color) 30%, rgba(255, 255, 255, 0.08));
    text-align: left;
  }

  .story-fact-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    color: var(--fact-color);
    background: color-mix(in srgb, var(--fact-color) 18%, transparent);
    box-shadow: 0 0 22px color-mix(in srgb, var(--fact-color) 35%, transparent);
  }

  .story-fact-icon .story-icon {
    width: 20px;
    height: 20px;
  }

  .story-slide.is-active .story-fact-icon {
    animation: story-icon-pop 0.7s var(--ios-spring) both;
    animation-delay: calc(0.3s + var(--row-index) * 0.09s);
  }

  @keyframes story-icon-pop {
    from { transform: scale(0.4) rotate(-20deg); opacity: 0; }
    to { transform: scale(1) rotate(0); opacity: 1; }
  }

  .story-slide.is-active .story-fact {
    animation: story-rise 0.55s var(--ios-spring) both;
    animation-delay: calc(0.16s + var(--row-index) * 0.09s);
  }

  .story-fact-value {
    font-family: var(--font-numeric);
    font-size: 32px;
    font-weight: var(--font-numeric-weight);
    font-variant-numeric: tabular-nums;
    /* Lightened toward white so it clears contrast whatever the fact colour. */
    color: color-mix(in srgb, var(--fact-color) 60%, #fff);
    min-width: 70px;
    text-shadow: 0 0 20px color-mix(in srgb, var(--fact-color) 50%, transparent);
  }

  .story-fact-label {
    font-size: 14px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
  }

  /* ── Finale ────────────────────────────────────────────────────────── */
  .story-finale-summary {
    display: flex;
    gap: 10px;
    margin-top: 14px;
    width: 100%;
    max-width: 400px;
  }

  .story-finale-summary span {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 9px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  .story-finale-summary span {
    background: linear-gradient(160deg, color-mix(in srgb, var(--c1) 20%, transparent), rgba(255, 255, 255, 0.05));
  }

  .story-finale-summary b {
    font-family: var(--font-header);
    font-size: 15px;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .story-slide.is-active > *,
    .story-slide.is-active .story-runners li,
    .story-slide.is-active .story-season,
    .story-slide.is-active .story-fact,
    .story-slide.is-active .story-hero-art,
    .story-slide.is-active .story-ray,
    .story-slide.is-active .story-stream,
    .story-slide.is-active .story-bg,
    .story-slide.is-active .story-when-card,
    .story-slide.is-active .story-fact-icon,
    .story-slide[data-step] *,
    .story-aura i,
    .story-ill,
    .story-ill * {
      animation: none !important;
    }

    .story-ill .ia-draw,
    .story-ill .ia-draw-loop {
      stroke-dashoffset: 0;
    }

    /* Keeps the glyph at its resting opacity — `animation: none` on a `both`
       fill would otherwise snap it back to fully opaque. */
    .story-slide.is-active .story-season-glyph {
      animation: none;
      opacity: 0.28;
    }

    .story-slide.is-active .story-bar i,
    .story-slide.is-active .story-genre-track i {
      animation: none;
      transform: none;
    }

    .story-hint {
      animation: none;
    }
  }
</style>

<script>
  import { onReady } from "../utils/dom";
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import { disposeArtworkImages, escapeHTML, initArtworkImages, loadArtworkCache, loadColorsCache } from "../utils/ui";
  import { rafTween } from "../utils/motion";
  import { createStoryPlayer, type StoryPlayer } from "../utils/storyPlayer";
  import { applyRecapTheme } from "../utils/recapTheme";
  import { RECAP_OPEN_EVENT, buildStories, type Recap } from "../utils/recapStories";
  import { setOverlayOpen } from "../utils/overlayState";

  const STORY_DURATION_MS = 20_000;
  const COUNT_UP_MS = 1100;
  /** Fade-out of the outgoing phase's text before the cover starts to move. */
  const STEP_FADE_MS = 160;
  // Ease-out-cubic over ~0.5s: a steeper-tailed curve (expo/quint) spends its
  // last few hundred ms creeping by sub-pixels, which iOS renders as the cover
  // shimmering between pixel positions before it settles.
  const STEP_MOVE_MS = 520;
  const STEP_EASING = "cubic-bezier(0.33, 1, 0.68, 1)";

  /** Background stack every slide gets: optional blurred cover, colour pools. */
  function backgroundHTML(backdrop: string | null | undefined): string {
    const img = backdrop
      ? `<img src="${escapeHTML(backdrop)}" alt="" decoding="async" />`
      : "";
    return `<div class="story-bg" aria-hidden="true">${img}<div class="story-aura"><i></i><i></i><i></i></div></div>`;
  }

  onReady(() => {
    const viewer = document.getElementById("storyViewer") as HTMLDivElement;
    const stage = document.getElementById("storyStage") as HTMLDivElement;
    const progress = document.getElementById("storyProgress") as HTMLDivElement;
    const slidesHost = document.getElementById("storySlides") as HTMLDivElement;
    const chromeYear = document.getElementById("storyChromeYear") as HTMLSpanElement;
    const closeBtn = document.getElementById("storyClose") as HTMLButtonElement;

    let player: StoryPlayer | null = null;
    let cancelCounters: Array<() => void> = [];
    const recapCache = new Map<number, Recap>();
    let openToken = 0;
    let visibleRecap: Recap | null = null;
    onPathsUpdated([/^\/data\/recap-\d+\.json$/], () => recapCache.clear());
    // Media is optional: enrich the existing slides without restarting the
    // player, counters, phase, or progress when those larger datasets arrive.
    function updateStoryMedia() {
      if (!visibleRecap || viewer.hidden) return;
      const stories = buildStories(visibleRecap);
      slidesHost.querySelectorAll<HTMLElement>('.story-slide').forEach((slide, index) => {
        const story = stories[index];
        if (!story) return;
        if (story.style) slide.style.cssText = story.style;
        const template = document.createElement('template');
        template.innerHTML = story.html;
        const covers = template.content.querySelectorAll('.story-hero-art, .story-runner-art');
        slide.querySelectorAll('.story-hero-art, .story-runner-art').forEach((cover, i) => {
          const next = covers[i];
          const nextSource = next?.querySelector('img')?.getAttribute('src');
          if (!nextSource || cover.querySelector('img')?.getAttribute('src') === nextSource) return;
          disposeArtworkImages(cover);
          cover.innerHTML = next.innerHTML;
          initArtworkImages(cover);
        });
        const background = slide.querySelector('.story-bg');
        if (background && story.backdrop && background.querySelector('img')?.getAttribute('src') !== story.backdrop) {
          const image = document.createElement('img');
          image.src = story.backdrop; image.alt = ''; image.decoding = 'async';
          background.querySelector('img')?.remove();
          background.prepend(image);
        }
      });
    }
    onPathsUpdated(['/data/artwork.json', '/data/colors.json'], updateStoryMedia);
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Bumped on every phase change, so a hand-off still mid-fade when the next
    // one starts (fast double tap) abandons itself instead of fighting it.
    let stepToken = 0;

    /**
     * Switches a ranked slide between its phases. The cover is FLIPped from its
     * old box to its new one so it visibly shrinks into the header card (or
     * grows back out of it); the text can't be scaled cleanly across a reflow,
     * so it fades out, and the new layout's text fades in from where the old
     * text sat.
     */
    async function applyStep(slide: HTMLElement, step: number, animate: boolean) {
      const token = ++stepToken;
      if (!animate || reduceMotion) {
        slide.dataset.step = String(step);
        return;
      }

      const movers = [...slide.querySelectorAll<HTMLElement>("[data-flip]")];
      const texts = [...slide.querySelectorAll<HTMLElement>("[data-fade]")];
      const faders = texts.filter((el) => el.offsetParent !== null);

      await Promise.all(
        faders.map(
          (el) =>
            el.animate([{ opacity: 1 }, { opacity: 0, transform: "scale(0.96)" }], {
              duration: STEP_FADE_MS,
              easing: "ease-in",
              fill: "forwards",
            }).finished.catch(() => undefined),
        ),
      );
      if (token !== stepToken || !slide.classList.contains("is-active")) {
        for (const el of faders) el.getAnimations().forEach((a) => a.cancel());
        return;
      }

      const before = movers.map((el) => el.getBoundingClientRect());
      const radiusBefore = movers.map((el) => getComputedStyle(el).borderTopLeftRadius);
      const textBefore = texts.map((el) => el.getBoundingClientRect());
      slide.dataset.step = String(step);
      for (const el of faders) el.getAnimations().forEach((a) => a.cancel());

      movers.forEach((el, i) => {
        const from = before[i];
        const to = el.getBoundingClientRect();
        if (!from.width || !to.width) return;
        const scale = from.width / to.width;
        // The corner radius is scaled along with the box, so counter-scale it
        // or the first frame shows the new radius blown up (14px reads as ~50px)
        // and the corners visibly pop. Percentages (round artists) scale fine.
        const r0 = radiusBefore[i];
        const r1 = getComputedStyle(el).borderTopLeftRadius;
        const radius = r0.endsWith("px") && r1.endsWith("px")
          ? [`${parseFloat(r0) / scale}px`, r1]
          : [r1, r1];
        el.animate(
          [
            {
              transformOrigin: "top left",
              transform: `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${scale})`,
              borderRadius: radius[0],
            },
            { transformOrigin: "top left", transform: "none", borderRadius: radius[1] },
          ],
          { duration: STEP_MOVE_MS, easing: STEP_EASING },
        );
      });

      texts.forEach((el, i) => {
        if (el.offsetParent === null) return;
        // Starts a third of the way back toward where this text sat in the old
        // layout; text that was hidden there just rises into place.
        const from = textBefore[i];
        const to = el.getBoundingClientRect();
        const dx = from.width ? (from.left - to.left) * 0.35 : 0;
        const dy = from.width ? (from.top - to.top) * 0.35 : 12;
        el.animate(
          [
            { opacity: 0, transform: `translate(${dx}px, ${dy}px)` },
            { opacity: 1, transform: "none" },
          ],
          { duration: STEP_MOVE_MS, delay: 80, easing: STEP_EASING, fill: "backwards" },
        );
      });
    }

    /** Count-ups start with the slide, so the number lands with the reveal. */
    function runCounters(slide: HTMLElement) {
      for (const cancel of cancelCounters) cancel();
      cancelCounters = [];

      for (const el of slide.querySelectorAll<HTMLElement>(".story-counter")) {
        const target = Number(el.dataset.countTo ?? "0");
        const finalText = el.dataset.countText ?? String(target);
        if (!Number.isFinite(target) || target <= 0) {
          el.textContent = finalText;
          continue;
        }
        cancelCounters.push(
          rafTween(
            0,
            target,
            COUNT_UP_MS,
            (value) => {
              el.textContent = Math.round(value).toLocaleString();
            },
            () => {
              el.textContent = finalText;
            },
          ),
        );
      }
    }

    function closeViewer() {
      openToken++;
      visibleRecap = null;
      for (const cancel of cancelCounters) cancel();
      cancelCounters = [];
      player?.stop();
      player?.destroy();
      player = null;
      viewer.hidden = true;
      disposeArtworkImages(slidesHost);
      stage.style.transform = "";
      stage.style.opacity = "";
      setOverlayOpen("story", false);
    }

    async function openYear(year: number) {
      const token = ++openToken;
      void loadArtworkCache().catch(error => console.warn('Recap artwork unavailable', error));
      void loadColorsCache().catch(error => console.warn('Recap colors unavailable', error));
      let recap = recapCache.get(year);
      if (!recap) {
        const payload = await fetchAppJson<Recap>(`/data/recap-${year}.json`);
        if (token !== openToken) return;
        recap = payload;
        recapCache.set(year, recap);
      }

      if (token !== openToken) return;
      visibleRecap = recap;
      disposeArtworkImages(slidesHost);
      slidesHost.replaceChildren();
      const slides = buildStories(recap).map((story) => {
        const slide = document.createElement("div");
        slide.className = "story-slide";
        slide.dataset.tone = story.tone;
        if (story.steps && story.steps > 1) {
          slide.dataset.steps = String(story.steps);
          slide.dataset.step = "0";
        }
        if (story.style) slide.style.cssText = story.style;
        slide.innerHTML = backgroundHTML(story.backdrop) + story.html;
        slidesHost.append(slide);
        return slide;
      });

      initArtworkImages(slidesHost);
      chromeYear.textContent = String(year);
      // Every slide's gradients, chart colours and accents read off these.
      applyRecapTheme(viewer, year);
      viewer.hidden = false;
      // Stories set no body class, so pull-to-refresh and the nav drag only
      // learn about them through the shared overlay state.
      setOverlayOpen("story", true);

      player?.destroy();
      player = createStoryPlayer({
        root: stage,
        progressBar: progress,
        slides,
        durationMs: STORY_DURATION_MS,
        onEnter: (_, slide) => runCounters(slide),
        onStep: (slide, step, animate) => void applyStep(slide, step, animate),
        onExit: closeViewer,
        onComplete: closeViewer,
      });
      player.start(0);
    }

    window.addEventListener(RECAP_OPEN_EVENT, (event) => {
      const year = (event as CustomEvent<{ year: number }>).detail?.year;
      if (year) {
        const request = openYear(year), token = openToken;
        void request.catch(error => { if (token === openToken) { console.warn("Unable to open recap", error); closeViewer(); } });
      }
    });

    // Stops the tap from also reaching the stage and advancing the story.
    closeBtn.addEventListener("pointerdown", (event) => event.stopPropagation());
    closeBtn.addEventListener("click", (event) => {
      event.stopPropagation();
      closeViewer();
    });
  });
</script>
