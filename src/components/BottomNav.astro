---
import { TAB_ORDER } from "../utils/tabs";
import { lensRefractionCss } from "../utils/tabTheme";

// Same pattern as the wash in Layout.astro: the resting layer is chosen by
// CSS from body[data-active-tab], and navBar.ts only writes opacity mid-drag.
// The pill's slot comes from the same attribute, so it is in place on first
// paint rather than appearing when navBar.ts hydrates.
const lensStyles = TAB_ORDER.map((tab, i) =>
  `.lens-refraction[data-tab="${tab}"]{background:${lensRefractionCss(tab)}}` +
  `body[data-active-tab="${tab}"] .lens-refraction[data-tab="${tab}"]{opacity:1}` +
  `body[data-active-tab="${tab}"] .nav-slider-highlight{--nav-i:${i}}`,
).join("");
---

<style is:inline set:html={lensStyles}></style>

<nav class="bottom-nav-container">
  <div class="main-tab-bar">
    <div class="nav-slider-highlight sliding-highlight" id="navSliderHighlight">
      <div class="pill-face" aria-hidden="true"></div>
      <div class="lens-refraction-stack" aria-hidden="true">
        {TAB_ORDER.map((tab) => <div class="lens-refraction" data-tab={tab}></div>)}
      </div>
    </div>
    <button class="tab-btn active" data-tab="dashboard" aria-label="Home">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="3" width="7" height="9"></rect>
        <rect x="14" y="3" width="7" height="5"></rect>
        <rect x="14" y="12" width="7" height="9"></rect>
        <rect x="3" y="16" width="7" height="5"></rect>
      </svg>
      <span class="tab-label">Home</span>
    </button>

    <button class="tab-btn" data-tab="rankings" aria-label="Rankings">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
      <span class="tab-label">Rankings</span>
    </button>

    <button class="tab-btn" data-tab="recents" aria-label="Recent Plays">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span class="tab-label">Recents</span>
    </button>

    <button class="tab-btn" data-tab="statistics" aria-label="Stats">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
      </svg>
      <span class="tab-label">Stats</span>
    </button>
  </div>
</nav>

<style>
  .bottom-nav-container {
    /* Clear glass, as iOS 26 draws it: a faint neutral lift over whatever is
       behind (iOS lifts ~15 levels over black; this sits a touch darker) and
       a modest blur. What shows
       through is slightly desaturated, so the tab's wash reads as glass
       rather than tinting the bar; the dark selected capsule reads against it. */
    --nav-glass-tint: rgba(255, 255, 255, 0.05);
    --nav-glass-blur: blur(12px) saturate(75%) brightness(0.85);
    position: fixed;
    bottom: calc(-1 * var(--standalone-bottom-offset, 0px));
    left: 0;
    right: 0;
    /* Horizontal padding matches .panel-section so the bar lines up with the
       cards above it. */
    padding: 0 calc(10px + env(safe-area-inset-right))
      calc(var(--nav-bar-gap) + env(safe-area-inset-bottom))
      calc(10px + env(safe-area-inset-left));
    z-index: var(--z-nav);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    touch-action: pan-y;
  }

  @media (max-width: 767px) {
    .bottom-nav-container {
      pointer-events: auto;
      touch-action: none;
    }

    /* Cards above are full width, so the bar is too. */
    .main-tab-bar {
      max-width: none;
    }
  }

  .main-tab-bar {
    width: 100%;
    max-width: none;
    height: var(--nav-bar-height);
    display: flex;
    align-items: center;
    gap: 4px;
    /* Capsule: the radius follows the bar height, and the 8px inset keeps the
       highlight pill concentric with it. */
    border-radius: var(--radius-pill);
    background: var(--nav-glass-tint);
    /* iOS keeps the bar's edge faint: a hairline that catches a little
       light along the top and less along the bottom. */
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.11),
      inset 0 -1px 0 rgba(255, 255, 255, 0.035),
      inset 0 0 12px rgba(255, 255, 255, 0.02),
      0 10px 28px rgba(0, 0, 0, 0.36),
      0 2px 6px rgba(0, 0, 0, 0.18);
    /* A 5px inset makes the pill ~84% of the bar's height, as on iOS. */
    padding: 5px;
    pointer-events: auto;
    position: relative;
    z-index: 1;
    /* navBar.ts swells the whole bar about its centre while it is touched. */
    transform-origin: 50% 50%;
    backdrop-filter: var(--nav-glass-blur);
    -webkit-backdrop-filter: var(--nav-glass-blur);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .main-tab-bar {
      background: rgba(40, 40, 44, 0.94);
    }
  }

  /* Colour is driven by a single inherited `color`, so the icon, label and
     glow can be interpolated together by navBar.ts during a drag. */
  .tab-btn {
    --btn-accent: var(--text-primary);
    background: none;
    border: none;
    outline: none;
    color: var(--text-secondary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex: 1 1 0;
    min-width: 0;
    height: 52px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color var(--duration-nav) var(--ios-spring);
    position: relative;
    z-index: 2;
    -webkit-tap-highlight-color: transparent;
  }

  /* JS drives colour frame by frame while animating; CSS must not smear it. */
  .main-tab-bar.nav-animating .tab-btn,
  .main-tab-bar.nav-animating .tab-icon {
    transition: none;
  }


  .tab-icon {
    width: 20px;
    height: 20px;
    color: inherit;
    /* text-shadow on the button covers the glow — SVG filter:drop-shadow is
       far more expensive when colour interpolates every frame. */
    flex-shrink: 0;
  }

  .tab-label {
    font-size: 10px;
    font-weight: 500;
    font-family: var(--font-body);
    color: inherit;
  }

  .tab-btn[data-tab="dashboard"] {
    --btn-accent: var(--accent-pink);
    --btn-accent-glow: var(--accent-pink-glow);
  }

  .tab-btn[data-tab="rankings"] {
    --btn-accent: var(--accent-cyan);
    --btn-accent-glow: var(--accent-cyan-glow);
  }
  .tab-btn[data-tab="recents"] {
    --btn-accent: var(--accent-violet);
    --btn-accent-glow: var(--accent-violet-glow);
  }
  .tab-btn[data-tab="statistics"] {
    --btn-accent: var(--accent-green);
    --btn-accent-glow: var(--accent-green-glow);
  }

  .tab-btn.active {
    color: var(--btn-accent);
  }

  /* The host only carries geometry: slidingHighlight.ts pins its transition
     to none, so anything that has to fade lives on a child layer instead. */
  .nav-slider-highlight {
    border-radius: var(--radius-pill);
  }

  /* Pre-hydration pose of the pill over tab --nav-i. Only properties that
     track.render() writes inline, so navBar.ts takes over without a jump:
     a 1px border and 5px padding around four equal tabs with 4px gaps. */
  .nav-slider-highlight {
    width: calc((100% - 22px) / 4);
    height: 52px;
    transform: translate3d(
      calc(5px + var(--nav-i, 0) * (100% + 4px)),
      calc((var(--nav-bar-height) - 54px) / 2),
      0
    );
  }

  /* Resting pill: a dark capsule pressed into the glass, as iOS draws the
     selected tab; colour stays on the icon and label. Its fill clears while
     the pill travels as glass and when it lifts (--face, written every
     frame by navBar.ts). */
  .pill-face {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgba(0, 0, 0, 0.5);
    box-shadow: inset 0 1px 1.5px rgba(0, 0, 0, 0.22);
    opacity: var(--face, 1);
  }

  .main-tab-bar.nav-dragging {
    cursor: grabbing;
  }

  /* ── Liquid-glass lens ──────────────────────────────────────────────────
     While the pill is being dragged (or travelling after a tap) it lifts
     into a clear lens: navBar.ts scales it past the bar's edges and
     liquidGlass.ts refracts the tabs underneath. The tint drops away so the lens reads as clear
     glass; the rim and glare are pseudo-elements so they can fade, since
     slidingHighlight.ts pins the host's own transition to none. */
  .nav-slider-highlight::before,
  .nav-slider-highlight::after,
  .lens-refraction-stack {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    /* Follows the lift spring frame by frame, so glass and pill never part. */
    opacity: var(--lens, 0);
    /* Keeps these layers rasterised while invisible, so the first frame of a
       press only changes opacity instead of painting gradients and masks. */
    will-change: opacity;
  }

  /* The lens body: clear glass plus the refraction layers, under the rim and
     glare. Fading this (not the host) is what lets the lens ease in and out. */
  /* Nearly clear: the refracted tabs carry the look, so the body adds only
     a lift shadow and the thin bright edges of a thick glass slab. */
  .lens-refraction-stack {
    z-index: 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
    /* As iOS draws a lifted lens: clear, edged by a thin dark line and dark
       bands where it bends what lies past the bar, with only a hairline of
       light. */
    box-shadow:
      0 4px 14px rgba(0, 0, 0, 0.2),
      0 0 0 0.75px rgba(0, 0, 0, 0.6),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.14),
      inset 0 6px 6px -4px rgba(0, 0, 0, 0.45),
      inset 0 -6px 6px -4px rgba(0, 0, 0, 0.45);
  }

  .nav-slider-highlight::before {
    z-index: 1;
  }

  .nav-slider-highlight::after {
    z-index: 2;
  }

  /* One pre-built layer per tab (see lensStyles above); only opacity moves. */
  .lens-refraction {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  /* Chromatic rim: light splitting where the glass bends most. As on iOS
     it gathers along the top and bottom edges (a ring thicker there than at
     the ends) and runs through the spectrum across the lens. */
  .nav-slider-highlight::before {
    padding: 1.75px 0.5px;
    background: linear-gradient(
      90deg,
      rgba(255, 130, 200, 0.42),
      rgba(255, 220, 150, 0.3) 25%,
      rgba(120, 240, 190, 0.42) 50%,
      rgba(110, 170, 255, 0.45) 75%,
      rgba(210, 140, 255, 0.42)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  /* Glare: a bright crescent along the top and a fainter one at the bottom,
     plus coloured fringes bleeding inward from the sides. The crescent and
     the rim's hue slide with the lens's speed (liquidGlass.ts). */
  .nav-slider-highlight::after {
    background:
      radial-gradient(55% 34% at var(--lens-glint-x, 50%) 0%, rgba(255, 255, 255, 0.16), transparent 72%),
      radial-gradient(45% 28% at calc(100% - var(--lens-glint-x, 50%)) 100%, rgba(255, 255, 255, 0.08), transparent 72%);
    box-shadow:
      inset 6px 0 10px -8px rgba(255, 130, 175, 0.24),
      inset -6px 0 10px -8px rgba(120, 215, 255, 0.24);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-slider-highlight::before,
    .nav-slider-highlight::after,
    .lens-refraction-stack {
      display: none;
    }
  }

  /* Must not apply to the selected tab: a tap leaves :hover stuck on touch
     devices, which was overriding the accent colour after the animation. */
  @media (hover: hover) and (pointer: fine) {
    .tab-btn:not(.active):hover {
      color: var(--text-primary);
    }
  }

  @media (min-width: 768px) {
    .bottom-nav-container {
      width: 180px;
      height: fit-content;
      position: fixed;
      top: 50%;
      bottom: auto;
      left: calc(24px + env(safe-area-inset-left));
      right: auto;
      transform: translateY(-50%);
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      padding: 16px;
      background: var(--nav-glass-tint);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-xl);
      box-shadow:
        var(--glass-rim),
        0 14px 40px rgba(0, 0, 0, 0.42);
      backdrop-filter: var(--nav-glass-blur);
      -webkit-backdrop-filter: var(--nav-glass-blur);
      pointer-events: auto;
      touch-action: none;
    }

    .main-tab-bar {
      flex-direction: column;
      background: transparent;
      border-radius: 0;
      border: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      width: 100%;
      gap: 8px;
      padding: 0;
      height: auto;
      justify-content: flex-start;
      align-items: stretch;
      position: relative;
    }

    .tab-btn {
      width: 100%;
      height: 48px;
      border-radius: var(--radius-pill);
      padding: 0 16px;
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 12px;
      flex: none;
    }

    .tab-label {
      font-size: 15px;
      font-weight: 500;
      display: block;
    }

    /* Sidebar: full-width 48px tabs, 8px apart, no padding. */
    .nav-slider-highlight {
      width: 100%;
      transform: translate3d(0, calc(var(--nav-i, 0) * 56px), 0);
    }
  }
</style>

<script>
  import { onReady } from "../utils/dom";
  import { initNavBar } from "../utils/navBar";

  onReady(initNavBar);
</script>
