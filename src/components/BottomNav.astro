---
import { TAB_ORDER } from "../utils/tabs";
import { lensRefractionCss } from "../utils/tabTheme";

// Same pattern as the wash in Layout.astro: the resting layer is chosen by
// CSS from body[data-active-tab], and navBar.ts only writes opacity mid-drag.
const lensStyles = TAB_ORDER.map(
  (tab) =>
    `.lens-refraction[data-tab="${tab}"]{background:${lensRefractionCss(tab)}}` +
    `body[data-active-tab="${tab}"] .lens-refraction[data-tab="${tab}"]{opacity:1}`,
).join("");
---

<style is:inline set:html={lensStyles}></style>

<nav class="bottom-nav-container">
  <div class="main-tab-bar">
    <div class="nav-slider-highlight sliding-highlight" id="navSliderHighlight">
      <div class="pill-face" aria-hidden="true"></div>
      <div class="lens-refraction-stack" aria-hidden="true">
        {TAB_ORDER.map((tab) => <div class="lens-refraction" data-tab={tab}></div>)}
      </div>
    </div>
    <button class="tab-btn active" data-tab="dashboard" aria-label="Home">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="3" width="7" height="9"></rect>
        <rect x="14" y="3" width="7" height="5"></rect>
        <rect x="14" y="12" width="7" height="9"></rect>
        <rect x="3" y="16" width="7" height="5"></rect>
      </svg>
      <span class="tab-label">Home</span>
    </button>

    <button class="tab-btn" data-tab="rankings" aria-label="Rankings">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
      <span class="tab-label">Rankings</span>
    </button>

    <button class="tab-btn" data-tab="recents" aria-label="Recent Plays">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span class="tab-label">Recents</span>
    </button>

    <button class="tab-btn" data-tab="statistics" aria-label="Stats">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
      </svg>
      <span class="tab-label">Stats</span>
    </button>
  </div>
</nav>

<style>
  .bottom-nav-container {
    --nav-glass-tint: rgba(10, 10, 14, 0.34);
    --nav-glass-blur: blur(18px) saturate(190%) brightness(0.72);
    position: fixed;
    bottom: calc(-1 * var(--standalone-bottom-offset, 0px));
    left: 0;
    right: 0;
    /* Horizontal padding matches .panel-section so the bar lines up with the
       cards above it. */
    padding: 0 calc(10px + env(safe-area-inset-right))
      calc(var(--nav-bar-gap) + env(safe-area-inset-bottom))
      calc(10px + env(safe-area-inset-left));
    z-index: var(--z-nav);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    touch-action: pan-y;
  }

  @media (max-width: 767px) {
    .bottom-nav-container {
      pointer-events: auto;
      touch-action: none;
    }

    /* Cards above are full width, so the bar is too. */
    .main-tab-bar {
      max-width: none;
    }
  }

  .main-tab-bar {
    width: 100%;
    max-width: none;
    height: var(--nav-bar-height);
    display: flex;
    align-items: center;
    gap: 4px;
    /* Capsule: the radius follows the bar height, and the 8px inset keeps the
       highlight pill concentric with it. */
    border-radius: var(--radius-pill);
    /* Smoked glass: a low-alpha dark tint, with the backdrop itself dimmed
       and saturated, so what is behind reads through as colour rather
       than as a milky white sheet. */
    background: var(--nav-glass-tint);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 -1px 0 rgba(255, 255, 255, 0.04),
      0 14px 40px rgba(0, 0, 0, 0.42),
      0 2px 6px rgba(0, 0, 0, 0.2);
    padding: 8px;
    pointer-events: auto;
    position: relative;
    z-index: 1;
    backdrop-filter: var(--nav-glass-blur);
    -webkit-backdrop-filter: var(--nav-glass-blur);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .main-tab-bar {
      background: rgba(14, 14, 18, 0.92);
    }
  }

  /* Colour is driven by a single inherited `color`, so the icon, label and
     glow can be interpolated together by navBar.ts during a drag. */
  .tab-btn {
    --btn-accent: var(--text-primary);
    --btn-glow: transparent;
    background: none;
    border: none;
    outline: none;
    color: var(--text-secondary);
    text-shadow: 0 0 10px var(--btn-glow);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex: 1 1 0;
    min-width: 0;
    height: 48px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      color var(--duration-nav) var(--ios-spring),
      text-shadow var(--duration-nav) var(--ios-spring);
    position: relative;
    z-index: 2;
    -webkit-tap-highlight-color: transparent;
  }

  /* JS drives colour frame by frame while animating; CSS must not smear it. */
  .main-tab-bar.nav-animating .tab-btn,
  .main-tab-bar.nav-animating .tab-icon {
    transition: none;
  }


  .tab-icon {
    width: 20px;
    height: 20px;
    color: inherit;
    /* text-shadow on the button covers the glow — SVG filter:drop-shadow is
       far more expensive when colour interpolates every frame. */
    flex-shrink: 0;
  }

  .tab-label {
    font-size: 10px;
    font-weight: 500;
    font-family: var(--font-body);
    color: inherit;
  }

  .tab-btn[data-tab="dashboard"] {
    --btn-accent: var(--accent-pink);
    --btn-accent-glow: var(--accent-pink-glow);
  }

  .tab-btn[data-tab="rankings"] {
    --btn-accent: var(--accent-cyan);
    --btn-accent-glow: var(--accent-cyan-glow);
  }
  .tab-btn[data-tab="recents"] {
    --btn-accent: var(--accent-violet);
    --btn-accent-glow: var(--accent-violet-glow);
  }
  .tab-btn[data-tab="statistics"] {
    --btn-accent: var(--accent-green);
    --btn-accent-glow: var(--accent-green-glow);
  }

  .tab-btn.active {
    color: var(--btn-accent);
    --btn-glow: var(--btn-accent-glow);
  }

  /* The host only carries geometry: slidingHighlight.ts pins its transition
     to none, so anything that has to fade lives on a child layer instead. */
  .nav-slider-highlight {
    border-radius: var(--radius-pill);
  }

  /* Resting pill: a lighter glass droplet sitting inside the bar. It fades
     out as the lens lifts and eases back in as the lens settles. */
  .pill-face {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    transition: opacity var(--duration-slow) var(--ios-spring);
    background: color-mix(
      in srgb,
      var(--hl-color, rgba(255, 255, 255, 0.25)) 16%,
      rgba(255, 255, 255, 0.07)
    );
    border: 1px solid
      color-mix(
        in srgb,
        var(--hl-color, rgba(255, 255, 255, 0.35)) 28%,
        rgba(255, 255, 255, 0.12)
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(255, 255, 255, 0.04),
      0 2px 12px var(--hl-glow, rgba(0, 0, 0, 0.45));
  }

  .main-tab-bar.nav-dragging {
    cursor: grabbing;
  }

  /* ── Liquid-glass lens ──────────────────────────────────────────────────
     While the pill is being dragged (or travelling after a tap) it lifts
     into a clear lens: navBar.ts scales it past the bar's edges and enlarges
     the icon underneath. The tint drops away so the lens reads as clear
     glass; the rim and glare are pseudo-elements so they can fade, since
     slidingHighlight.ts pins the host's own transition to none. */
  .nav-slider-highlight::before,
  .nav-slider-highlight::after,
  .lens-refraction-stack {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ios-spring);
    /* Keeps these layers rasterised while invisible, so the first frame of a
       drag only changes opacity instead of painting gradients and masks. */
    will-change: opacity;
  }

  /* The lens body: clear glass plus the refraction layers, under the rim and
     glare. Fading this (not the host) is what lets the lens ease in and out. */
  .lens-refraction-stack {
    z-index: 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
  }

  .nav-slider-highlight::before {
    z-index: 1;
  }

  .nav-slider-highlight::after {
    z-index: 2;
  }

  /* One pre-built layer per tab (see lensStyles above); only opacity moves. */
  .lens-refraction {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  /* Chromatic rim: a conic spectrum masked down to a thin ring, softened so
     it reads as light splitting at the glass edge. */
  .nav-slider-highlight::before {
    padding: 1.5px;
    background: conic-gradient(
      from 200deg,
      rgba(255, 140, 185, 0.22),
      rgba(255, 220, 160, 0.14),
      rgba(150, 225, 255, 0.22),
      rgba(185, 165, 255, 0.18),
      rgba(255, 140, 185, 0.22)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  /* Glare: a bright crescent along the top and a fainter one at the bottom,
     plus coloured fringes bleeding inward from the sides. */
  .nav-slider-highlight::after {
    background:
      radial-gradient(120% 60% at 50% -10%, rgba(255, 255, 255, 0.14), transparent 60%),
      radial-gradient(100% 40% at 50% 112%, rgba(255, 255, 255, 0.07), transparent 60%);
    box-shadow:
      inset 5px 0 9px -6px rgba(255, 130, 175, 0.2),
      inset -5px 0 9px -6px rgba(120, 215, 255, 0.2);
  }

  /* The face drops away quickly so the lift feels immediate; its slow
     return is the default transition above. */
  .main-tab-bar.nav-lens .pill-face {
    opacity: 0;
    transition-duration: var(--duration-normal);
  }

  .main-tab-bar.nav-lens .nav-slider-highlight::before,
  .main-tab-bar.nav-lens .nav-slider-highlight::after,
  .main-tab-bar.nav-lens .lens-refraction-stack {
    opacity: 1;
    transition-duration: var(--duration-normal);
  }

  /* Leaving lens mode crossfades on the same slow curve as the face. */
  .nav-slider-highlight::before,
  .nav-slider-highlight::after,
  .lens-refraction-stack {
    transition-duration: var(--duration-slow);
  }

  /* navBar.ts writes a per-button --lens-mag while the lens is up. */
  .tab-btn .tab-icon,
  .tab-btn .tab-label {
    transform: scale(var(--lens-mag, 1));
    transform-origin: 50% 60%;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-slider-highlight::before,
    .nav-slider-highlight::after,
    .lens-refraction-stack {
      display: none;
    }
  }

  /* Must not apply to the selected tab: a tap leaves :hover stuck on touch
     devices, which was overriding the accent colour after the animation. */
  @media (hover: hover) and (pointer: fine) {
    .tab-btn:not(.active):hover {
      color: var(--text-primary);
    }
  }

  @media (min-width: 768px) {
    .bottom-nav-container {
      width: 180px;
      height: fit-content;
      position: fixed;
      top: 50%;
      bottom: auto;
      left: calc(24px + env(safe-area-inset-left));
      right: auto;
      transform: translateY(-50%);
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      padding: 16px;
      background: var(--nav-glass-tint);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-xl);
      box-shadow:
        var(--glass-rim),
        0 14px 40px rgba(0, 0, 0, 0.42);
      backdrop-filter: var(--nav-glass-blur);
      -webkit-backdrop-filter: var(--nav-glass-blur);
      pointer-events: auto;
      touch-action: none;
    }

    .main-tab-bar {
      flex-direction: column;
      background: transparent;
      border-radius: 0;
      border: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      width: 100%;
      gap: 8px;
      padding: 0;
      height: auto;
      justify-content: flex-start;
      align-items: stretch;
      position: relative;
    }

    .tab-btn {
      width: 100%;
      height: 48px;
      border-radius: var(--radius-pill);
      padding: 0 16px;
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 12px;
      flex: none;
    }

    .tab-label {
      font-size: 15px;
      font-weight: 500;
      display: block;
    }
  }
</style>

<script>
  import { onReady } from "../utils/dom";
  import { initNavBar } from "../utils/navBar";

  onReady(initNavBar);
</script>
