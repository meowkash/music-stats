---
---

<nav class="bottom-nav-container">
  <div class="main-tab-bar">
    <div class="nav-slider-highlight sliding-highlight" id="navSliderHighlight"></div>
    <button class="tab-btn active" data-tab="dashboard" aria-label="Dashboard">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="3" width="7" height="9"></rect>
        <rect x="14" y="3" width="7" height="5"></rect>
        <rect x="14" y="12" width="7" height="9"></rect>
        <rect x="3" y="16" width="7" height="5"></rect>
      </svg>
      <span class="tab-label">Dashboard</span>
    </button>

    <button class="tab-btn" data-tab="recaps" aria-label="Recaps">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7-6.3-4.6L5.7 21l2.3-7-6-4.6h7.6z"></path>
      </svg>
      <span class="tab-label">Recaps</span>
    </button>

    <button class="tab-btn" data-tab="rankings" aria-label="Rankings">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
      <span class="tab-label">Rankings</span>
    </button>

    <button class="tab-btn" data-tab="recents" aria-label="Recent Plays">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span class="tab-label">Recents</span>
    </button>

    <button class="tab-btn" data-tab="statistics" aria-label="Statistics">
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
      </svg>
      <span class="tab-label">Statistics</span>
    </button>
  </div>
</nav>

<style>
  .bottom-nav-container {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    /* Horizontal padding matches .panel-section so the bar lines up with the
       cards above it. */
    padding: 0 calc(10px + env(safe-area-inset-right))
      calc(var(--nav-bar-gap) + env(safe-area-inset-bottom))
      calc(10px + env(safe-area-inset-left));
    z-index: var(--z-nav);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    touch-action: pan-y;
  }

  @media (max-width: 767px) {
    .bottom-nav-container {
      pointer-events: auto;
      touch-action: none;
    }

    /* Cards above are full width, so the bar is too. */
    .main-tab-bar {
      max-width: none;
    }
  }

  .main-tab-bar {
    width: 100%;
    max-width: 500px;
    height: var(--nav-bar-height);
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* Matches the card/sheet radius language used across the app */
    border-radius: var(--radius-xl);
    /* Minimal tint — blur samples whatever is actually behind */
    background: rgba(14, 14, 18, 0.38);
    border: 1px solid var(--panel-border-hover);
    box-shadow:
      0 12px 36px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    padding: 8px;
    pointer-events: auto;
    position: relative;
    z-index: 1;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .main-tab-bar {
      background: rgba(14, 14, 18, 0.92);
    }
  }

  /* Colour is driven by a single inherited `color`, so the icon, label and
     glow can be interpolated together by navBar.ts during a drag. */
  .tab-btn {
    --btn-accent: var(--text-primary);
    --btn-glow: transparent;
    background: none;
    border: none;
    outline: none;
    color: var(--text-secondary);
    text-shadow: 0 0 10px var(--btn-glow);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex: 1;
    height: 48px;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      color var(--duration-nav) var(--ios-spring),
      text-shadow var(--duration-nav) var(--ios-spring);
    position: relative;
    z-index: 2;
    -webkit-tap-highlight-color: transparent;
  }

  /* JS drives colour frame by frame while animating; CSS must not smear it. */
  .main-tab-bar.nav-animating .tab-btn,
  .main-tab-bar.nav-animating .tab-icon {
    transition: none;
  }


  .tab-icon {
    width: 20px;
    height: 20px;
    color: inherit;
    /* text-shadow on the button covers the glow — SVG filter:drop-shadow is
       far more expensive when colour interpolates every frame. */
    flex-shrink: 0;
  }

  .tab-label {
    font-size: 10px;
    font-weight: 500;
    font-family: var(--font-body);
    color: inherit;
  }

  .tab-btn[data-tab="dashboard"] {
    --btn-accent: var(--accent-pink);
    --btn-accent-glow: var(--accent-pink-glow);
  }
  .tab-btn[data-tab="recaps"] {
    --btn-accent: var(--accent-yellow);
    --btn-accent-glow: var(--accent-yellow-glow);
  }
  .tab-btn[data-tab="rankings"] {
    --btn-accent: var(--accent-cyan);
    --btn-accent-glow: var(--accent-cyan-glow);
  }
  .tab-btn[data-tab="recents"] {
    --btn-accent: var(--accent-violet);
    --btn-accent-glow: var(--accent-violet-glow);
  }
  .tab-btn[data-tab="statistics"] {
    --btn-accent: var(--accent-green);
    --btn-accent-glow: var(--accent-green-glow);
  }

  .tab-btn.active {
    color: var(--btn-accent);
    --btn-glow: var(--btn-accent-glow);
  }

  .nav-slider-highlight {
    border-radius: var(--radius-md);
    background: color-mix(
      in srgb,
      var(--hl-color, rgba(255, 255, 255, 0.25)) 14%,
      rgba(0, 0, 0, 0.35)
    );
    border: 1px solid
      color-mix(
        in srgb,
        var(--hl-color, rgba(255, 255, 255, 0.35)) 30%,
        rgba(255, 255, 255, 0.06)
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 2px 10px var(--hl-glow, rgba(0, 0, 0, 0.45));
  }

  /* Liquid-glass grab state */
  .main-tab-bar.nav-dragging .nav-slider-highlight {
    background: color-mix(
      in srgb,
      var(--hl-color, rgba(255, 255, 255, 0.25)) 22%,
      rgba(0, 0, 0, 0.28)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 6px 22px var(--hl-glow, rgba(0, 0, 0, 0.45));
  }

  .main-tab-bar.nav-dragging {
    cursor: grabbing;
  }

  /* Must not apply to the selected tab: a tap leaves :hover stuck on touch
     devices, which was overriding the accent colour after the animation. */
  @media (hover: hover) and (pointer: fine) {
    .tab-btn:not(.active):hover {
      color: var(--text-primary);
    }
  }

  @media (min-width: 768px) {
    .bottom-nav-container {
      width: 180px;
      height: fit-content;
      position: fixed;
      top: 50%;
      bottom: auto;
      left: calc(24px + env(safe-area-inset-left));
      right: auto;
      transform: translateY(-50%);
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      padding: 16px;
      background: rgba(14, 14, 18, 0.38);
      border: 1px solid var(--panel-border-hover);
      border-radius: var(--radius-xl);
      box-shadow:
        0 12px 36px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(14px) saturate(140%);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
      pointer-events: auto;
      touch-action: none;
    }

    .main-tab-bar {
      flex-direction: column;
      background: transparent;
      border: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      width: 100%;
      gap: 8px;
      padding: 0;
      height: auto;
      justify-content: flex-start;
      align-items: stretch;
      position: relative;
    }

    .tab-btn {
      width: 100%;
      height: 48px;
      border-radius: var(--radius-md);
      padding: 0 16px;
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 12px;
      flex: none;
    }

    .tab-label {
      font-size: 15px;
      font-weight: 500;
      display: block;
    }
  }
</style>

<script>
  import { onReady } from "../utils/dom";
  import { initNavBar } from "../utils/navBar";

  onReady(initNavBar);
</script>
