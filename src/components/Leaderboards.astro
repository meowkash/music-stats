---
---

<div class="leaderboard-container glass-card panel-container">
  <div class="view-header">
    <h2>Rankings</h2>
    <p class="subtitle">The songs that make my world go round...</p>
  </div>

  <!-- Date Selector Section -->
  <div class="date-selector-section">
    <div class="quick-ranges" style="position: relative;">
      <div id="rangeHighlight" class="range-highlight sliding-highlight"></div>
      <button class="range-btn active" data-range="7d">7 Days</button>
      <button class="range-btn" data-range="30d">30 Days</button>
      <button class="range-btn" data-range="90d">90 Days</button>
      <button class="range-btn" data-range="year">This Year</button>
      <button class="range-btn" data-range="all">All Time</button>
      <button class="range-btn" data-range="custom">Custom</button>
    </div>

    <div class="custom-date-inputs hidden" id="customDateInputs">
      <div class="date-input-group">
        <label for="startDate">From</label>
        <input type="date" id="startDate" class="glass-input" />
      </div>
      <div class="date-input-group">
        <label for="endDate">To</label>
        <input type="date" id="endDate" class="glass-input" />
      </div>
    </div>
  </div>

  <!-- Sub-Tabs (Songs, Albums, Artists) -->
  <div class="leaderboard-tabs" style="position: relative;">
    <div id="subTabHighlight" class="sub-tab-highlight sliding-highlight"></div>
    <button class="sub-tab-btn active" data-tab="songs">Songs</button>
    <button class="sub-tab-btn" data-tab="albums">Albums</button>
    <button class="sub-tab-btn" data-tab="artists">Artists</button>
  </div>

  <!-- Search / Filter bar inside leaderboard -->
  <div class="search-bar-wrapper">
    <svg
      class="search-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="text"
      id="leaderboardSearch"
      class="glass-input search-input"
      placeholder="Search entries..."
    />
  </div>

  <!-- Leaderboard List -->
  <div class="leaderboard-list-wrapper">
    <div class="loader-wrapper hidden" id="leaderboardLoader">
      <div class="loader"></div>
      <span>Aggregating scrobbles...</span>
    </div>
    <div class="leaderboard-list" id="leaderboardList">
      <!-- List items will be injected here by client JS -->
    </div>
  </div>
</div>

<style>
  .leaderboard-container {
    /* panel-container handles layout */
  }


  /* Quick date ranges */
  .date-selector-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .quick-ranges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 12px;
  }

  .range-btn {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-smooth);
    font-family: var(--font-body);
  }

  .range-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.15);
  }

  .range-btn.active {
    color: #fff;
    border-color: transparent;
    background: transparent;
  }

  .range-highlight {
    border-radius: 20px;
    background: var(--range-color, var(--accent-pink));
    box-shadow: 0 4px 12px var(--range-glow, var(--accent-pink-glow));
  }

  /* Custom date inputs */
  .custom-date-inputs {
    display: flex;
    gap: 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: 12px;
    border-radius: 12px;
    animation: fadeIn 0.3s ease-out;
  }

  .custom-date-inputs.hidden {
    display: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .date-input-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .date-input-group label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .date-input-group input[type="date"] {
    width: 100%;
    color-scheme: dark; /* Force dark calendar popup */
  }

  /* Sub tabs */
  .leaderboard-tabs {
    display: flex;
    background: rgba(0, 0, 0, 0.2);
    padding: 4px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sub-tab-btn {
    position: relative;
    z-index: 2;
    flex: 1;
    background: none;
    border: none;
    outline: none;
    padding: 8px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-smooth);
    font-family: var(--font-body);
  }

  .sub-tab-btn.active {
    color: #fff;
  }

  .sub-tab-btn[data-tab="artists"].active {
    color: var(--accent-cat-artists);
    text-shadow: 0 0 12px var(--accent-cat-artists-glow);
  }
  .sub-tab-btn[data-tab="albums"].active {
    color: var(--accent-cat-albums);
    text-shadow: 0 0 12px var(--accent-cat-albums-glow);
  }
  .sub-tab-btn[data-tab="songs"].active {
    color: var(--accent-cat-songs);
    text-shadow: 0 0 12px var(--accent-cat-songs-glow);
  }

  .sub-tab-highlight {
    border-radius: 8px;
    background: color-mix(in srgb, var(--hl-color, rgba(255, 255, 255, 0.25)) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--hl-color, rgba(255, 255, 255, 0.4)) 40%, transparent);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.3), 0 4px 12px var(--hl-glow, rgba(0, 0, 0, 0.4));
  }

  /* Search bar */
  .search-bar-wrapper {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding-left: 38px;
    background: rgba(0, 0, 0, 0.15);
  }

  .leaderboard-list-wrapper {
    position: relative;
    min-height: 120px;
  }

  /* Invisible trigger element used for infinite-scroll chunk loading */
  .leaderboard-list :global(.leaderboard-scroll-sentinel) {
    height: 1px;
    width: 100%;
  }

  .loader-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-secondary);
    font-size: 15px;
    background: rgba(10, 10, 15, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 12px;
    z-index: 5;
    transition: opacity 0.25s ease;
  }

  .loader-wrapper.overlay {
    background: rgba(10, 10, 15, 0.5);
  }

  .leaderboard-list.updating {
    opacity: 0.55;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .loader-wrapper.hidden {
    display: none;
  }

  .loader {
    width: 28px;
    height: 28px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--accent-pink);
    border-radius: 50%;
    animation: loadingSpin 1s linear infinite;
  }

  @keyframes loadingSpin {
    to {
      transform: rotate(360deg);
    }
  }


  /* Clickable entity links inside leaderboards */
  .leaderboard-container :global(.clickable-entity) {
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .leaderboard-container :global(.clickable-entity:hover) {
    color: var(--accent-pink) !important;
  }

  @media (max-width: 767px) {
    .custom-date-inputs {
      flex-direction: column;
      gap: 10px;
    }

    .date-input-group {
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }

    .date-input-group label {
      width: 44px;
      text-align: left;
      margin-bottom: 0;
    }

    .date-input-group input[type="date"] {
      flex: 1;
    }
  }

  .leaderboard-container :global(.scrobble-count-val) {
    font-size: 15px !important;
  }
</style>

<script>
  import {
    generateScrobbleRowHTML,
    applyCountGlows,
    getArtworkUrl,
    loadArtworkCache,
    loadMetaCache,
    initArtworkImages,
    escapeHTML,
  } from "../utils/ui";
  import { fetchAppJson, onPathsUpdated } from "../utils/dataStore";
  import type { MetaData } from "../types/music";
  import {
    loadYearsData,
    getYearsInRange,
    aggregateTrackCounts,
    rollupByCategory,
  } from "../utils/scrobbles";
  import { createInfiniteScroll } from "../utils/infiniteScroll";
  import { createSlidingHighlight } from "../utils/slidingHighlight";
  import { getCategoryAccent } from "../utils/theme";
  import { bindEntityClicks } from "../utils/events";

  document.addEventListener("DOMContentLoaded", () => {
    let meta: MetaData | null = null;
    let availableYears: number[] = [];
    let artworkCache: Record<string, string> = {};

    let activeTab = "songs";
    let activeRange = "7d";
    const CHUNK_SIZE = 50;
    let fullItemsList: ReturnType<typeof rollupByCategory> = [];
    let searchQuery = "";

    const loader = document.getElementById("leaderboardLoader") as HTMLDivElement;
    const listContainer = document.getElementById("leaderboardList") as HTMLDivElement;
    const customDateContainer = document.getElementById("customDateInputs") as HTMLDivElement;
    const startDateInput = document.getElementById("startDate") as HTMLInputElement;
    const endDateInput = document.getElementById("endDate") as HTMLInputElement;
    const searchInput = document.getElementById("leaderboardSearch") as HTMLInputElement;
    const scrollRoot = listContainer.closest(".panel-section") as HTMLElement | null;

    const todayStr = new Date().toISOString().split("T")[0];
    endDateInput.value = todayStr;
    const sevenDaysAgo = new Date();
    sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
    startDateInput.value = sevenDaysAgo.toISOString().split("T")[0];

    async function loadMeta() {
      if (meta) return meta;
      try {
        const [metaResult, totals] = await Promise.all([
          loadMetaCache(),
          fetchAppJson<Record<string, number[]>>("/data/yearly-totals.json").catch(() => null),
        ]);
        meta = metaResult;
        artworkCache = await loadArtworkCache();

        if (totals) {
          availableYears = Object.keys(totals)
            .map((y) => parseInt(y, 10))
            .filter((y) => !isNaN(y));
        }

        return meta;
      } catch (err) {
        console.error("Failed to load dictionary metadata:", err);
        return null;
      }
    }

    function renderRow(item: (typeof fullItemsList)[0], index: number): string {
      let imgUrl = null;
      let infoHtml = "";
      let rowType = "";
      let rowId = 0;

      if (activeTab === "songs") {
        imgUrl = getArtworkUrl("track", item.name, item.artistName || "", item.albumName || "", artworkCache);
        rowType = "track";
        rowId = item.id;
        infoHtml = `
            <span class="scrobble-row-title">${escapeHTML(item.name)}</span>
            <span class="scrobble-row-subtitle">
              <span class="clickable-entity" data-type="album" data-id="${item.albumId}">${escapeHTML(item.albumName || "")}</span>
              • 
              <span class="clickable-entity" data-type="artist" data-id="${item.artistId}">${escapeHTML(item.artistName || "")}</span>
            </span>`;
      } else if (activeTab === "albums") {
        imgUrl = getArtworkUrl("album", item.name, item.subtitle || "", item.name, artworkCache);
        rowType = "album";
        rowId = item.id;
        infoHtml = `
            <span class="scrobble-row-title">${escapeHTML(item.name)}</span>
            <span class="scrobble-row-subtitle clickable-entity" data-type="artist" data-id="${item.artistId}">${escapeHTML(item.subtitle || "")}</span>`;
      } else {
        imgUrl = getArtworkUrl("artist", item.name, item.name, "", artworkCache);
        rowType = "artist";
        rowId = item.id;
        infoHtml = `
            <span class="scrobble-row-title">${escapeHTML(item.name)}</span>
            <span class="scrobble-row-subtitle"></span>`;
      }

      return generateScrobbleRowHTML(
        {
          type: rowType,
          id: rowId,
          rank: index + 1,
          name: item.name,
          subtitle: "",
          infoHtml,
          imgUrl: imgUrl || null,
          count: item.count,
        },
        true,
      );
    }

    const scrollController = createInfiniteScroll({
      container: listContainer,
      items: [],
      chunkSize: CHUNK_SIZE,
      renderItem: renderRow,
      root: scrollRoot,
      rootMargin: "600px 0px",
      sentinelClass: "leaderboard-scroll-sentinel",
      onChunkRendered: () => {
        initArtworkImages(listContainer);
        applyCountGlows(listContainer);
      },
    });

    async function updateLeaderboard() {
      const isFirstLoad = listContainer.children.length === 0;
      if (isFirstLoad) {
        loader.classList.remove("hidden", "overlay");
      } else {
        loader.classList.remove("hidden");
        loader.classList.add("overlay");
        listContainer.classList.add("updating");
      }

      const dictionary = await loadMeta();
      if (!dictionary) {
        loader.classList.add("hidden");
        listContainer.classList.remove("updating");
        listContainer.innerHTML = '<div class="no-data-message">Failed to load metadata</div>';
        return;
      }

      let startStr = startDateInput.value;
      let endStr = endDateInput.value;

      if (activeRange !== "custom") {
        const end = new Date();
        const start = new Date();

        if (activeRange === "7d") start.setDate(end.getDate() - 7);
        else if (activeRange === "30d") start.setDate(end.getDate() - 30);
        else if (activeRange === "90d") start.setDate(end.getDate() - 90);
        else if (activeRange === "year") start.setMonth(0, 1);
        else if (activeRange === "all") {
          const minYear = availableYears.length > 0 ? Math.min(...availableYears) : 2000;
          start.setFullYear(minYear, 0, 1);
        }

        startStr = start.toISOString().split("T")[0];
        endStr = end.toISOString().split("T")[0];
        startDateInput.value = startStr;
        endDateInput.value = endStr;
      }

      const yearsToLoad = getYearsInRange(startStr, endStr);
      await loadYearsData(yearsToLoad);

      const trackCounts = aggregateTrackCounts(yearsToLoad, startStr, endStr);
      const category = activeTab === "songs" ? "tracks" : activeTab === "albums" ? "albums" : "artists";
      let itemsList = rollupByCategory(trackCounts, dictionary, category);

      if (searchQuery) {
        const query = searchQuery.toLowerCase();
        itemsList = itemsList.filter(
          (item) =>
            item.name.toLowerCase().includes(query) ||
            (item.subtitle && item.subtitle.toLowerCase().includes(query)),
        );
      }

      itemsList.sort((a, b) => b.count - a.count);

      loader.classList.add("hidden");
      listContainer.classList.remove("updating");

      if (itemsList.length === 0) {
        fullItemsList = [];
        listContainer.innerHTML = '<div class="no-data-message">Huh, I did not listen to anything in this time. Awkward...</div>';
        return;
      }

      fullItemsList = itemsList;
      listContainer.innerHTML = "";
      scrollController.reset(itemsList);
    }

    const rangeHighlight = document.getElementById("rangeHighlight") as HTMLDivElement;
    const subTabHighlight = document.getElementById("subTabHighlight") as HTMLDivElement;

    const rangeHighlightCtrl = createSlidingHighlight({
      highlightEl: rangeHighlight,
      buttons: document.querySelectorAll(".range-btn"),
    });

    const subTabHighlightCtrl = createSlidingHighlight({
      highlightEl: subTabHighlight,
      buttons: document.querySelectorAll(".sub-tab-btn"),
      colorMap: (btn) => {
        const tabName = btn.getAttribute("data-tab") || "";
        return getCategoryAccent(tabName);
      },
      onSync: (btn) => {
        const tabName = btn.getAttribute("data-tab") || "";
        const accent = getCategoryAccent(tabName);
        rangeHighlight.style.setProperty("--range-color", accent.color);
        rangeHighlight.style.setProperty("--range-glow", accent.glow);
      },
    });

    document.querySelectorAll(".range-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const range = btn.getAttribute("data-range");
        if (!range) return;

        document.querySelectorAll(".range-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        rangeHighlightCtrl.sync(btn as HTMLElement);

        activeRange = range;
        if (range === "custom") {
          customDateContainer.classList.remove("hidden");
        } else {
          customDateContainer.classList.add("hidden");
          updateLeaderboard();
        }
      });
    });

    startDateInput.addEventListener("change", () => {
      if (activeRange === "custom") updateLeaderboard();
    });
    endDateInput.addEventListener("change", () => {
      if (activeRange === "custom") updateLeaderboard();
    });

    document.querySelectorAll(".sub-tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const tab = btn.getAttribute("data-tab");
        if (!tab) return;

        document.querySelectorAll(".sub-tab-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        subTabHighlightCtrl.sync(btn as HTMLElement);

        activeTab = tab;
        updateLeaderboard();
      });
    });

    let searchDebounce: ReturnType<typeof setTimeout>;
    searchInput.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(updateLeaderboard, 250);
    });

    bindEntityClicks(listContainer);
    updateLeaderboard();

    onPathsUpdated(["/data/yearly-totals.json", /^\/data\/year-\d+\.json$/], () => {
      void loadMeta().then(() => updateLeaderboard());
    });

    rangeHighlightCtrl.observe();
    subTabHighlightCtrl.observe();

    const initialRange = document.querySelector(".range-btn.active") as HTMLElement;
    if (initialRange) rangeHighlightCtrl.sync(initialRange);

    const initialTab = document.querySelector(".sub-tab-btn.active") as HTMLElement;
    if (initialTab) subTabHighlightCtrl.sync(initialTab);
  });
</script>
