---
interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "One person's questionable music taste, meticulously tracked, charted, and ranked so you don't have to ask.",
} = Astro.props;

const ogImageUrl = new URL("/og-image.png", Astro.url).href;
const pageUrl = Astro.url.href;
---

<!doctype html>
<html lang="en" style="background-color: #000000;">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta
			name="apple-mobile-web-app-status-bar-style"
			content="black-translucent"
		/>
		<meta name="apple-mobile-web-app-title" content="My Music Stats" />
		<meta name="theme-color" content="#000000" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Open Graph / Facebook, iMessage, Slack, Discord, etc. -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="My Music Stats app icon" />

		<!-- Twitter / X Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<style is:inline>
			/* Critical inline styles for Splash Screen to prevent FOUC (jumpiness) */
			#pwa-splash-screen {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background-color: #000000;
				z-index: 9999;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s;
			}
			#pwa-splash-screen.hidden {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
			}
			.splash-logo {
				opacity: 0;
				will-change: opacity, transform;
				animation: splash-logo-fade-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
			}
			@keyframes splash-logo-fade-in {
				from { opacity: 0; transform: scale(0.9) translateY(15px); }
				to { opacity: 1; transform: scale(1) translateY(0); }
			}
			.splash-icon-shell {
				position: relative;
				width: 108px;
				height: 108px;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.splash-icon-bg {
				position: absolute;
				inset: 0;
				border-radius: 27px;
				background: radial-gradient(circle at 50% 36%, #241c3a 0%, #110e18 50%, #07050d 100%);
				box-shadow:
					inset 0 1px 0 rgba(255, 255, 255, 0.06),
					0 0 48px rgba(168, 85, 247, 0.12);
			}
			.splash-glyph {
				position: relative;
				width: 62px;
				height: 62px;
				display: block;
				animation: glyph-glow 2s infinite ease-in-out;
			}
			@keyframes glyph-glow {
				0%, 100% {
					filter: drop-shadow(0 0 10px rgba(255, 45, 85, 0.55)) drop-shadow(0 0 22px rgba(168, 85, 247, 0.35));
					transform: scale(1);
				}
				50% {
					filter: drop-shadow(0 0 18px rgba(168, 85, 247, 0.65)) drop-shadow(0 0 32px rgba(0, 240, 255, 0.28));
					transform: scale(1.06);
				}
			}

			#data-update-toast {
				position: fixed;
				top: calc(env(safe-area-inset-top) + 12px);
				left: 50%;
				transform: translate3d(-50%, -120%, 0);
				z-index: 10000;
				padding: 10px 18px;
				border-radius: 999px;
				background: rgba(18, 18, 24, 0.92);
				border: 1px solid rgba(255, 255, 255, 0.12);
				box-shadow: 0 8px 28px rgba(0, 0, 0, 0.45);
				color: #fff;
				font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				font-size: 13px;
				font-weight: 600;
				letter-spacing: 0.01em;
				pointer-events: none;
				opacity: 0;
				transition:
					transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
					opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
			}

			#data-update-toast.visible {
				opacity: 1;
				transform: translate3d(-50%, 0, 0);
			}

			#pwa-install-banner {
				position: fixed;
				top: calc(env(safe-area-inset-top) + 12px);
				right: calc(env(safe-area-inset-right) + 12px);
				left: auto;
				z-index: 9998;
				max-width: min(360px, calc(100vw - 24px));
				padding: 14px 16px;
				border-radius: 16px;
				background: rgba(14, 14, 20, 0.94);
				border: 1px solid rgba(255, 255, 255, 0.1);
				box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
			}

			#pwa-install-banner.hidden {
				display: none;
			}

			.pwa-install-title {
				font-size: 14px;
				font-weight: 700;
				color: #fff;
				margin-bottom: 4px;
			}

			.pwa-install-hint {
				font-size: 12px;
				line-height: 1.45;
				color: rgba(255, 255, 255, 0.72);
				margin-bottom: 12px;
			}

			.pwa-install-actions {
				display: flex;
				gap: 8px;
				justify-content: flex-end;
			}

			.pwa-install-actions button {
				border: none;
				border-radius: 999px;
				padding: 8px 14px;
				font-size: 12px;
				font-weight: 600;
				cursor: pointer;
				font-family: inherit;
			}

			#pwa-install-dismiss {
				background: rgba(255, 255, 255, 0.06);
				color: rgba(255, 255, 255, 0.75);
			}

			#pwa-install-btn {
				background: linear-gradient(135deg, #ff2d55, #a855f7);
				color: #fff;
				box-shadow: 0 4px 14px rgba(168, 85, 247, 0.35);
			}
		</style>
	</head>
	<body style="background-color: #000000; margin: 0; padding: 0;">
		<!-- Inline dismiss: must not depend on JS bundles (offline reload may block module load) -->
		<script is:inline>
			(function () {
				function hideSplash() {
					var el = document.getElementById("pwa-splash-screen");
					if (el) el.classList.add("hidden");
				}
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", hideSplash, { once: true });
				} else {
					hideSplash();
				}
				setTimeout(hideSplash, 700);
			})();
		</script>

		<!-- PWA Loading Splash Screen Overlay -->
		<div id="pwa-splash-screen">
			<div class="splash-logo">
				<div class="splash-icon-shell">
					<div class="splash-icon-bg" aria-hidden="true"></div>
					<img
						class="splash-glyph"
						src="/logo-mark.svg"
						width="62"
						height="62"
						alt=""
					/>
				</div>
			</div>
		</div>

		<div id="data-update-toast" role="status" aria-live="polite"></div>

		<div id="pwa-install-banner" class="hidden" role="dialog" aria-labelledby="pwa-install-title">
			<div class="pwa-install-title" id="pwa-install-title">Install My Music Stats</div>
			<p class="pwa-install-hint">Install for offline access and faster launch.</p>
			<div class="pwa-install-actions">
				<button type="button" id="pwa-install-dismiss">Not now</button>
				<button type="button" id="pwa-install-btn">Install app</button>
			</div>
		</div>

		<slot />

		<script>
			import { initDataRefreshUI, initServiceWorker } from "../utils/dataRefresh";
			import { initPwaInstall } from "../utils/pwaInstall";

			initDataRefreshUI();
			initServiceWorker();
			initPwaInstall();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg-dark: #000000;
		--panel-bg: rgba(255, 255, 255, 0.03);
		--panel-border: rgba(255, 255, 255, 0.06);
		--panel-border-hover: rgba(255, 255, 255, 0.12);
		--text-primary: #ffffff;
		--text-secondary: rgba(255, 255, 255, 0.8);
		--text-muted: rgba(255, 255, 255, 0.6);
		--accent-pink: #ff2d55;
		--accent-pink-glow: rgba(255, 45, 85, 0.4);
		--accent-cyan: #00f0ff;
		--accent-cyan-glow: rgba(0, 240, 255, 0.4);
		--accent-violet: #8b5cf6;
		--accent-violet-glow: rgba(139, 92, 246, 0.4);
		--accent-green: #22c55e;
		--accent-green-glow: rgba(34, 197, 94, 0.4);
		--accent-yellow: #eab308;
		--accent-yellow-glow: rgba(234, 179, 8, 0.4);
		--accent-orange: #f97316;
		--accent-orange-glow: rgba(249, 115, 22, 0.4);
		--accent-red: #ef4444;
		--accent-red-glow: rgba(239, 68, 68, 0.4);
		
		--accent-cat-artists: #f97316;
		--accent-cat-artists-glow: rgba(249, 115, 22, 0.4);
		--accent-cat-albums: #10b981;
		--accent-cat-albums-glow: rgba(16, 185, 129, 0.4);
		--accent-cat-songs: #d946ef;
		--accent-cat-songs-glow: rgba(217, 70, 239, 0.4);

		--font-header:
			"Outfit", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
			sans-serif;
		--font-body:
			"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
			sans-serif;

		--ios-spring: cubic-bezier(0.16, 1, 0.3, 1);
		--transition-smooth: all 0.5s var(--ios-spring);

		--surface-elevated: #0a0a0f;
		--radius-sm: 6px;
		--radius-md: 12px;
		--radius-lg: 16px;
		--z-nav: 100;
		/* Mobile bottom nav — safe-area anchored (Safari + PWA consistent) */
		--nav-bar-height: 64px;
		--nav-bar-gap: 20px;
		--nav-zone-height: calc(
			var(--nav-bar-height) + var(--nav-bar-gap) + env(safe-area-inset-bottom) + 8px
		);
		--z-dropdown: 150;
		--z-overlay-backdrop: 199;
		--z-overlay-panel: 200;
		--spacing-section: 16px;
		--spacing-section-lg: 24px;
		--duration-fast: 0.16s;
		--duration-normal: 0.28s;
		--duration-slow: 0.55s;
		--duration-overlay: 0.28s;
	}

	.panel-container {
		width: 100%;
		padding: var(--spacing-section);
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin-bottom: var(--spacing-section-lg);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		/* Prevent iOS Safari text autosizing from inflating fonts on rotation */
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}

	html,
	body {
		width: 100%;
		height: 100%;
		/* 
		@media all and (display-mode: standalone) {
			height: 10lvh;
		} */

		background-color: var(--bg-dark);
		color: var(--text-primary);
		font-family: var(--font-body);
		overflow: hidden;
		overscroll-behavior: none;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	/* Scrollbar Styling */
	::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.08);
		border-radius: 3px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: rgba(255, 255, 255, 0.15);
	}

	/* Subtle glass card — provides layer separation */
	.glass-card {
		background: var(--panel-bg);
		border: 1px solid var(--panel-border);
		border-radius: 16px;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition: var(--transition-smooth);
	}

	.glass-input {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #fff;
		border-radius: 12px;
		padding: 10px 16px;
		font-family: var(--font-body);
		font-size: 14px;
		outline: none;
		transition: var(--transition-smooth);
	}

	.glass-input:focus {
		background: rgba(255, 255, 255, 0.08);
		border-color: var(--accent-pink);
		box-shadow: 0 0 10px var(--accent-pink-glow);
	}

	/* Micro-animations */
	.hover-scale {
		transition: var(--transition-smooth);
	}
	.hover-scale:hover {
		transform: translateY(-2px) scale(1.02);
	}

	/* Instant tactile feedback for clickable elements (except rows that open the overlay) */
	.hover-scale:active,
	button:active,
	.tab-btn:active,
	.range-btn:active,
	.sub-tab-btn:active,
	.nav-circle-btn:active,
	.album-card-thumb:active {
		transform: scale(0.96) !important;
		transition-duration: 0.05s !important;
	}

	.scrobble-row.clickable-entity:active,
	.carousel-item.clickable-entity:active {
		transform: none !important;
		opacity: 0.72;
		transition: opacity 0.15s var(--ios-spring) !important;
	}

	body.overlay-open .scrobble-row.clickable-entity:active,
	body.overlay-open .carousel-item.clickable-entity:active {
		opacity: 1 !important;
	}

	/* Unified View Headers */
	.view-header {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.view-header h2 {
		font-family: var(--font-header);
		font-size: 26px;
		font-weight: 700;
		letter-spacing: -0.02em;
		background: linear-gradient(
			135deg,
			#fff 30%,
			var(--text-secondary) 100%
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.view-header .subtitle {
		font-size: 14px;
		color: var(--text-secondary);
		margin-top: 2px;
	}

	/* Unified Empty States */
	.no-data-message {
		text-align: center;
		color: var(--text-secondary);
		font-size: 14px;
		padding: 40px 20px;
		background: rgba(255, 255, 255, 0.02);
		border: 1px dashed rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		margin: 20px 0;
		font-style: italic;
	}

	/* Shared scrobble row — used site-wide */
	.scrobble-row {
		display: flex;
		align-items: center;
		padding: 12px 16px;
		gap: 16px;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 12px;
		margin-bottom: 8px;
		transition: var(--transition-smooth);
		cursor: pointer;
		width: 100%;
		user-select: none;
	}

	.scrobble-row:last-child {
		margin-bottom: 0;
	}

	.scrobble-row:hover {
		background: rgba(255, 255, 255, 0.05);
		border-color: rgba(255, 255, 255, 0.08);
		transform: translateY(-2px);
	}

	.scrobble-row a,
	.scrobble-row a:hover,
	.scrobble-row-title,
	.scrobble-row-subtitle {
		text-decoration: none !important;
	}

	.scrobble-row-rank {
		width: 28px;
		text-align: center;
		color: var(--text-muted);
		font-family: var(--font-header);
		font-size: 16px;
		font-weight: 700;
		flex-shrink: 0;
		font-variant-numeric: tabular-nums;
	}

	.scrobble-row-rank.rank-1 {
		color: #ffd700;
		text-shadow: 0 0 12px rgba(255, 215, 0, 0.5);
		font-size: 18px;
	}

	.scrobble-row-rank.rank-2 {
		color: #c0c0c0;
		text-shadow: 0 0 10px rgba(192, 192, 192, 0.4);
		font-size: 17px;
	}

	.scrobble-row-rank.rank-3 {
		color: #cd7f32;
		text-shadow: 0 0 10px rgba(205, 127, 50, 0.4);
		font-size: 17px;
	}

	.scrobble-row-thumb {
		width: 44px;
		height: 44px;
		border-radius: 6px;
		flex-shrink: 0;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.04);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		border: 1px solid rgba(255, 255, 255, 0.05);
		position: relative;
	}

	.scrobble-row-thumb .artwork-shimmer,
	.overlay-artwork-wrapper .artwork-shimmer,
	.overlay-album-card-artwork .artwork-shimmer,
	.carousel-artwork-wrapper .artwork-shimmer {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(
			100deg,
			rgba(255, 255, 255, 0.02) 0%,
			rgba(255, 255, 255, 0.1) 50%,
			rgba(255, 255, 255, 0.02) 100%
		);
		background-size: 200% 200%;
		animation: artwork-shimmer 1.4s ease-in-out infinite;
		z-index: 1;
		pointer-events: none;
		opacity: 1;
		transition: opacity 0.28s ease;
	}

	/* Cross-fades out as the loaded image fades in above it, instead of
	   disappearing in a single frame. */
	.scrobble-row-thumb .artwork-shimmer.artwork-shimmer-hide,
	.overlay-artwork-wrapper .artwork-shimmer.artwork-shimmer-hide,
	.overlay-album-card-artwork .artwork-shimmer.artwork-shimmer-hide,
	.carousel-artwork-wrapper .artwork-shimmer.artwork-shimmer-hide {
		opacity: 0;
	}

	@keyframes artwork-shimmer {
		0%, 100% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
	}

	.scrobble-row-thumb .artwork-fallback,
	.overlay-album-card-artwork .artwork-fallback,
	.carousel-artwork-wrapper .artwork-fallback,
	.overlay-artwork-fallback.artwork-fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background: linear-gradient(160deg, rgba(18, 18, 22, 0.95) 0%, rgba(10, 10, 14, 1) 100%);
	}

	.scrobble-row-thumb .artwork-fallback svg,
	.overlay-album-card-artwork .artwork-fallback svg,
	.carousel-artwork-wrapper .artwork-fallback svg {
		width: 20px;
		height: 20px;
		color: rgba(255, 255, 255, 0.28);
	}

	.scrobble-row-thumb .artwork-img,
	.overlay-album-card-artwork .artwork-img,
	.carousel-artwork-wrapper .artwork-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		position: relative;
		z-index: 2;
		transition: opacity 0.3s var(--ios-spring);
	}

	.scrobble-row-thumb.artwork-loaded .artwork-img,
	.overlay-album-card-artwork.artwork-loaded .artwork-img,
	.carousel-artwork-wrapper.artwork-loaded .artwork-img {
		opacity: 1;
	}

	.scrobble-row-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.scrobble-row-thumb svg {
		width: 20px;
		height: 20px;
	}

	.scrobble-row-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 3px;
		overflow: hidden;
		min-width: 0;
	}

	.scrobble-row-title {
		font-size: 16px;
		font-weight: 600;
		color: #fff;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.scrobble-row-subtitle {
		font-size: 14px;
		color: var(--text-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.scrobble-row-right {
		font-size: 14px;
		color: var(--text-muted);
		font-weight: 500;
		flex-shrink: 0;
		text-align: right;
		padding-left: 8px;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.scrobble-row-compact .scrobble-row-title {
		font-size: 14px;
	}

	.scrobble-row-compact .scrobble-row-subtitle {
		font-size: 12px;
	}

	.scrobble-row-compact .scrobble-row-right {
		font-size: 11px;
	}

	.scrobble-row-compact .scrobble-row-thumb {
		border-radius: var(--radius-sm);
	}

	.sliding-highlight {
		position: absolute;
		left: 0;
		top: 0;
		pointer-events: none;
		z-index: 1;
		transition:
