{
  "name": "music-stats",
  "type": "module",
  "version": "1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/generate-pwa-icons.js && node scripts/generate-sw.js && node scripts/generate-manifest.js && astro dev",
    "build": "node scripts/build.js",
    "build:refresh": "node scripts/build.js --refresh",
    "artwork:coverage": "node scripts/report-artwork-coverage.js",
    "deploy": "npm run build && npx wrangler pages deploy dist/ --project-name music-stats",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@material/material-color-utilities": "^0.4.0",
    "astro": "^7.0.6",
    "chart.js": "^4.5.1",
    "fast-average-color-node": "^3.2.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1"
  }
}
